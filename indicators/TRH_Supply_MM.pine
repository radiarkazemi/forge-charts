// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | Liquidity Under Construction (Naeem / fractal model)
//
// نقدینگی در حال ساخت — trade liquidity being built; later it becomes the
// pool that sweeps everyone into the correct zone.
// Same pattern nested across fractals (کون‌پشته‌کون).
//
// Bias: 4H + Daily  (or Daily + Monthly)
// Stacks:
//   1 — 15 — 4H — W
//   5 — 1H — D  — MN
//
// A: MSS → New Fresh Zone → LQ build → sweep into zone → E proximal / S distal
// B: MSS → BB + FVG → LQ build → sweep into zone
// C: Major expansion in bias → internal fs sweep → continuation

//@version=6
indicator("TRH | LQ Fractal (Liquidity Under Construction)", shorttitle="TRH-LQ",
     overlay=true, max_boxes_count=60, max_lines_count=160, max_labels_count=100,
     max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpStack = "Fractal Stack"
stack = input.string("1 — 15 — 4H — W", "Active Stack",
     options=["1 — 15 — 4H — W", "5 — 1H — D — MN"], group=grpStack,
     tooltip="Attach on ENTRY TF (1m for fast stack, 5m for slow).\nBias from 4H+D or D+MN.")
requireBiasAlign = input.bool(true, "Only Trade With Bias", group=grpStack)
biasMode = input.string("Candle + EMA", "Bias Method",
     options=["Candle + EMA", "Close vs Prior", "EMA only"], group=grpStack)

grpModel = "Model"
pivotLen       = input.int(3, "Pivot Length", minval=2, maxval=10, group=grpModel)
mssBodyAtr     = input.float(0.35, "Min MSS Body (ATR×)", step=0.05, group=grpModel)
minZonePts     = input.float(1.50, "Min Zone Height (price)", step=0.1, group=grpModel)
maxZoneAtr     = input.float(2.20, "Max Zone Height (ATR×)", step=0.1, group=grpModel)
lqTolAtr       = input.float(0.12, "Equal Hi/Lo Tol (ATR×)", step=0.01, group=grpModel)
minLqTouches   = input.int(2, "Min Touches For LQ", minval=2, maxval=6, group=grpModel)
requireLqSweep = input.bool(true, "Require LQ Sweep Into Zone", group=grpModel)
fsPadAtr       = input.float(0.05, "fs Beyond Swing (ATR×)", step=0.01, group=grpModel)
fsMaxAtr       = input.float(0.55, "Max fs Depth (ATR×)", step=0.05, group=grpModel)
cooldownBars   = input.int(20, "Cooldown Bars", minval=1, group=grpModel)
slPadPts       = input.float(0.15, "SL Pad (price)", step=0.05, group=grpModel)
rrTarget       = input.float(3.0, "Fallback RR", minval=1.0, step=0.5, group=grpModel)
useErlTp       = input.bool(true, "TP Prefer Yesterday High/Low", group=grpModel)

grpPath = "Paths"
useFreshZone = input.bool(true, "A — Fresh Zone after MSS", group=grpPath)
useBbFvg     = input.bool(true, "B — BB + FVG", group=grpPath)
useFsCont    = input.bool(true, "C — Internal fs Continuation", group=grpPath)

grpDisp = "Display"
showZones  = input.bool(true, "Show Zones", group=grpDisp)
showLq     = input.bool(true, "Show LQ", group=grpDisp)
showLabels = input.bool(true, "Labels", group=grpDisp)
showPanel  = input.bool(true, "Panel", group=grpDisp)
extendBars = input.int(40, "Extend (bars)", minval=5, group=grpDisp)
supplyCol  = input.color(color.new(#EF5350, 78), "Supply", group=grpDisp)
demandCol  = input.color(color.new(#26A69A, 78), "Demand", group=grpDisp)
lqCol      = input.color(#FFB74D, "LQ", group=grpDisp)
entryCol   = input.color(#66BB6A, "Entry", group=grpDisp)
slCol      = input.color(#EF5350, "Stop", group=grpDisp)
mssCol     = input.color(#CE93D8, "MSS", group=grpDisp)

// ═══════════════════════════════════════════════════════════════════════════
// STACK + BIAS
// ═══════════════════════════════════════════════════════════════════════════

isFast  = stack == "1 — 15 — 4H — W"
biasTf  = isFast ? "240" : "D"
macroTf = isFast ? "W" : "M"

atr = ta.atr(14)

f_tf_bias(string tf) =>
    float c  = request.security(syminfo.tickerid, tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float o  = request.security(syminfo.tickerid, tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float c1 = request.security(syminfo.tickerid, tf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float ema = request.security(syminfo.tickerid, tf, ta.ema(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    int b = 0
    if biasMode == "Candle + EMA"
        b := (c > o and c > ema) ? 1 : (c < o and c < ema) ? -1 : (c >= c1 ? 1 : -1)
    else if biasMode == "Close vs Prior"
        b := c >= c1 ? 1 : -1
    else
        b := c >= ema ? 1 : -1
    b

biasDir = f_tf_bias(biasTf)
macroBias = f_tf_bias(macroTf)
// Prefer agreement; else lean on biasTf
biasDir := biasDir == macroBias ? biasDir : biasDir
biasOkLong  = not requireBiasAlign or biasDir == 1
biasOkShort = not requireBiasAlign or biasDir == -1

dayHi = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dayLo = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// PIVOTS
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float[] swingHi = array.new_float()
var int[]   swingHiBar = array.new_int()
var float[] swingLo = array.new_float()
var int[]   swingLoBar = array.new_int()

if not na(ph)
    array.push(swingHi, ph)
    array.push(swingHiBar, bar_index - pivotLen)
    if array.size(swingHi) > 30
        array.shift(swingHi)
        array.shift(swingHiBar)

if not na(pl)
    array.push(swingLo, pl)
    array.push(swingLoBar, bar_index - pivotLen)
    if array.size(swingLo) > 30
        array.shift(swingLo)
        array.shift(swingLoBar)

lastHi  = array.size(swingHi) > 0 ? array.get(swingHi, array.size(swingHi) - 1) : float(na)
lastLo  = array.size(swingLo) > 0 ? array.get(swingLo, array.size(swingLo) - 1) : float(na)
lastHiB = array.size(swingHiBar) > 0 ? array.get(swingHiBar, array.size(swingHiBar) - 1) : int(na)
lastLoB = array.size(swingLoBar) > 0 ? array.get(swingLoBar, array.size(swingLoBar) - 1) : int(na)
prevHi  = array.size(swingHi) > 1 ? array.get(swingHi, array.size(swingHi) - 2) : float(na)
prevLo  = array.size(swingLo) > 1 ? array.get(swingLo, array.size(swingLo) - 2) : float(na)

f_eq_hi(float level, float tol) =>
    int n = 0
    int sz = array.size(swingHi)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(swingHi, i) - level) <= tol ? 1 : 0
    n

f_eq_lo(float level, float tol) =>
    int n = 0
    int sz = array.size(swingLo)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(swingLo, i) - level) <= tol ? 1 : 0
    n

f_ob(int dir, int look) =>
    float prox = na
    float dist = na
    int ok = 0
    for k = 1 to look
        if ok == 0
            bool opp = dir == -1 ? close[k] > open[k] : close[k] < open[k]
            if opp
                prox := dir == -1 ? low[k] : high[k]
                dist := dir == -1 ? high[k] : low[k]
                ok := 1
    [prox, dist, ok]

f_zone_ok(float prox, float dist) =>
    float h = math.abs(dist - prox)
    h >= minZonePts and h <= atr * maxZoneAtr and h > syminfo.mintick

f_tp(int dir, float entry, float sl) =>
    float risk = math.abs(entry - sl)
    float tp = dir == 1 ? entry + risk * rrTarget : entry - risk * rrTarget
    if useErlTp
        if dir == 1 and not na(dayHi)
            tp := math.max(tp, dayHi)
        if dir == -1 and not na(dayLo)
            tp := math.min(tp, dayLo)
    tp

// ═══════════════════════════════════════════════════════════════════════════
// STATE (all mutations in global scope — Pine rule)
// ═══════════════════════════════════════════════════════════════════════════

var int lastSignalBar = na
var int zDir = 0
var float zProx = na
var float zDist = na
var int zBirth = na
var int zLeft = 0
var int zArmed = 0
var int zKind = 0
var float zLq = na
var int zMssBar = na
var box zBox = na
var line zE = na
var line zS = na
var label zTag = na
var line zLqLine = na
var label zLqLab = na
var line zTpLine = na

var float sigEntry = na
var float sigSl = na
var float sigTp = na
var int sigDir = 0
var string sigPath = ""

body = math.abs(close - open)
canSig = na(lastSignalBar) or (bar_index - lastSignalBar) >= cooldownBars

bearFvg = bar_index >= 2 and low[2] > high and (low[2] - high) >= math.max(atr * 0.15, minZonePts * 0.5)
bullFvg = bar_index >= 2 and high[2] < low and (low - high[2]) >= math.max(atr * 0.15, minZonePts * 0.5)

// ── MSS ────────────────────────────────────────────────────────────────────
mssShort = biasOkShort and useFreshZone and not na(lastLo) and not na(lastHi) and not na(lastHiB) and not na(lastLoB) and lastHiB > lastLoB and close < lastLo and body >= atr * mssBodyAtr and close < open
mssLong  = biasOkLong  and useFreshZone and not na(lastHi) and not na(lastLo) and not na(lastHiB) and not na(lastLoB) and lastLoB > lastHiB and close > lastHi and body >= atr * mssBodyAtr and close > open

bornFresh = false
bornBb = false

if mssShort and canSig
    [p, d, ok] = f_ob(-1, 8)
    if ok == 1 and f_zone_ok(p, d)
        box.delete(zBox)
        line.delete(zE)
        line.delete(zS)
        label.delete(zTag)
        line.delete(zLqLine)
        label.delete(zLqLab)
        zBox := showZones ? box.new(bar_index, math.max(p, d), bar_index + 1, math.min(p, d), border_color=color.new(supplyCol, 20), bgcolor=supplyCol) : na
        zE := line.new(bar_index, p, bar_index + extendBars, p, color=entryCol, style=line.style_dashed, width=2)
        zS := line.new(bar_index, d, bar_index + extendBars, d, color=slCol, style=line.style_dashed, width=2)
        zTag := showLabels ? label.new(bar_index + 2, (p + d) * 0.5, "Fresh Zone", style=label.style_label_left, color=color.new(supplyCol, 100), textcolor=supplyCol, size=size.small) : na
        zDir := -1
        zProx := p
        zDist := d
        zBirth := bar_index
        zLeft := 0
        zArmed := 0
        zKind := 1
        zLq := na
        zMssBar := bar_index
        bornFresh := true
        if showLabels
            label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(mssCol, 40), textcolor=color.white, size=size.tiny)

if mssLong and canSig and not bornFresh
    [p, d, ok] = f_ob(1, 8)
    if ok == 1 and f_zone_ok(p, d)
        box.delete(zBox)
        line.delete(zE)
        line.delete(zS)
        label.delete(zTag)
        line.delete(zLqLine)
        label.delete(zLqLab)
        zBox := showZones ? box.new(bar_index, math.max(p, d), bar_index + 1, math.min(p, d), border_color=color.new(demandCol, 20), bgcolor=demandCol) : na
        zE := line.new(bar_index, p, bar_index + extendBars, p, color=entryCol, style=line.style_dashed, width=2)
        zS := line.new(bar_index, d, bar_index + extendBars, d, color=slCol, style=line.style_dashed, width=2)
        zTag := showLabels ? label.new(bar_index + 2, (p + d) * 0.5, "Fresh Zone", style=label.style_label_left, color=color.new(demandCol, 100), textcolor=demandCol, size=size.small) : na
        zDir := 1
        zProx := p
        zDist := d
        zBirth := bar_index
        zLeft := 0
        zArmed := 0
        zKind := 1
        zLq := na
        zMssBar := bar_index
        bornFresh := true
        if showLabels
            label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(mssCol, 40), textcolor=color.white, size=size.tiny)

// ── BB + FVG ───────────────────────────────────────────────────────────────
if useBbFvg and biasOkLong and bullFvg and close > open and body >= atr * mssBodyAtr * 0.8 and canSig and not bornFresh
    if not na(lastHi) and close > lastHi
        float prox = low
        float dist = high[2]
        if f_zone_ok(prox, dist)
            box.delete(zBox)
            line.delete(zE)
            line.delete(zS)
            label.delete(zTag)
            line.delete(zLqLine)
            label.delete(zLqLab)
            zBox := showZones ? box.new(bar_index, math.max(prox, dist), bar_index + 1, math.min(prox, dist), border_color=color.new(demandCol, 20), bgcolor=demandCol) : na
            zE := line.new(bar_index, prox, bar_index + extendBars, prox, color=entryCol, style=line.style_dashed, width=2)
            zS := line.new(bar_index, dist, bar_index + extendBars, dist, color=slCol, style=line.style_dashed, width=2)
            zTag := showLabels ? label.new(bar_index + 2, (prox + dist) * 0.5, "BB + FVG", style=label.style_label_left, color=color.new(demandCol, 100), textcolor=demandCol, size=size.small) : na
            zDir := 1
            zProx := prox
            zDist := dist
            zBirth := bar_index
            zLeft := 0
            zArmed := 0
            zKind := 2
            zLq := na
            zMssBar := bar_index
            bornBb := true

if useBbFvg and biasOkShort and bearFvg and close < open and body >= atr * mssBodyAtr * 0.8 and canSig and not bornFresh and not bornBb
    if not na(lastLo) and close < lastLo
        float prox = high
        float dist = low[2]
        if f_zone_ok(prox, dist)
            box.delete(zBox)
            line.delete(zE)
            line.delete(zS)
            label.delete(zTag)
            line.delete(zLqLine)
            label.delete(zLqLab)
            zBox := showZones ? box.new(bar_index, math.max(prox, dist), bar_index + 1, math.min(prox, dist), border_color=color.new(supplyCol, 20), bgcolor=supplyCol) : na
            zE := line.new(bar_index, prox, bar_index + extendBars, prox, color=entryCol, style=line.style_dashed, width=2)
            zS := line.new(bar_index, dist, bar_index + extendBars, dist, color=slCol, style=line.style_dashed, width=2)
            zTag := showLabels ? label.new(bar_index + 2, (prox + dist) * 0.5, "BB + FVG", style=label.style_label_left, color=color.new(supplyCol, 100), textcolor=supplyCol, size=size.small) : na
            zDir := -1
            zProx := prox
            zDist := dist
            zBirth := bar_index
            zLeft := 0
            zArmed := 0
            zKind := 2
            zLq := na
            zMssBar := bar_index

// ── Manage active zone: leave → build LQ → sweep → fire ────────────────────
firedNow = false

if zDir != 0 and not na(zProx) and not na(zDist)
    float loZ = math.min(zProx, zDist)
    float hiZ = math.max(zProx, zDist)
    float tol = atr * lqTolAtr

    if showZones and not na(zBox)
        box.set_right(zBox, bar_index + 1)
    if not na(zE)
        line.set_x2(zE, bar_index + extendBars)
    if not na(zS)
        line.set_x2(zS, bar_index + extendBars)

    if zLeft == 0
        if (zDir == -1 and close < loZ) or (zDir == 1 and close > hiZ)
            zLeft := 1

    // LQ under construction while price is away from the zone
    if zLeft == 1 and zArmed == 0
        if zDir == -1 and not na(lastHi) and lastHi < loZ and f_eq_hi(lastHi, tol) >= minLqTouches
            zLq := lastHi
            if showLq
                line.delete(zLqLine)
                label.delete(zLqLab)
                zLqLine := line.new(math.max(zBirth, bar_index - 20), zLq, bar_index + extendBars, zLq, color=color.new(lqCol, 30), style=line.style_dotted, width=1)
                zLqLab := label.new(bar_index, zLq, "LQ", style=label.style_label_left, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)
        if zDir == 1 and not na(lastLo) and lastLo > hiZ and f_eq_lo(lastLo, tol) >= minLqTouches
            zLq := lastLo
            if showLq
                line.delete(zLqLine)
                label.delete(zLqLab)
                zLqLine := line.new(math.max(zBirth, bar_index - 20), zLq, bar_index + extendBars, zLq, color=color.new(lqCol, 30), style=line.style_dotted, width=1)
                zLqLab := label.new(bar_index, zLq, "LQ", style=label.style_label_left, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)

    if zLeft == 1 and zArmed == 0 and canSig
        bool atProx = zDir == -1 ? high >= zProx : low <= zProx
        bool inZone = high >= loZ and low <= hiZ
        bool swept = true
        if requireLqSweep
            if not na(zLq)
                swept := zDir == -1 ? high >= zLq : low <= zLq
            else
                swept := not na(zMssBar) and (bar_index - zMssBar) >= pivotLen * 4

        if atProx and inZone and swept
            zArmed := 1
            float entry = zProx
            float sl = zDir == -1 ? zDist + slPadPts : zDist - slPadPts
            float tp = f_tp(zDir, entry, sl)
            string path = (zKind == 2 ? "B·BB+FVG" : "A·Fresh") + (zDir == 1 ? " LONG" : " SHORT")
            sigDir := zDir
            sigEntry := entry
            sigSl := sl
            sigTp := tp
            sigPath := path
            lastSignalBar := bar_index
            firedNow := true
            line.delete(zTpLine)
            zTpLine := line.new(bar_index, tp, bar_index + extendBars, tp, color=color.new(#26A69A, 35), style=line.style_dotted, width=1)
            if showLabels
                label.new(bar_index, entry, path, style=zDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(zDir == 1 ? demandCol : supplyCol, 25), textcolor=color.white, size=size.small)

    if (zDir == -1 and close > zDist) or (zDir == 1 and close < zDist)
        box.delete(zBox)
        line.delete(zE)
        line.delete(zS)
        label.delete(zTag)
        line.delete(zLqLine)
        label.delete(zLqLab)
        zDir := 0
        zProx := na
        zDist := na
        zArmed := 0
        zLeft := 0

// ── Path C: fs continuation ────────────────────────────────────────────────
if useFsCont and canSig and not firedNow
    // Long: sweep prior swing low then reclaim
    if biasOkLong and not na(lastLo)
        float depth = lastLo - low
        bool sweptFs = low < lastLo - atr * fsPadAtr and depth > 0 and depth <= atr * fsMaxAtr
        bool reclaim = close > lastLo and close > open
        if sweptFs and reclaim
            float entry = close
            float sl = low - slPadPts
            if math.abs(entry - sl) >= minZonePts * 0.5
                float tp = f_tp(1, entry, sl)
                sigDir := 1
                sigEntry := entry
                sigSl := sl
                sigTp := tp
                sigPath := "C·fs LONG"
                lastSignalBar := bar_index
                firedNow := true
                if showLabels
                    line.new(bar_index - 8, lastLo, bar_index + extendBars, lastLo, color=color.new(lqCol, 40), style=line.style_dotted)
                    label.new(bar_index, lastLo, "fs", style=label.style_label_right, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)
                    label.new(bar_index, entry, "C·fs LONG", style=label.style_label_up, color=color.new(demandCol, 25), textcolor=color.white, size=size.small)

    if biasOkShort and not na(lastHi) and not firedNow
        float depth = high - lastHi
        bool sweptFs = high > lastHi + atr * fsPadAtr and depth > 0 and depth <= atr * fsMaxAtr
        bool reject = close < lastHi and close < open
        if sweptFs and reject
            float entry = close
            float sl = high + slPadPts
            if math.abs(entry - sl) >= minZonePts * 0.5
                float tp = f_tp(-1, entry, sl)
                sigDir := -1
                sigEntry := entry
                sigSl := sl
                sigTp := tp
                sigPath := "C·fs SHORT"
                lastSignalBar := bar_index
                firedNow := true
                if showLabels
                    line.new(bar_index - 8, lastHi, bar_index + extendBars, lastHi, color=color.new(lqCol, 40), style=line.style_dotted)
                    label.new(bar_index, lastHi, "fs", style=label.style_label_right, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)
                    label.new(bar_index, entry, "C·fs SHORT", style=label.style_label_down, color=color.new(supplyCol, 25), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS / PLOTS / PANEL
// ═══════════════════════════════════════════════════════════════════════════

alertcondition(firedNow and sigDir == -1, "LQ Short", "TRH-LQ SHORT — نقدینگی جمع شد into zone")
alertcondition(firedNow and sigDir == 1, "LQ Long", "TRH-LQ LONG — نقدینگی جمع شد into zone")
alertcondition(mssShort, "MSS Short", "TRH-LQ MSS↓ fresh supply")
alertcondition(mssLong, "MSS Long", "TRH-LQ MSS↑ fresh demand")

plot(firedNow ? sigEntry : na, "E", color=entryCol, style=plot.style_circles, linewidth=3)
plot(firedNow ? sigSl : na, "S", color=slCol, style=plot.style_circles, linewidth=2)
plot(firedNow ? sigTp : na, "TP", color=#26A69A, style=plot.style_circles, linewidth=2)

if showPanel
    var table pan = table.new(position.top_right, 1, 7, bgcolor=color.new(#0D1117, 8), border_width=1)
    if barstate.islast
        string biasTxt = biasDir == 1 ? "BUYER" : "SELLER"
        color biasC = biasDir == 1 ? #26A69A : #EF5350
        table.cell(pan, 0, 0, "TRH LQ Fractal", text_color=color.white, text_size=size.small)
        table.cell(pan, 0, 1, stack, text_color=#90A4AE, text_size=size.tiny)
        table.cell(pan, 0, 2, "Bias " + biasTxt + " · " + biasTf + "/" + macroTf, text_color=biasC, text_size=size.small)
        table.cell(pan, 0, 3, "نقدینگی در حال ساخت", text_color=lqCol, text_size=size.tiny)
        string ztxt = zDir == 0 ? "No zone" : ((zKind == 2 ? "BB+FVG " : "Fresh ") + (zDir == 1 ? "DEMAND" : "SUPPLY"))
        table.cell(pan, 0, 4, ztxt, text_color=#B0BEC5, text_size=size.tiny)
        table.cell(pan, 0, 5, na(zLq) ? "LQ: building…" : "LQ " + str.tostring(zLq, format.mintick), text_color=lqCol, text_size=size.tiny)
        table.cell(pan, 0, 6, str.length(sigPath) > 0 ? sigPath : "Wait MSS → zone → LQ sweep", text_color=#ECEFF1, text_size=size.tiny)
