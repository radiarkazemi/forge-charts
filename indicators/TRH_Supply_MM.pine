// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | LQ Fractal Setups
//
// HTF (4H+W or D+MN) = BIAS ONLY (buyer / seller)
// Chart TF (1m / 5m)  = trade + STRUCTURE TP (SSL/BSL you see on this chart)
// Never use Daily extremes as TP while trading 1m.
//
// Visual: ONE red zone (S→E) · ONE teal reward (E→structure TP)

//@version=6
indicator("TRH | LQ Fractal Setups", shorttitle="TRH-LQ",
     overlay=true, max_boxes_count=80, max_lines_count=80, max_labels_count=60,
     max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpStack = "Fractal Stack"
stack = input.string("1 — 15 — 4H — W", "Active Stack",
     options=["1 — 15 — 4H — W", "5 — 1H — D — MN"], group=grpStack,
     tooltip="Attach on ENTRY chart (1m or 5m).\nUpper TFs = bias only.")
requireBiasAlign = input.bool(true, "Only Setups With Bias", group=grpStack)
biasMode = input.string("Candle + EMA", "Bias Method",
     options=["Candle + EMA", "Close vs Prior", "EMA only"], group=grpStack)

grpModel = "Detection (chart TF)"
pivotLen     = input.int(3, "Pivot Length", minval=2, maxval=8, group=grpModel)
mssBodyAtr   = input.float(0.45, "Min MSS Body (ATR×)", step=0.05, group=grpModel)
minZonePts   = input.float(2.0, "Min Zone Height (price)", step=0.1, group=grpModel)
maxZoneAtr   = input.float(1.80, "Max Zone Height (ATR×)", step=0.1, group=grpModel)
slPadPts     = input.float(0.10, "SL Pad Beyond Distal", step=0.05, group=grpModel)
cooldownBars = input.int(25, "Cooldown Between Setups", minval=5, group=grpModel)
boxBars      = input.int(28, "Box Width (bars)", minval=8, maxval=80, group=grpModel)
requireReturn = input.bool(false, "Teal Only After Return", group=grpModel,
     tooltip="OFF = draw red+teal together when zone forms (like your screenshot).\nON = teal after retest.")

grpTp = "Structure TP (THIS chart — not Daily)"
structBars = input.int(180, "Structure Lookback (bars)", minval=40, maxval=500, group=grpTp,
     tooltip="Major SSL/BSL on the chart you trade (1m). All shorts share this floor when valid.")
minStructR = input.float(1.5, "Min Structure Distance (R)", minval=1.0, step=0.1, group=grpTp)
rrFallback = input.float(2.5, "Fallback RR If No Structure", minval=1.0, step=0.5, group=grpTp)
showStruct = input.bool(true, "Show Structure TP Line", group=grpTp)

grpDisp = "Display"
showPanel = input.bool(true, "Panel", group=grpDisp)
showMss   = input.bool(true, "Tiny MSS Tag", group=grpDisp)
showES    = input.bool(true, "E / S Tags", group=grpDisp)
maxKeep   = input.int(4, "Keep Last N Setups", minval=1, maxval=8, group=grpDisp)
redCol    = input.color(color.new(#EF5350, 78), "Zone / Risk", group=grpDisp)
tealCol   = input.color(color.new(#26A69A, 82), "Reward", group=grpDisp)
eCol      = input.color(#66BB6A, "E", group=grpDisp)
sCol      = input.color(#EF5350, "S", group=grpDisp)
mssCol    = input.color(#CE93D8, "MSS", group=grpDisp)
structCol = input.color(color.new(#90A4AE, 30), "Structure line", group=grpDisp)

// ═══════════════════════════════════════════════════════════════════════════
// BIAS ONLY from upper TFs
// ═══════════════════════════════════════════════════════════════════════════

isFast  = stack == "1 — 15 — 4H — W"
biasTf  = isFast ? "240" : "D"
macroTf = isFast ? "W" : "M"
atr = ta.atr(14)

f_bias(string tf) =>
    float c = request.security(syminfo.tickerid, tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float o = request.security(syminfo.tickerid, tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float c1 = request.security(syminfo.tickerid, tf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float ema = request.security(syminfo.tickerid, tf, ta.ema(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    int b = 0
    if biasMode == "Candle + EMA"
        b := (c > o and c > ema) ? 1 : (c < o and c < ema) ? -1 : (c >= c1 ? 1 : -1)
    else if biasMode == "Close vs Prior"
        b := c >= c1 ? 1 : -1
    else
        b := c >= ema ? 1 : -1
    b

biasDir = f_bias(biasTf)
macroBias = f_bias(macroTf)
aligned = biasDir == macroBias
okLong  = not requireBiasAlign or (biasDir == 1 and aligned)
okShort = not requireBiasAlign or (biasDir == -1 and aligned)

// ═══════════════════════════════════════════════════════════════════════════
// CHART STRUCTURE TP — major SSL / BSL on THIS timeframe
// ═══════════════════════════════════════════════════════════════════════════

// Exclude current bar so the line is stable
chartSsl = ta.lowest(low[1], structBars)   // sell-side liquidity / structure low
chartBsl = ta.highest(high[1], structBars) // buy-side liquidity / structure high

var line structLine = na
var label structLab = na
if showStruct and barstate.islast
    line.delete(structLine)
    label.delete(structLab)
    float sp = biasDir == -1 ? chartSsl : chartBsl
    string st = biasDir == -1 ? "SSL structure TP" : "BSL structure TP"
    structLine := line.new(bar_index - structBars, sp, bar_index + boxBars, sp, color=structCol, style=line.style_dashed, width=1)
    structLab := label.new(bar_index + boxBars, sp, st, style=label.style_label_left, color=color.new(structCol, 100), textcolor=#B0BEC5, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// PIVOTS (chart TF entries)
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float[] hiPx = array.new_float()
var int[]   hiBr = array.new_int()
var float[] loPx = array.new_float()
var int[]   loBr = array.new_int()

if not na(ph)
    array.push(hiPx, ph)
    array.push(hiBr, bar_index - pivotLen)
    if array.size(hiPx) > 25
        array.shift(hiPx)
        array.shift(hiBr)
if not na(pl)
    array.push(loPx, pl)
    array.push(loBr, bar_index - pivotLen)
    if array.size(loPx) > 25
        array.shift(loPx)
        array.shift(loBr)

lastHi = array.size(hiPx) > 0 ? array.get(hiPx, array.size(hiPx) - 1) : float(na)
lastLo = array.size(loPx) > 0 ? array.get(loPx, array.size(loPx) - 1) : float(na)
lastHiB = array.size(hiBr) > 0 ? array.get(hiBr, array.size(hiBr) - 1) : int(na)
lastLoB = array.size(loBr) > 0 ? array.get(loBr, array.size(loBr) - 1) : int(na)

f_ob(int dir, int look) =>
    float prox = na
    float dist = na
    int ok = 0
    for k = 1 to look
        if ok == 0
            bool opp = dir == -1 ? close[k] > open[k] : close[k] < open[k]
            if opp
                prox := dir == -1 ? low[k] : high[k]
                dist := dir == -1 ? high[k] : low[k]
                ok := 1
    [prox, dist, ok]

f_ok_zone(float prox, float dist) =>
    float h = math.abs(dist - prox)
    h >= minZonePts and h <= atr * maxZoneAtr

// TP = chart structure (shared SSL/BSL). Never Daily.
f_tp(int dir, float entry, float sl) =>
    float risk = math.abs(entry - sl)
    float tpR = dir == 1 ? entry + risk * rrFallback : entry - risk * rrFallback
    float tp = tpR
    if dir == -1
        float ssl = chartSsl
        if not na(ssl) and ssl < entry and (entry - ssl) >= risk * minStructR
            tp := ssl
    else
        float bsl = chartBsl
        if not na(bsl) and bsl > entry and (bsl - entry) >= risk * minStructR
            tp := bsl
    tp

// ═══════════════════════════════════════════════════════════════════════════
// SETUPS
// ═══════════════════════════════════════════════════════════════════════════

var int lastBirth = na
var int[]   dDir = array.new_int()
var int[]   dBirth = array.new_int()
var float[] dProx = array.new_float()
var float[] dDist = array.new_float()
var float[] dEntry = array.new_float()
var float[] dSl = array.new_float()
var float[] dTp = array.new_float()
var int[]   dLeft = array.new_int()
var int[]   dLive = array.new_int()
var int[]   dDead = array.new_int()
var box[]   zoneBox = array.new_box()
var box[]   rewBox = array.new_box()
var label[] eLab = array.new_label()
var label[] sLab = array.new_label()

f_can() =>
    na(lastBirth) or (bar_index - lastBirth) >= cooldownBars

f_kill_idx(int i) =>
    box.delete(array.get(zoneBox, i))
    box.delete(array.get(rewBox, i))
    label.delete(array.get(eLab, i))
    label.delete(array.get(sLab, i))

f_shift() =>
    if array.size(dDir) > 0
        f_kill_idx(0)
        array.shift(dDir)
        array.shift(dBirth)
        array.shift(dProx)
        array.shift(dDist)
        array.shift(dEntry)
        array.shift(dSl)
        array.shift(dTp)
        array.shift(dLeft)
        array.shift(dLive)
        array.shift(dDead)
        array.shift(zoneBox)
        array.shift(rewBox)
        array.shift(eLab)
        array.shift(sLab)

f_birth(int dir, float prox, float dist) =>
    while array.size(dDir) >= maxKeep
        f_shift()
    int bi = bar_index
    float entry = prox
    float sl = dir == -1 ? dist + slPadPts : dist - slPadPts
    float tp = f_tp(dir, entry, sl)
    int x2 = bi + boxBars

    box zb = box.new(bi, math.max(entry, sl), x2, math.min(entry, sl),
         border_color=color.new(redCol, 40), bgcolor=redCol, border_width=1)
    box rb = na
    if not requireReturn
        rb := box.new(bi, math.max(entry, tp), x2, math.min(entry, tp),
             border_color=color.new(tealCol, 45), bgcolor=tealCol, border_width=1)

    label el = showES ? label.new(x2, entry, "E", style=label.style_label_left, color=color.new(eCol, 100), textcolor=eCol, size=size.normal) : na
    label slb = showES ? label.new(x2, sl, "S", style=label.style_label_left, color=color.new(sCol, 100), textcolor=sCol, size=size.normal) : na

    array.push(dDir, dir)
    array.push(dBirth, bi)
    array.push(dProx, prox)
    array.push(dDist, dist)
    array.push(dEntry, entry)
    array.push(dSl, sl)
    array.push(dTp, tp)
    array.push(dLeft, 0)
    array.push(dLive, requireReturn ? 0 : 1)
    array.push(dDead, 0)
    array.push(zoneBox, zb)
    array.push(rewBox, rb)
    array.push(eLab, el)
    array.push(sLab, slb)
    bi

body = math.abs(close - open)
mssShort = okShort and not na(lastLo) and not na(lastHi) and not na(lastHiB) and not na(lastLoB) and lastHiB > lastLoB and close < lastLo and body >= atr * mssBodyAtr and close < open
mssLong  = okLong  and not na(lastHi) and not na(lastLo) and not na(lastHiB) and not na(lastLoB) and lastLoB > lastHiB and close > lastHi and body >= atr * mssBodyAtr and close > open

born = false
if mssShort and f_can()
    [p, d, ok] = f_ob(-1, 8)
    if ok == 1 and f_ok_zone(p, d) and p > close
        lastBirth := f_birth(-1, p, d)
        born := true
        if showMss
            label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(mssCol, 50), textcolor=color.white, size=size.tiny)

if mssLong and f_can() and not born
    [p, d, ok] = f_ob(1, 8)
    if ok == 1 and f_ok_zone(p, d) and p < close
        lastBirth := f_birth(1, p, d)
        born := true
        if showMss
            label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(mssCol, 50), textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// MANAGE + keep live TPs glued to chart structure
// ═══════════════════════════════════════════════════════════════════════════

n = array.size(dDir)
liveN = 0
if n > 0
    for i = 0 to n - 1
        if array.get(dDead, i) == 0
            liveN += 1
            int dir = array.get(dDir, i)
            float entry = array.get(dEntry, i)
            float sl = array.get(dSl, i)
            float prox = array.get(dProx, i)
            float loZ = math.min(array.get(dProx, i), array.get(dDist, i))
            float hiZ = math.max(array.get(dProx, i), array.get(dDist, i))
            int bi = array.get(dBirth, i)
            int x2 = math.max(bar_index + 1, bi + boxBars)

            // Always retarget TP to current chart structure (shared SSL/BSL)
            float tp = f_tp(dir, entry, sl)
            array.set(dTp, i, tp)

            box zb = array.get(zoneBox, i)
            if not na(zb)
                box.set_right(zb, x2)

            box rb = array.get(rewBox, i)
            if array.get(dLive, i) == 1
                box.delete(rb)
                rb := box.new(bi, math.max(entry, tp), x2, math.min(entry, tp),
                     border_color=color.new(tealCol, 45), bgcolor=tealCol, border_width=1)
                array.set(rewBox, i, rb)
            else if not na(rb)
                box.set_right(rb, x2)

            if showES
                label el = array.get(eLab, i)
                label slb = array.get(sLab, i)
                if not na(el)
                    label.set_x(el, x2)
                    label.set_y(el, entry)
                if not na(slb)
                    label.set_x(slb, x2)
                    label.set_y(slb, sl)

            if array.get(dLeft, i) == 0
                if (dir == -1 and close < loZ) or (dir == 1 and close > hiZ)
                    array.set(dLeft, i, 1)

            if requireReturn and array.get(dLeft, i) == 1 and array.get(dLive, i) == 0
                bool touchE = dir == -1 ? (high >= entry and low <= hiZ) : (low <= entry and high >= loZ)
                if touchE
                    array.set(dLive, i, 1)
                    box.delete(array.get(rewBox, i))
                    array.set(rewBox, i, box.new(bi, math.max(entry, tp), x2, math.min(entry, tp),
                         border_color=color.new(tealCol, 45), bgcolor=tealCol, border_width=1))

            bool stopHit = dir == -1 ? close > sl : close < sl
            bool tpHit = array.get(dLive, i) == 1 and (dir == -1 ? low <= tp : high >= tp)
            bool expired = (bar_index - bi) > boxBars * 4 and array.get(dLive, i) == 0
            if stopHit or tpHit or expired
                array.set(dDead, i, 1)
                if not na(zb)
                    box.set_right(zb, bar_index)
                rb := array.get(rewBox, i)
                if not na(rb)
                    box.set_right(rb, bar_index)

alertcondition(born and mssShort, "Supply Zone", "TRH-LQ supply zone · TP=chart SSL")
alertcondition(born and mssLong, "Demand Zone", "TRH-LQ demand zone · TP=chart BSL")

if showPanel
    var table pan = table.new(position.top_right, 1, 7, bgcolor=color.new(#0D1117, 10), border_width=1)
    if barstate.islast
        string biasTxt = biasDir == 1 ? "BUYER" : "SELLER"
        color biasC = biasDir == 1 ? #26A69A : #EF5350
        float sp = biasDir == -1 ? chartSsl : chartBsl
        table.cell(pan, 0, 0, "TRH LQ Setups", text_color=color.white, text_size=size.small)
        table.cell(pan, 0, 1, stack, text_color=#90A4AE, text_size=size.tiny)
        table.cell(pan, 0, 2, "Bias " + biasTxt + " (" + biasTf + "/" + macroTf + ")", text_color=biasC, text_size=size.small)
        table.cell(pan, 0, 3, "نقدینگی در حال ساخت", text_color=#FFB74D, text_size=size.tiny)
        table.cell(pan, 0, 4, "Live setups: " + str.tostring(liveN), text_color=#B0BEC5, text_size=size.tiny)
        table.cell(pan, 0, 5, "TP = chart structure (not Daily)", text_color=#80CBC4, text_size=size.tiny)
        table.cell(pan, 0, 6, "Structure " + str.tostring(sp, format.mintick), text_color=#78909C, text_size=size.tiny)
