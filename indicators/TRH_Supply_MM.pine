// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | Supply MM + MSS + HTF/LQ + BB/FVG + Fractal Sweep
//
// Setup 1 (MM):     Displacement → OB/FVG → E/S · R ladder 1/2/3/5
// Setup 2 (MSS):    Break of structure → Fresh Zone → retest · teal TP
// Setup 3 (HTF+LQ): HTF zone → MSS → New Fresh Zone → LQ build → sweep into zone · teal TP
// Setup 4 (BB+FVG): Sweep → MSS → Breaker Block + FVG confluence → retest · teal TP
// Setup 5 (fs):     Fractal Sweep of fs level into pink zone → blue expansion
// All stay enabled independently.

//@version=6
indicator("TRH | Supply MM Pack", shorttitle="TRH-SMM",
     overlay=true, max_boxes_count=200, max_lines_count=350, max_labels_count=220,
     max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpDir = "Direction"
allowLong  = input.bool(true, "Allow Demand (Long)", group=grpDir)
allowShort = input.bool(true, "Allow Supply (Short)", group=grpDir)

grpSetups = "Which Setups"
useSetupMM  = input.bool(true, "Setup 1 — Supply MM (disp → OB/FVG · R ladder)", group=grpSetups)
useSetupMss = input.bool(true, "Setup 2 — MSS Fresh Zone", group=grpSetups,
     tooltip="MSS → fresh zone at origin → retest E/S · teal TP.")
useSetupHtf = input.bool(true, "Setup 3 — HTF → MSS → Fresh → LQ sweep", group=grpSetups,
     tooltip="HTF zone context → MSS → New Fresh Zone → liquidity (LQ) builds → sweep LQ into fresh zone → short/long.")
useSetupBb  = input.bool(true, "Setup 4 — Sweep → MSS → BB + FVG", group=grpSetups,
     tooltip="Liquidity sweep → MSS → Breaker Block + Fair Value Gap confluence → retest.")
useSetupFs  = input.bool(true, "Setup 5 — Fractal Sweep (fs)", group=grpSetups,
     tooltip="fs level at swing → wick sweep into pink zone → blue expansion TP.")

grpZone = "Setup 1 — Zone Source"
zoneMode = input.string("Order Block", "Zone Type",
     options=["Order Block", "FVG", "OB + FVG"], group=grpZone,
     tooltip="Order Block = last opposing candle before displacement (Money Management Tool).\nFVG = imbalance; entry still at PROXIMAL edge (not CE mid).")
minDispAtr   = input.float(0.70, "Min Displacement Body (ATR×)", step=0.05, group=grpZone)
minCtxAtr    = input.float(0.40, "Min Impulse Range (ATR×)", step=0.05, group=grpZone)
maxLookback  = input.int(8, "Bars To Find OB Before Disp", minval=1, maxval=20, group=grpZone)
minFvgAtr    = input.float(0.25, "Min FVG (ATR×)", step=0.01, group=grpZone)
minFvgPts    = input.float(1.50, "Min FVG (price)", step=0.05, group=grpZone)
minZonePts   = input.float(2.00, "Min Zone Height (price)", step=0.10, group=grpZone,
     tooltip="Reject tiny boxes. Gold example zone ≈ 3–4pts.")
maxZoneAtr   = input.float(2.50, "Max Zone Height (ATR×)", step=0.1, group=grpZone)
cooldownBars = input.int(25, "Cooldown After New Zone", minval=1, group=grpZone)

grpMss = "Setup 2/3 — MSS / HTF / LQ"
mssPivot     = input.int(3, "MSS Pivot Length", minval=2, maxval=8, group=grpMss)
mssBodyAtr   = input.float(0.35, "Min MSS Body (ATR×)", step=0.05, group=grpMss)
structBars   = input.int(120, "Structure TP Lookback (bars)", minval=30, maxval=400, group=grpMss,
     tooltip="Teal reward box targets major swing low (shorts) / high (longs) on THIS chart.")
minStructR   = input.float(1.5, "Min Structure Distance (R)", minval=1.0, step=0.1, group=grpMss)
lqTolAtr     = input.float(0.12, "LQ Equal Hi/Lo Tol (ATR×)", step=0.01, group=grpMss)
minLqTouches = input.int(2, "Min Equal Touches For LQ", minval=2, maxval=6, group=grpMss)
lqFallbackBars = input.int(20, "Arm Without LQ After N Bars", minval=5, group=grpMss,
     tooltip="If equal LQ never forms, still allow retest arm after this many bars (Setup 3).")
showMssTag   = input.bool(true, "Show MSS Tag", group=grpMss)
showHtfZone  = input.bool(true, "Show HTF Zone (Setup 3)", group=grpMss)
showLqLine   = input.bool(true, "Show LQ Line (Setup 3)", group=grpMss)
showTealTp   = input.bool(true, "Show Teal Structure TP Box", group=grpMss)

grpBb = "Setup 4 — BB + FVG"
sweepLookback = input.int(18, "Sweep Memory (bars)", minval=5, maxval=60, group=grpBb,
     tooltip="How long a liquidity sweep stays valid before MSS + BB/FVG.")
bbFvgPadAtr   = input.float(0.35, "BB↔FVG Near Tol (ATR×)", step=0.05, group=grpBb,
     tooltip="If BB and FVG do not overlap, still allow when within this distance.")
showBbTag     = input.bool(true, "Show BB + FVG Label", group=grpBb)

grpFs = "Setup 5 — Fractal Sweep"
fsPivot       = input.int(2, "fs Pivot Length", minval=1, maxval=6, group=grpFs)
fsMaxDepthAtr = input.float(0.85, "Max Sweep Depth (ATR×)", step=0.05, group=grpFs,
     tooltip="Reject deep stop-runs; image sweeps are shallow wicks below fs.")
fsMinDepthPts = input.float(0.10, "Min Sweep Depth (price)", step=0.05, group=grpFs)
fsCooldown    = input.int(8, "fs Cooldown (bars)", minval=1, group=grpFs)
showFsLine    = input.bool(true, "Show fs Level Lines", group=grpFs)
showErlTag    = input.bool(true, "Show Major ERL Tag", group=grpFs)
fsPinkCol     = input.color(color.new(#EF9A9A, 72), "Sweep Zone (pink)", group=grpFs)
fsBlueCol     = input.color(color.new(#81D4FA, 78), "Expansion TP (blue)", group=grpFs)
fsLineCol     = input.color(#90A4AE, "fs Line", group=grpFs)

grpScore = "Clean Score (avoid dirty SL)"
useCleanScore = input.bool(true, "Enable Scoring System", group=grpScore,
     tooltip="Scores each zone 0–100 and grades A/B/C/D so you only take cleaner entries.")
rejectLowScore = input.bool(true, "Reject Zones Below Keep Score", group=grpScore,
     tooltip="Do not draw dirty zones at all (stops the 14-zone clutter / weak SL hits).")
minScoreKeep = input.int(62, "Min Score To Keep Zone", minval=0, maxval=100, group=grpScore)
minScoreArm  = input.int(70, "Min Score To Arm / Alert", minval=0, maxval=100, group=grpScore,
     tooltip="Even if drawn, only ARM when score ≥ this. A≈80+ · B≈70+ · C≈55+ · D=skip.")
showScoreTag = input.bool(true, "Show Score Tag On Zone", group=grpScore)
hideFsNoise  = input.bool(true, "Stricter Score For fs (Setup 5)", group=grpScore,
     tooltip="fs alone is noisy — needs higher confluence/RR to pass. Likely cause of quick SL hits.")

grpTrade = "Arm / Fill"
requireLeave = input.bool(true, "Require Leave Then Return", group=grpTrade,
     tooltip="Price must leave the zone after creation, then return to proximal.")
invalidateThru = input.bool(true, "Invalidate If Close Through Distal", group=grpTrade)
extendBars   = input.int(50, "Extend Levels (bars)", minval=5, group=grpTrade)

grpDisp = "Display"
showHistory  = input.bool(true, "Show Historical Zones", group=grpDisp)
showLabels   = input.bool(true, "Show E / S / R Labels", group=grpDisp)
showPanel    = input.bool(true, "Info Panel", group=grpDisp)
draw1R = input.bool(true, "Draw 1R (Setup 1)", group=grpDisp)
draw2R = input.bool(true, "Draw 2R (Setup 1)", group=grpDisp)
draw3R = input.bool(true, "Draw 3R (Setup 1)", group=grpDisp)
draw5R = input.bool(true, "Draw 5R (Setup 1)", group=grpDisp)
supplyCol = input.color(color.new(#EF5350, 78), "Supply Zone", group=grpDisp)
demandCol = input.color(color.new(#26A69A, 78), "Demand Zone", group=grpDisp)
entryCol  = input.color(#66BB6A, "Entry (E)", group=grpDisp)
slCol     = input.color(#EF5350, "Stop (S)", group=grpDisp)
tpCol     = input.color(#90A4AE, "R Targets", group=grpDisp)
tealCol   = input.color(color.new(#26A69A, 82), "Teal TP", group=grpDisp)
mssCol    = input.color(#CE93D8, "MSS Tag", group=grpDisp)
htfCol    = input.color(color.new(#EF9A9A, 82), "HTF Zone", group=grpDisp)
lqCol     = input.color(#FFB74D, "LQ", group=grpDisp)

// ═══════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(14)
body = math.abs(close - open)
impulseRange = high - low
chartSsl = ta.lowest(low[1], structBars)
chartBsl = ta.highest(high[1], structBars)
rngHi30 = ta.highest(high, 30)
rngLo30 = ta.lowest(low, 30)

useOB  = zoneMode == "Order Block" or zoneMode == "OB + FVG"
useFVG = zoneMode == "FVG" or zoneMode == "OB + FVG"

var int lastBirth = na

// Per-zone drawings (newest last). Max 10 live zones.
MAX_Z = 14
var box[]   boxes = array.new_box()
var line[]  eLines = array.new_line()
var line[]  sLines = array.new_line()
var label[] eLabs = array.new_label()
var label[] sLabs = array.new_label()
var line[]  t1 = array.new_line()
var line[]  t2 = array.new_line()
var line[]  t3 = array.new_line()
var line[]  t5 = array.new_line()
var label[] l1 = array.new_label()
var label[] l2 = array.new_label()
var label[] l3 = array.new_label()
var label[] l5 = array.new_label()

var int[]   zDir = array.new_int()
var int[]   zKind = array.new_int()   // 0=MM · 1=MSS · 2=HTF+LQ · 3=BB+FVG · 4=fs
var int[]   zBirth = array.new_int()
var float[] zProx = array.new_float()
var float[] zDist = array.new_float()
var int[]   zLeft = array.new_int()
var int[]   zArmed = array.new_int()
var int[]   zDead = array.new_int()
var float[] zLq = array.new_float()
var int[]   zLqN = array.new_int()    // equal touches toward LQ
var int[]   zScore = array.new_int()  // 0–100 clean score
var label[] scoreLabs = array.new_label()
var box[]   tealBoxes = array.new_box()
var box[]   htfBoxes = array.new_box()
var line[]  lqLines = array.new_line()
var label[] lqLabs = array.new_label()

f_zone_ok(float prox, float dist) =>
    float h = math.abs(dist - prox)
    h >= minZonePts and h <= atr * maxZoneAtr and h > syminfo.mintick

f_can_birth() =>
    na(lastBirth) or (bar_index - lastBirth) >= cooldownBars

f_delete_idx(int i) =>
    if i >= 0 and i < array.size(boxes)
        box.delete(array.get(boxes, i))
        line.delete(array.get(eLines, i))
        line.delete(array.get(sLines, i))
        label.delete(array.get(eLabs, i))
        label.delete(array.get(sLabs, i))
        line.delete(array.get(t1, i))
        line.delete(array.get(t2, i))
        line.delete(array.get(t3, i))
        line.delete(array.get(t5, i))
        label.delete(array.get(l1, i))
        label.delete(array.get(l2, i))
        label.delete(array.get(l3, i))
        label.delete(array.get(l5, i))
        box.delete(array.get(tealBoxes, i))
        box.delete(array.get(htfBoxes, i))
        line.delete(array.get(lqLines, i))
        label.delete(array.get(lqLabs, i))
        label.delete(array.get(scoreLabs, i))

f_shift_oldest() =>
    if array.size(zDir) > 0
        f_delete_idx(0)
        array.shift(boxes)
        array.shift(eLines)
        array.shift(sLines)
        array.shift(eLabs)
        array.shift(sLabs)
        array.shift(t1)
        array.shift(t2)
        array.shift(t3)
        array.shift(t5)
        array.shift(l1)
        array.shift(l2)
        array.shift(l3)
        array.shift(l5)
        array.shift(zDir)
        array.shift(zKind)
        array.shift(zBirth)
        array.shift(zProx)
        array.shift(zDist)
        array.shift(zLeft)
        array.shift(zArmed)
        array.shift(zDead)
        array.shift(zLq)
        array.shift(zLqN)
        array.shift(zScore)
        array.shift(scoreLabs)
        array.shift(tealBoxes)
        array.shift(htfBoxes)
        array.shift(lqLines)
        array.shift(lqLabs)

f_mk_tp(int bi, float px, int dir, float R, float mult, bool on) =>
    line ln = na
    label lb = na
    if on
        float tp = dir == 1 ? px + R * mult : px - R * mult
        ln := line.new(bi, tp, bi + extendBars, tp, color=tpCol, style=line.style_dotted, width=1)
        if showLabels
            lb := label.new(bi + extendBars, tp, str.tostring(mult),
                 style=label.style_label_left, color=color.new(tpCol, 100), textcolor=tpCol, size=size.tiny)
    [ln, lb]

f_struct_tp(int dir, float entry, float sl) =>
    float risk = math.abs(entry - sl)
    float tp = dir == 1 ? entry + risk * 2.5 : entry - risk * 2.5
    if dir == -1 and not na(chartSsl) and chartSsl < entry and (entry - chartSsl) >= risk * minStructR
        tp := chartSsl
    if dir == 1 and not na(chartBsl) and chartBsl > entry and (chartBsl - entry) >= risk * minStructR
        tp := chartBsl
    tp

f_grade(int sc) =>
    sc >= 80 ? "A" : sc >= 70 ? "B" : sc >= 55 ? "C" : "D"

f_kind_name(int kind) =>
    kind == 0 ? "S1-MM" : kind == 1 ? "S2-MSS" : kind == 2 ? "S3-HTF/LQ" : kind == 3 ? "S4-BB+FVG" : "S5-fs"

// Clean score 0–100 — higher = safer / cleaner entry
f_score_zone(int dir, float prox, float dist, int kind, int lqN) =>
    int sc = kind == 3 ? 74 : kind == 2 ? 70 : kind == 1 ? 60 : kind == 0 ? 56 : 36
    if hideFsNoise and kind == 4
        sc -= 8
    float risk = math.abs(dist - prox)
    float atrX = atr > 0 ? risk / atr : 1.0
    // Clean SL size (not tiny wick, not huge bag)
    if atrX >= 0.22 and atrX <= 1.10
        sc += 14
    else if atrX < 0.12 or atrX > 2.20
        sc -= 22
    else if atrX > 1.50 or atrX < 0.18
        sc -= 10
    float tp = f_struct_tp(dir, prox, dist)
    float reward = math.abs(tp - prox)
    float rr = risk > 0 ? reward / risk : 0.0
    if rr >= 3.0
        sc += 14
    else if rr >= 2.0
        sc += 9
    else if rr >= 1.5
        sc += 3
    else
        sc -= 14
    // Impulse quality on birth bar
    if body >= atr * minDispAtr
        sc += 6
    else if body < atr * 0.20
        sc -= 6
    if kind == 2 and lqN >= minLqTouches
        sc += 12
    // Confluence: another live zone same direction nearby
    int n = array.size(zDir)
    if n > 0
        for j = 0 to n - 1
            if array.get(zDead, j) == 0 and array.get(zDir, j) == dir and array.get(zKind, j) != kind
                float jp = array.get(zProx, j)
                if math.abs(jp - prox) <= atr * 0.55
                    sc += 10
    // Mid-chop penalty: proximal inside recent range center
    float hiN = rngHi30
    float loN = rngLo30
    float mid = (hiN + loN) * 0.5
    float rng = hiN - loN
    if rng > atr and math.abs(prox - mid) < rng * 0.18
        sc -= 8
    math.min(100, math.max(0, sc))

// kind: 0=MM · 1=MSS · 2=HTF+LQ · 3=BB+FVG · 4=fs
// returns bar_index on success, -1 if rejected as dirty
f_push_zone(int dir, float prox, float dist, int kind, float htfTop, float htfBot) =>
    int sc = useCleanScore ? f_score_zone(dir, prox, dist, kind, 0) : 75
    int out = -1
    if not (useCleanScore and rejectLowScore and sc < minScoreKeep)
        while array.size(zDir) >= MAX_Z
            f_shift_oldest()
        int bi = bar_index
        float R = math.abs(dist - prox)
        color zc = kind == 4 ? fsPinkCol : dir == 1 ? demandCol : supplyCol
        // Mute C/D visually even if kept
        if useCleanScore and sc < minScoreArm
            zc := color.new(zc, 90)
        array.push(zDir, dir)
        array.push(zKind, kind)
        array.push(zBirth, bi)
        array.push(zProx, prox)
        array.push(zDist, dist)
        array.push(zLeft, kind == 4 ? 1 : (requireLeave ? 0 : 1))
        array.push(zArmed, kind == 4 and (not useCleanScore or sc >= minScoreArm) ? 1 : 0)
        array.push(zDead, 0)
        array.push(zLq, float(na))
        array.push(zLqN, 0)
        array.push(zScore, sc)
        array.push(boxes, box.new(bi, math.max(prox, dist), bi + 1, math.min(prox, dist),
             border_color=color.new(zc, 25), bgcolor=zc))
        array.push(eLines, line.new(bi, prox, bi + extendBars, prox, color=entryCol, style=line.style_dashed, width=2))
        array.push(sLines, line.new(bi, dist, bi + extendBars, dist, color=slCol, style=line.style_dashed, width=2))
        if showLabels
            array.push(eLabs, label.new(bi + 2, prox, "E", style=label.style_label_left, color=color.new(entryCol, 100), textcolor=entryCol, size=size.normal))
            array.push(sLabs, label.new(bi + 2, dist, "S", style=label.style_label_left, color=color.new(slCol, 100), textcolor=slCol, size=size.normal))
        else
            array.push(eLabs, label(na))
            array.push(sLabs, label(na))
        string g = f_grade(sc)
        color gc = sc >= 80 ? #66BB6A : sc >= 70 ? #FFD54F : sc >= 55 ? #FFA726 : #EF5350
        if showScoreTag and useCleanScore
            array.push(scoreLabs, label.new(bi + 3, (prox + dist) * 0.5, g + " " + str.tostring(sc) + " · " + f_kind_name(kind), style=label.style_label_left, color=color.new(gc, 20), textcolor=color.white, size=size.small))
        else
            array.push(scoreLabs, label(na))
        bool doR = kind == 0 and sc >= minScoreArm
        [ln1, lb1] = f_mk_tp(bi, prox, dir, R, 1.0, doR and draw1R)
        [ln2, lb2] = f_mk_tp(bi, prox, dir, R, 2.0, doR and draw2R)
        [ln3, lb3] = f_mk_tp(bi, prox, dir, R, 3.0, doR and draw3R)
        [ln5, lb5] = f_mk_tp(bi, prox, dir, R, 5.0, doR and draw5R)
        array.push(t1, ln1)
        array.push(t2, ln2)
        array.push(t3, ln3)
        array.push(t5, ln5)
        array.push(l1, lb1)
        array.push(l2, lb2)
        array.push(l3, lb3)
        array.push(l5, lb5)
        box tb = na
        if (kind == 1 or kind == 2 or kind == 3 or kind == 4) and showTealTp and (not useCleanScore or sc >= minScoreArm)
            float tp = f_struct_tp(dir, prox, dist)
            color tc = kind == 4 ? fsBlueCol : tealCol
            tb := box.new(bi, math.max(prox, tp), bi + extendBars, math.min(prox, tp),
                 border_color=color.new(tc, 40), bgcolor=tc, border_width=1)
        array.push(tealBoxes, tb)
        box hb = na
        if kind == 2 and showHtfZone and not na(htfTop) and not na(htfBot)
            hb := box.new(bi - 15, math.max(htfTop, htfBot), bi + extendBars, math.min(htfTop, htfBot),
                 border_color=color.new(htfCol, 35), bgcolor=htfCol, border_width=1)
            if showLabels
                label.new(bi - 14, (htfTop + htfBot) * 0.5, "HTF Zone", style=label.style_label_right, color=color.new(htfCol, 100), textcolor=#EF9A9A, size=size.tiny)
        array.push(htfBoxes, hb)
        array.push(lqLines, line(na))
        array.push(lqLabs, label(na))
        out := bi
    out

// ═══════════════════════════════════════════════════════════════════════════
// SETUP 1 — DETECT DISPLACEMENT → OB / FVG
// ═══════════════════════════════════════════════════════════════════════════

bearDisp = close < open and body >= atr * minDispAtr and impulseRange >= atr * minCtxAtr
bullDisp = close > open and body >= atr * minDispAtr and impulseRange >= atr * minCtxAtr

f_find_ob(int dir) =>
    float prox = na
    float dist = na
    int found = 0
    for k = 1 to maxLookback
        if found == 0
            bool opp = dir == -1 ? close[k] > open[k] : close[k] < open[k]
            if opp
                if dir == -1
                    prox := low[k]
                    dist := high[k]
                else
                    prox := high[k]
                    dist := low[k]
                found := 1
    [prox, dist, found]

f_recent_disp(int dir, int n) =>
    bool hit = false
    for k = 0 to n
        if not hit
            float b = math.abs(close[k] - open[k])
            bool d = dir == -1 ? (close[k] < open[k] and b >= atr[k] * minDispAtr * 0.85) : (close[k] > open[k] and b >= atr[k] * minDispAtr * 0.85)
            hit := d
    hit

if useSetupMM and bearDisp and allowShort and useOB and f_can_birth()
    [p, d, ok] = f_find_ob(-1)
    if ok == 1 and f_zone_ok(p, d) and p > close
        int nb = f_push_zone(-1, p, d, 0, na, na)
        if nb >= 0
            lastBirth := nb

if useSetupMM and bullDisp and allowLong and useOB and f_can_birth()
    [p, d, ok] = f_find_ob(1)
    if ok == 1 and f_zone_ok(p, d) and p < close
        int nb = f_push_zone(1, p, d, 0, na, na)
        if nb >= 0
            lastBirth := nb

bearFvg = bar_index >= 2 and low[2] > high and (low[2] - high) >= math.max(atr * minFvgAtr, minFvgPts)
bullFvg = bar_index >= 2 and high[2] < low and (low - high[2]) >= math.max(atr * minFvgAtr, minFvgPts)

if useSetupMM and useFVG and allowShort and bearFvg and f_recent_disp(-1, 3) and f_can_birth()
    float gapTop = low[2]
    float gapBot = high
    if f_zone_ok(gapBot, gapTop)
        int nb = f_push_zone(-1, gapBot, gapTop, 0, na, na)
        if nb >= 0
            lastBirth := nb

if useSetupMM and useFVG and allowLong and bullFvg and f_recent_disp(1, 3) and f_can_birth()
    float gapBot = high[2]
    float gapTop = low
    if f_zone_ok(gapTop, gapBot)
        int nb = f_push_zone(1, gapTop, gapBot, 0, na, na)
        if nb >= 0
            lastBirth := nb

// ═══════════════════════════════════════════════════════════════════════════
// SETUP 2 / 3 — MSS → Fresh Zone  (+ HTF + LQ for Setup 3)
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, mssPivot, mssPivot)
pl = ta.pivotlow(low, mssPivot, mssPivot)
var float[] hiPx = array.new_float()
var int[]   hiBr = array.new_int()
var float[] loPx = array.new_float()
var int[]   loBr = array.new_int()

if not na(ph)
    array.push(hiPx, ph)
    array.push(hiBr, bar_index - mssPivot)
    if array.size(hiPx) > 20
        array.shift(hiPx)
        array.shift(hiBr)
if not na(pl)
    array.push(loPx, pl)
    array.push(loBr, bar_index - mssPivot)
    if array.size(loPx) > 20
        array.shift(loPx)
        array.shift(loBr)

lastHi = array.size(hiPx) > 0 ? array.get(hiPx, array.size(hiPx) - 1) : float(na)
lastLo = array.size(loPx) > 0 ? array.get(loPx, array.size(loPx) - 1) : float(na)
lastHiB = array.size(hiBr) > 0 ? array.get(hiBr, array.size(hiBr) - 1) : int(na)
lastLoB = array.size(loBr) > 0 ? array.get(loBr, array.size(loBr) - 1) : int(na)

f_eq_hi(float level, float tol) =>
    int n = 0
    int sz = array.size(hiPx)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(hiPx, i) - level) <= tol ? 1 : 0
    n

f_eq_lo(float level, float tol) =>
    int n = 0
    int sz = array.size(loPx)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(loPx, i) - level) <= tol ? 1 : 0
    n

mssSignalShort = (useSetupMss or useSetupHtf) and allowShort and not na(lastLo) and not na(lastHi) and not na(lastHiB) and not na(lastLoB) and lastHiB > lastLoB and close < lastLo and body >= atr * mssBodyAtr and close < open
mssSignalLong  = (useSetupMss or useSetupHtf) and allowLong  and not na(lastHi) and not na(lastLo) and not na(lastHiB) and not na(lastLoB) and lastLoB > lastHiB and close > lastHi and body >= atr * mssBodyAtr and close > open

mssBorn = false
htfBorn = false
if mssSignalShort and f_can_birth()
    [p, d, ok] = f_find_ob(-1)
    if ok == 1 and f_zone_ok(p, d) and p > close
        // Prefer full Setup 3 when enabled; else Setup 2
        int kind = useSetupHtf ? 2 : 1
        float htfTop = lastHi
        float htfBot = lastHi - atr * 0.7
        int nb = f_push_zone(-1, p, d, kind, htfTop, htfBot)
        if nb >= 0
            lastBirth := nb
            mssBorn := true
            htfBorn := kind == 2
            if showMssTag
                label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(mssCol, 45), textcolor=color.white, size=size.tiny)
            if kind == 2 and showLabels
                label.new(bar_index, p, "New Fresh Zone", style=label.style_label_left, color=color.new(supplyCol, 100), textcolor=#EF9A9A, size=size.tiny)

if mssSignalLong and f_can_birth() and not mssBorn
    [p, d, ok] = f_find_ob(1)
    if ok == 1 and f_zone_ok(p, d) and p < close
        int kind = useSetupHtf ? 2 : 1
        float htfBot = lastLo
        float htfTop = lastLo + atr * 0.7
        int nb = f_push_zone(1, p, d, kind, htfTop, htfBot)
        if nb >= 0
            lastBirth := nb
            mssBorn := true
            htfBorn := kind == 2
            if showMssTag
                label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(mssCol, 45), textcolor=color.white, size=size.tiny)
            if kind == 2 and showLabels
                label.new(bar_index, p, "New Fresh Zone", style=label.style_label_left, color=color.new(demandCol, 100), textcolor=#80CBC4, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// SETUP 4 — Sweep → MSS → BB + FVG confluence
// ═══════════════════════════════════════════════════════════════════════════

var int bullSweepUntil = -1
var int bearSweepUntil = -1
var float lastBullSweepLo = na
var float lastBearSweepHi = na

// Wick sweep of prior swing, then reclaim
if useSetupBb and not na(lastLo) and low < lastLo and close > lastLo
    bullSweepUntil := bar_index + sweepLookback
    lastBullSweepLo := low
if useSetupBb and not na(lastHi) and high > lastHi and close < lastHi
    bearSweepUntil := bar_index + sweepLookback
    lastBearSweepHi := high

f_find_fvg(int dir, int look) =>
    float gTop = na
    float gBot = na
    int ok = 0
    for k = 0 to look
        if ok == 0
            if dir == 1 and high[k + 2] < low[k]
                float gap = low[k] - high[k + 2]
                if gap >= math.max(atr[k] * minFvgAtr, minFvgPts)
                    gTop := low[k]
                    gBot := high[k + 2]
                    ok := 1
            if dir == -1 and low[k + 2] > high[k]
                float gapB = low[k + 2] - high[k]
                if gapB >= math.max(atr[k] * minFvgAtr, minFvgPts)
                    gTop := low[k + 2]
                    gBot := high[k]
                    ok := 1
    [gTop, gBot, ok]

f_bb_fvg_zone(int dir, float bbProx, float bbDist, float gTop, float gBot) =>
    float zTop = math.max(bbProx, bbDist)
    float zBot = math.min(bbProx, bbDist)
    float oTop = math.min(zTop, gTop)
    float oBot = math.max(zBot, gBot)
    float prox = na
    float dist = na
    int ok = 0
    if oTop > oBot
        // True overlap
        if dir == 1
            prox := oTop
            dist := oBot
        else
            prox := oBot
            dist := oTop
        ok := 1
    else
        // Near: merge when gaps are small
        float gap = oBot - oTop  // positive when separated
        if gap <= atr * bbFvgPadAtr
            float mTop = math.max(zTop, gTop)
            float mBot = math.min(zBot, gBot)
            if dir == 1
                prox := mTop
                dist := mBot
            else
                prox := mBot
                dist := mTop
            ok := 1
    [prox, dist, ok]

bbBorn = false
bbMssLong = useSetupBb and allowLong and bar_index <= bullSweepUntil and not na(lastHi) and close > lastHi and body >= atr * mssBodyAtr and close > open
bbMssShort = useSetupBb and allowShort and bar_index <= bearSweepUntil and not na(lastLo) and close < lastLo and body >= atr * mssBodyAtr and close < open

if bbMssLong and f_can_birth()
    [bp, bd, bok] = f_find_ob(1)
    [gt, gb, gok] = f_find_fvg(1, 10)
    if bok == 1 and gok == 1
        [zp, zd, zok] = f_bb_fvg_zone(1, bp, bd, gt, gb)
        if zok == 1 and f_zone_ok(zp, zd) and zp < close
            // Distal prefers sweep low when available
            float distUse = not na(lastBullSweepLo) ? math.min(zd, lastBullSweepLo) : zd
            if f_zone_ok(zp, distUse)
                int nb = f_push_zone(1, zp, distUse, 3, na, na)
                if nb >= 0
                    lastBirth := nb
                    bbBorn := true
                    if showMssTag
                        label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(mssCol, 45), textcolor=color.white, size=size.tiny)
                    if showBbTag
                        label.new(bar_index, zp, "BB + FVG", style=label.style_label_left, color=color.new(demandCol, 100), textcolor=#81D4FA, size=size.tiny)

if bbMssShort and f_can_birth() and not bbBorn
    [bp, bd, bok] = f_find_ob(-1)
    [gt, gb, gok] = f_find_fvg(-1, 10)
    if bok == 1 and gok == 1
        [zp, zd, zok] = f_bb_fvg_zone(-1, bp, bd, gt, gb)
        if zok == 1 and f_zone_ok(zp, zd) and zp > close
            float distUse = not na(lastBearSweepHi) ? math.max(zd, lastBearSweepHi) : zd
            if f_zone_ok(zp, distUse)
                int nb = f_push_zone(-1, zp, distUse, 3, na, na)
                if nb >= 0
                    lastBirth := nb
                    bbBorn := true
                    if showMssTag
                        label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(mssCol, 45), textcolor=color.white, size=size.tiny)
                    if showBbTag
                        label.new(bar_index, zp, "BB + FVG", style=label.style_label_left, color=color.new(supplyCol, 100), textcolor=#EF9A9A, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// SETUP 5 — Fractal Sweep (fs) → pink zone + blue expansion
// ═══════════════════════════════════════════════════════════════════════════

fsPh = ta.pivothigh(high, fsPivot, fsPivot)
fsPl = ta.pivotlow(low, fsPivot, fsPivot)
var float[] fsHiPx = array.new_float()
var int[]   fsHiBr = array.new_int()
var int[]   fsHiUsed = array.new_int()
var float[] fsLoPx = array.new_float()
var int[]   fsLoBr = array.new_int()
var int[]   fsLoUsed = array.new_int()
var line[]  fsHiLines = array.new_line()
var label[] fsHiLabs = array.new_label()
var line[]  fsLoLines = array.new_line()
var label[] fsLoLabs = array.new_label()
var int lastFsBirth = na
var float majorErl = na
var int majorErlBar = na

f_can_fs() =>
    na(lastFsBirth) or (bar_index - lastFsBirth) >= fsCooldown

if useSetupFs and not na(fsPh)
    array.push(fsHiPx, fsPh)
    array.push(fsHiBr, bar_index - fsPivot)
    array.push(fsHiUsed, 0)
    line lnH = showFsLine ? line.new(bar_index - fsPivot, fsPh, bar_index, fsPh, color=fsLineCol, style=line.style_solid, width=1) : line(na)
    label lbH = showFsLine and showLabels ? label.new(bar_index - fsPivot, fsPh, "fs", style=label.style_label_down, color=color.new(fsLineCol, 100), textcolor=fsLineCol, size=size.tiny) : label(na)
    array.push(fsHiLines, lnH)
    array.push(fsHiLabs, lbH)
    if array.size(fsHiPx) > 12
        line.delete(array.get(fsHiLines, 0))
        label.delete(array.get(fsHiLabs, 0))
        array.shift(fsHiPx)
        array.shift(fsHiBr)
        array.shift(fsHiUsed)
        array.shift(fsHiLines)
        array.shift(fsHiLabs)

if useSetupFs and not na(fsPl)
    array.push(fsLoPx, fsPl)
    array.push(fsLoBr, bar_index - fsPivot)
    array.push(fsLoUsed, 0)
    line lnL = showFsLine ? line.new(bar_index - fsPivot, fsPl, bar_index, fsPl, color=fsLineCol, style=line.style_solid, width=1) : line(na)
    label lbL = showFsLine and showLabels ? label.new(bar_index - fsPivot, fsPl, "fs", style=label.style_label_up, color=color.new(fsLineCol, 100), textcolor=fsLineCol, size=size.tiny) : label(na)
    array.push(fsLoLines, lnL)
    array.push(fsLoLabs, lbL)
    // Major ERL = deepest recent swing low
    if na(majorErl) or fsPl < majorErl
        majorErl := fsPl
        majorErlBar := bar_index - fsPivot
        if showErlTag
            label.new(bar_index - fsPivot, fsPl, "Major ERL", style=label.style_label_up, color=color.new(fsPinkCol, 40), textcolor=color.white, size=size.tiny)
    if array.size(fsLoPx) > 12
        line.delete(array.get(fsLoLines, 0))
        label.delete(array.get(fsLoLabs, 0))
        array.shift(fsLoPx)
        array.shift(fsLoBr)
        array.shift(fsLoUsed)
        array.shift(fsLoLines)
        array.shift(fsLoLabs)

// Extend active fs lines
if useSetupFs
    int nFsL = array.size(fsLoPx)
    if nFsL > 0
        for i = 0 to nFsL - 1
            if array.get(fsLoUsed, i) == 0 and not na(array.get(fsLoLines, i))
                line.set_x2(array.get(fsLoLines, i), bar_index)
    int nFsH = array.size(fsHiPx)
    if nFsH > 0
        for i = 0 to nFsH - 1
            if array.get(fsHiUsed, i) == 0 and not na(array.get(fsHiLines, i))
                line.set_x2(array.get(fsHiLines, i), bar_index)

fsBorn = false
fsArmedNow = false

// Declare arm state before Setup 5 may set it on the sweep bar
armedNow = false
armedDir = 0
armedProx = float(na)
armedDist = float(na)
armedR = float(na)
armedKind = 0
armedScore = 0

// Long: wick below unused fs low, shallow, reclaim / close back above
if useSetupFs and allowLong and f_can_fs()
    int nL = array.size(fsLoPx)
    if nL > 0
        for i = 0 to nL - 1
            if not fsBorn and array.get(fsLoUsed, i) == 0
                float fsLv = array.get(fsLoPx, i)
                int fsB = array.get(fsLoBr, i)
                if bar_index > fsB + fsPivot and low < fsLv and close >= fsLv
                    float depth = fsLv - low
                    if depth >= fsMinDepthPts and depth <= atr * fsMaxDepthAtr
                        float prox = fsLv
                        float distUse = low
                        int nb = f_push_zone(1, prox, distUse, 4, na, na)
                        if nb >= 0
                            lastFsBirth := nb
                            array.set(fsLoUsed, i, 1)
                            fsBorn := true
                            int scFs = array.get(zScore, array.size(zScore) - 1)
                            if not useCleanScore or scFs >= minScoreArm
                                fsArmedNow := true
                                armedNow := true
                                armedDir := 1
                                armedProx := prox
                                armedDist := distUse
                                armedR := math.abs(distUse - prox)
                                armedKind := 4
                                armedScore := scFs

// Short: wick above unused fs high
if useSetupFs and allowShort and f_can_fs() and not fsBorn
    int nH = array.size(fsHiPx)
    if nH > 0
        for i = 0 to nH - 1
            if not fsBorn and array.get(fsHiUsed, i) == 0
                float fsLv = array.get(fsHiPx, i)
                int fsB = array.get(fsHiBr, i)
                if bar_index > fsB + fsPivot and high > fsLv and close <= fsLv
                    float depth = high - fsLv
                    if depth >= fsMinDepthPts and depth <= atr * fsMaxDepthAtr
                        float prox = fsLv
                        float dist = high
                        int nb = f_push_zone(-1, prox, dist, 4, na, na)
                        if nb >= 0
                            lastFsBirth := nb
                            array.set(fsHiUsed, i, 1)
                            fsBorn := true
                            int scFs = array.get(zScore, array.size(zScore) - 1)
                            if not useCleanScore or scFs >= minScoreArm
                                fsArmedNow := true
                                armedNow := true
                                armedDir := -1
                                armedProx := prox
                                armedDist := dist
                                armedR := math.abs(dist - prox)
                                armedKind := 4
                                armedScore := scFs

// ═══════════════════════════════════════════════════════════════════════════
// UPDATE ZONES
// ═══════════════════════════════════════════════════════════════════════════

lqReady = false
lqBuilding = false

nZ = array.size(zDir)
if nZ > 0
    for i = 0 to nZ - 1
        if array.get(zDead, i) == 0
            int dir = array.get(zDir, i)
            int kind = array.get(zKind, i)
            float prox = array.get(zProx, i)
            float dist = array.get(zDist, i)
            float loZ = math.min(prox, dist)
            float hiZ = math.max(prox, dist)
            int wasArmed = array.get(zArmed, i)
            float atrL = atr > 0 ? atr : syminfo.mintick

            if array.get(zLeft, i) == 0
                bool left = dir == -1 ? close < loZ : close > hiZ
                if left
                    array.set(zLeft, i, 1)

            // After leave: Setup 3 builds LQ; Setup 1/2/4 arm on return to proximal
            // Setup 5 already armed at birth (if score clean enough)
            if array.get(zLeft, i) == 1 and wasArmed == 0 and kind != 4
                int scNow = array.get(zScore, i)
                bool scoreOk = not useCleanScore or scNow >= minScoreArm
                if kind == 2
                    float lq = array.get(zLq, i)
                    int touches = array.get(zLqN, i)
                    if dir == -1
                        // Buy-side LQ = equal highs under / into Fresh Zone
                        if high >= prox - atrL * lqTolAtr * 2.0
                            if na(lq)
                                array.set(zLq, i, high)
                                array.set(zLqN, i, 1)
                            else if math.abs(high - lq) <= atrL * lqTolAtr
                                array.set(zLq, i, (lq * touches + high) / (touches + 1.0))
                                array.set(zLqN, i, touches + 1)
                            else if high > lq + atrL * lqTolAtr
                                array.set(zLq, i, high)
                                array.set(zLqN, i, 1)
                        lq := array.get(zLq, i)
                        touches := array.get(zLqN, i)
                        // Refresh score with LQ progress
                        int scLq = f_score_zone(dir, prox, dist, kind, touches)
                        array.set(zScore, i, scLq)
                        if showScoreTag and useCleanScore and not na(array.get(scoreLabs, i))
                            string gL = f_grade(scLq)
                            label.set_text(array.get(scoreLabs, i), gL + " " + str.tostring(scLq) + " · " + f_kind_name(kind))
                        scoreOk := not useCleanScore or scLq >= minScoreArm
                        bool swept = not na(lq) and touches >= minLqTouches and high > lq
                        bool inZn = high >= prox and low <= hiZ
                        bool fallback = (bar_index - array.get(zBirth, i)) >= lqFallbackBars and inZn and touches >= 1
                        if scoreOk and inZn and (swept or fallback)
                            array.set(zArmed, i, 1)
                            armedNow := true
                            armedDir := dir
                            armedProx := prox
                            armedDist := dist
                            armedR := math.abs(dist - prox)
                            armedKind := 2
                            armedScore := scLq
                            lqReady := swept
                    else
                        if low <= prox + atrL * lqTolAtr * 2.0
                            if na(lq)
                                array.set(zLq, i, low)
                                array.set(zLqN, i, 1)
                            else if math.abs(low - lq) <= atrL * lqTolAtr
                                array.set(zLq, i, (lq * touches + low) / (touches + 1.0))
                                array.set(zLqN, i, touches + 1)
                            else if low < lq - atrL * lqTolAtr
                                array.set(zLq, i, low)
                                array.set(zLqN, i, 1)
                        lq := array.get(zLq, i)
                        touches := array.get(zLqN, i)
                        int scLqB = f_score_zone(dir, prox, dist, kind, touches)
                        array.set(zScore, i, scLqB)
                        if showScoreTag and useCleanScore and not na(array.get(scoreLabs, i))
                            label.set_text(array.get(scoreLabs, i), f_grade(scLqB) + " " + str.tostring(scLqB) + " · " + f_kind_name(kind))
                        scoreOk := not useCleanScore or scLqB >= minScoreArm
                        bool sweptB = not na(lq) and touches >= minLqTouches and low < lq
                        bool inZnB = low <= prox and high >= loZ
                        bool fallbackB = (bar_index - array.get(zBirth, i)) >= lqFallbackBars and inZnB and touches >= 1
                        if scoreOk and inZnB and (sweptB or fallbackB)
                            array.set(zArmed, i, 1)
                            armedNow := true
                            armedDir := dir
                            armedProx := prox
                            armedDist := dist
                            armedR := math.abs(dist - prox)
                            armedKind := 2
                            armedScore := scLqB
                            lqReady := sweptB

                    // Draw / refresh LQ line while waiting / arming
                    if showLqLine and not na(array.get(zLq, i))
                        lqBuilding := array.get(zLqN, i) >= 1
                        if array.get(zLqN, i) >= minLqTouches
                            lqReady := true
                        int x0l = array.get(zBirth, i)
                        float lqPx = array.get(zLq, i)
                        line ln = array.get(lqLines, i)
                        if na(ln)
                            array.set(lqLines, i, line.new(x0l, lqPx, bar_index, lqPx, color=lqCol, style=line.style_dashed, width=2))
                            if showLabels
                                array.set(lqLabs, i, label.new(bar_index + 1, lqPx, "LQ", style=label.style_label_left, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny))
                        else
                            line.set_xy1(ln, x0l, lqPx)
                            line.set_xy2(ln, bar_index, lqPx)
                            label lbq = array.get(lqLabs, i)
                            if not na(lbq)
                                label.set_xy(lbq, bar_index + 1, lqPx)
                else if scoreOk
                    bool touched = dir == -1 ? (high >= prox and low <= hiZ) : (low <= prox and high >= loZ)
                    bool atProx = dir == -1 ? high >= prox : low <= prox
                    if touched and atProx
                        array.set(zArmed, i, 1)
                        armedNow := true
                        armedDir := dir
                        armedProx := prox
                        armedDist := dist
                        armedR := math.abs(dist - prox)
                        armedKind := kind
                        armedScore := scNow

            if invalidateThru
                bool blown = dir == -1 ? close > dist : close < dist
                if blown
                    array.set(zDead, i, 1)
                    f_delete_idx(i)

            if array.get(zDead, i) == 0
                box.set_right(array.get(boxes, i), bar_index + 1)
                line.set_x2(array.get(eLines, i), bar_index + extendBars)
                line.set_x2(array.get(sLines, i), bar_index + extendBars)
                if not na(array.get(t1, i))
                    line.set_x2(array.get(t1, i), bar_index + extendBars)
                if not na(array.get(t2, i))
                    line.set_x2(array.get(t2, i), bar_index + extendBars)
                if not na(array.get(t3, i))
                    line.set_x2(array.get(t3, i), bar_index + extendBars)
                if not na(array.get(t5, i))
                    line.set_x2(array.get(t5, i), bar_index + extendBars)

                // Extend / refresh structure TP for Setups 2–5
                if (kind == 1 or kind == 2 or kind == 3 or kind == 4) and showTealTp
                    float tp = f_struct_tp(dir, prox, dist)
                    color tc = kind == 4 ? fsBlueCol : tealCol
                    box.delete(array.get(tealBoxes, i))
                    array.set(tealBoxes, i, box.new(array.get(zBirth, i), math.max(prox, tp), bar_index + extendBars, math.min(prox, tp),
                         border_color=color.new(tc, 40), bgcolor=tc, border_width=1))

                // Extend HTF context + LQ for Setup 3
                if kind == 2
                    box hb = array.get(htfBoxes, i)
                    if not na(hb)
                        box.set_right(hb, bar_index + extendBars)
                    if showLqLine and not na(array.get(zLq, i)) and not na(array.get(lqLines, i))
                        line.set_xy2(array.get(lqLines, i), bar_index, array.get(zLq, i))
                        if not na(array.get(lqLabs, i))
                            label.set_xy(array.get(lqLabs, i), bar_index + 1, array.get(zLq, i))

if not showHistory and nZ > 1
    // keep only newest living zone visually — hide older boxes
    for i = 0 to nZ - 2
        if array.get(zDead, i) == 0
            box.set_bgcolor(array.get(boxes, i), color.new(color.gray, 94))

// Best live clean zone (for panel guidance)
bestScore = -1
bestKind = -1
bestDir = 0
bestProx = float(na)
bestIdx = -1
if nZ > 0
    for i = 0 to nZ - 1
        if array.get(zDead, i) == 0
            int sc = array.get(zScore, i)
            if sc > bestScore
                bestScore := sc
                bestKind := array.get(zKind, i)
                bestDir := array.get(zDir, i)
                bestProx := array.get(zProx, i)
                bestIdx := i

alertcondition(armedNow and armedDir == -1 and (not useCleanScore or armedScore >= minScoreArm), "Supply Short Arm", "TRH-SMM CLEAN SHORT · check score")
alertcondition(armedNow and armedDir == 1 and (not useCleanScore or armedScore >= minScoreArm), "Demand Long Arm", "TRH-SMM CLEAN LONG · check score")
alertcondition(mssBorn and mssSignalShort and not htfBorn, "MSS Fresh Supply", "TRH-SMM Setup2 MSS fresh supply zone")
alertcondition(mssBorn and mssSignalLong and not htfBorn, "MSS Fresh Demand", "TRH-SMM Setup2 MSS fresh demand zone")
alertcondition(htfBorn and mssSignalShort, "Setup3 HTF+LQ Supply", "TRH-SMM Setup3 HTF → Fresh → LQ supply")
alertcondition(htfBorn and mssSignalLong, "Setup3 HTF+LQ Demand", "TRH-SMM Setup3 HTF → Fresh → LQ demand")
alertcondition(armedNow and armedKind == 2 and armedDir == -1, "Setup3 Short Armed", "TRH-SMM Setup3 SHORT armed after LQ")
alertcondition(armedNow and armedKind == 2 and armedDir == 1, "Setup3 Long Armed", "TRH-SMM Setup3 LONG armed after LQ")
alertcondition(bbBorn and bbMssLong, "Setup4 BB+FVG Demand", "TRH-SMM Setup4 Sweep→MSS→BB+FVG demand")
alertcondition(bbBorn and bbMssShort, "Setup4 BB+FVG Supply", "TRH-SMM Setup4 Sweep→MSS→BB+FVG supply")
alertcondition(armedNow and armedKind == 3 and armedDir == 1, "Setup4 Long Armed", "TRH-SMM Setup4 LONG armed in BB+FVG")
alertcondition(armedNow and armedKind == 3 and armedDir == -1, "Setup4 Short Armed", "TRH-SMM Setup4 SHORT armed in BB+FVG")
alertcondition(fsBorn and fsArmedNow and armedDir == 1, "Setup5 fs Long", "TRH-SMM Setup5 fractal sweep LONG")
alertcondition(fsBorn and fsArmedNow and armedDir == -1, "Setup5 fs Short", "TRH-SMM Setup5 fractal sweep SHORT")
alertcondition(armedNow and armedScore >= 80, "Grade A Armed", "TRH-SMM GRADE A — cleanest entry")

if showPanel
    var table pan = table.new(position.top_right, 1, 10, bgcolor=color.new(#111111, 12), border_width=1)
    if barstate.islast
        table.cell(pan, 0, 0, "TRH Clean Score", text_color=color.white, text_size=size.small)
        table.cell(pan, 0, 1, "A≥80 TAKE · B≥70 OK · C weak · D skip", text_color=#B0BEC5, text_size=size.tiny)
        table.cell(pan, 0, 2, "Prefer S4 BB+FVG / S3 HTF+LQ · avoid lone fs", text_color=#B0BEC5, text_size=size.tiny)
        if bestScore >= 0
            string sideB = bestDir == 1 ? "LONG" : "SHORT"
            string gB = f_grade(bestScore)
            string rec = bestScore >= 80 ? "TAKE" : bestScore >= minScoreArm ? "OK / wait arm" : bestScore >= 55 ? "WEAK — skip" : "SKIP"
            color rc = bestScore >= 80 ? #66BB6A : bestScore >= minScoreArm ? #FFD54F : #EF5350
            table.cell(pan, 0, 3, "BEST " + gB + " " + str.tostring(bestScore) + " · " + f_kind_name(bestKind) + " " + sideB, text_color=rc, text_size=size.small)
            table.cell(pan, 0, 4, rec + (not na(bestProx) ? " @ " + str.tostring(bestProx, format.mintick) : ""), text_color=rc, text_size=size.small)
        else
            table.cell(pan, 0, 3, "No live zones", text_color=#78909C, text_size=size.tiny)
            table.cell(pan, 0, 4, "Wait clean setup", text_color=#78909C, text_size=size.tiny)
        if armedNow and not na(armedProx)
            string side = armedDir == 1 ? "LONG" : "SHORT"
            string gA = f_grade(armedScore)
            table.cell(pan, 0, 5, "ARMED " + gA + " " + str.tostring(armedScore) + " · " + f_kind_name(armedKind) + " " + side, text_color=armedScore >= minScoreArm ? #66BB6A : #EF5350, text_size=size.small)
        else
            table.cell(pan, 0, 5, "Not armed — wait return / LQ / score≥" + str.tostring(minScoreArm), text_color=#78909C, text_size=size.tiny)
        table.cell(pan, 0, 6, "Keep≥" + str.tostring(minScoreKeep) + " · Arm≥" + str.tostring(minScoreArm) + " · zones " + str.tostring(array.size(zDir)), text_color=#78909C, text_size=size.tiny)
        string on1 = useSetupMM ? "1" : "-"
        string on2 = useSetupMss ? "2" : "-"
        string on3 = useSetupHtf ? "3" : "-"
        string on4 = useSetupBb ? "4" : "-"
        string on5 = useSetupFs ? "5" : "-"
        table.cell(pan, 0, 7, "Setups " + on1 + on2 + on3 + on4 + on5 + (useCleanScore ? " · score ON" : " · score off"), text_color=#78909C, text_size=size.tiny)
        string tip = "Your SL hits: usually C/D or lone S5-fs — take only A/B"
        table.cell(pan, 0, 8, tip, text_color=#FFAB91, text_size=size.tiny)
        string row9 = bbBorn ? "New S4 BB+FVG" : htfBorn ? "New S3" : mssBorn ? "New S2" : fsBorn ? "New S5 fs" : lqReady ? "LQ ready" : "—"
        table.cell(pan, 0, 9, row9, text_color=#B0BEC5, text_size=size.tiny)

plot(armedNow ? armedProx : na, "Armed E", color=entryCol, display=display.data_window)
plot(armedNow ? armedDist : na, "Armed S", color=slCol, display=display.data_window)
plot(bestScore >= 0 ? bestScore : na, "Best Score", color=#FFD54F, display=display.data_window)
