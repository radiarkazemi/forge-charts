// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | LQ Fractal — setup drawings (like your images), not signal stickers
//
// Visual = Money Management / Position tool style:
//   POI zone (Fresh / BB+FVG) · pink RISK box (E→S) · teal REWARD box (E→TP)
//   tiny E / S tags · LQ line · optional MSS mark
//
// نقدینگی در حال ساخت · fractal stacks · bias 4H+W or D+MN

//@version=6
indicator("TRH | LQ Fractal Setups", shorttitle="TRH-LQ",
     overlay=true, max_boxes_count=150, max_lines_count=200, max_labels_count=120,
     max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpStack = "Fractal Stack"
stack = input.string("1 — 15 — 4H — W", "Active Stack",
     options=["1 — 15 — 4H — W", "5 — 1H — D — MN"], group=grpStack,
     tooltip="Attach on ENTRY TF (1m fast / 5m slow).")
requireBiasAlign = input.bool(true, "Only Setups With Bias", group=grpStack)
biasMode = input.string("Candle + EMA", "Bias Method",
     options=["Candle + EMA", "Close vs Prior", "EMA only"], group=grpStack)

grpModel = "Model"
pivotLen       = input.int(3, "Pivot Length", minval=2, maxval=10, group=grpModel)
mssBodyAtr     = input.float(0.35, "Min MSS Body (ATR×)", step=0.05, group=grpModel)
minZonePts     = input.float(1.50, "Min Zone Height (price)", step=0.1, group=grpModel)
maxZoneAtr     = input.float(2.20, "Max Zone Height (ATR×)", step=0.1, group=grpModel)
lqTolAtr       = input.float(0.12, "Equal Hi/Lo Tol (ATR×)", step=0.01, group=grpModel)
minLqTouches   = input.int(2, "Min Touches For LQ", minval=2, maxval=6, group=grpModel)
requireLqSweep = input.bool(false, "Wait LQ Sweep Before Arming Setup", group=grpModel,
     tooltip="OFF = draw full E/S/TP boxes as soon as Fresh Zone forms (like your images).\nON = only arm after LQ sweep into zone.")
fsPadAtr       = input.float(0.05, "fs Beyond Swing (ATR×)", step=0.01, group=grpModel)
fsMaxAtr       = input.float(0.55, "Max fs Depth (ATR×)", step=0.05, group=grpModel)
cooldownBars   = input.int(15, "Cooldown Bars", minval=1, group=grpModel)
slPadPts       = input.float(0.15, "SL Pad (price)", step=0.05, group=grpModel)
rrTarget       = input.float(3.0, "Reward Multiple (R)", minval=1.0, step=0.5, group=grpModel)
useErlTp       = input.bool(true, "Stretch TP to Yesterday Hi/Lo If Farther", group=grpModel)
setupWidth     = input.int(18, "Setup Box Width (bars)", minval=6, maxval=80, group=grpModel)

grpPath = "Paths"
useFreshZone = input.bool(true, "A — Fresh Zone after MSS", group=grpPath)
useBbFvg     = input.bool(true, "B — BB + FVG", group=grpPath)
useFsCont    = input.bool(true, "C — Internal fs", group=grpPath)

grpDisp = "Display"
showPoi    = input.bool(true, "Show POI Zone", group=grpDisp)
showSetup  = input.bool(true, "Show Risk / Reward Boxes (Position Tool)", group=grpDisp)
showLq     = input.bool(true, "Show LQ Line", group=grpDisp)
showES     = input.bool(true, "Show E / S Tags", group=grpDisp)
showMssTag = input.bool(true, "Show Tiny MSS Tag", group=grpDisp)
showPanel  = input.bool(true, "Panel", group=grpDisp)
maxSetups  = input.int(8, "Keep Last N Setups", minval=1, maxval=20, group=grpDisp)
poiSupCol  = input.color(color.new(#EF9A9A, 72), "POI Supply", group=grpDisp)
poiDemCol  = input.color(color.new(#80CBC4, 72), "POI Demand", group=grpDisp)
riskCol    = input.color(color.new(#EF5350, 72), "Risk Box (SL)", group=grpDisp)
rewardCol  = input.color(color.new(#26A69A, 78), "Reward Box (TP)", group=grpDisp)
lqCol      = input.color(#FFB74D, "LQ", group=grpDisp)
entryCol   = input.color(#66BB6A, "E", group=grpDisp)
slCol      = input.color(#EF5350, "S", group=grpDisp)
mssCol     = input.color(#CE93D8, "MSS", group=grpDisp)

// ═══════════════════════════════════════════════════════════════════════════
// BIAS
// ═══════════════════════════════════════════════════════════════════════════

isFast  = stack == "1 — 15 — 4H — W"
biasTf  = isFast ? "240" : "D"
macroTf = isFast ? "W" : "M"
atr = ta.atr(14)

f_tf_bias(string tf) =>
    float c  = request.security(syminfo.tickerid, tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float o  = request.security(syminfo.tickerid, tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float c1 = request.security(syminfo.tickerid, tf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float ema = request.security(syminfo.tickerid, tf, ta.ema(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    int b = 0
    if biasMode == "Candle + EMA"
        b := (c > o and c > ema) ? 1 : (c < o and c < ema) ? -1 : (c >= c1 ? 1 : -1)
    else if biasMode == "Close vs Prior"
        b := c >= c1 ? 1 : -1
    else
        b := c >= ema ? 1 : -1
    b

biasDir = f_tf_bias(biasTf)
macroBias = f_tf_bias(macroTf)
biasAligned = biasDir == macroBias
biasOkLong  = not requireBiasAlign or (biasDir == 1 and biasAligned)
biasOkShort = not requireBiasAlign or (biasDir == -1 and biasAligned)
dayHi = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dayLo = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// PIVOTS
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float[] swingHi = array.new_float()
var int[]   swingHiBar = array.new_int()
var float[] swingLo = array.new_float()
var int[]   swingLoBar = array.new_int()

if not na(ph)
    array.push(swingHi, ph)
    array.push(swingHiBar, bar_index - pivotLen)
    if array.size(swingHi) > 30
        array.shift(swingHi)
        array.shift(swingHiBar)
if not na(pl)
    array.push(swingLo, pl)
    array.push(swingLoBar, bar_index - pivotLen)
    if array.size(swingLo) > 30
        array.shift(swingLo)
        array.shift(swingLoBar)

lastHi  = array.size(swingHi) > 0 ? array.get(swingHi, array.size(swingHi) - 1) : float(na)
lastLo  = array.size(swingLo) > 0 ? array.get(swingLo, array.size(swingLo) - 1) : float(na)
lastHiB = array.size(swingHiBar) > 0 ? array.get(swingHiBar, array.size(swingHiBar) - 1) : int(na)
lastLoB = array.size(swingLoBar) > 0 ? array.get(swingLoBar, array.size(swingLoBar) - 1) : int(na)

f_eq_hi(float level, float tol) =>
    int n = 0
    int sz = array.size(swingHi)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(swingHi, i) - level) <= tol ? 1 : 0
    n

f_eq_lo(float level, float tol) =>
    int n = 0
    int sz = array.size(swingLo)
    if sz > 0
        for i = 0 to sz - 1
            n += math.abs(array.get(swingLo, i) - level) <= tol ? 1 : 0
    n

f_ob(int dir, int look) =>
    float prox = na
    float dist = na
    int ok = 0
    for k = 1 to look
        if ok == 0
            bool opp = dir == -1 ? close[k] > open[k] : close[k] < open[k]
            if opp
                prox := dir == -1 ? low[k] : high[k]
                dist := dir == -1 ? high[k] : low[k]
                ok := 1
    [prox, dist, ok]

f_zone_ok(float prox, float dist) =>
    float h = math.abs(dist - prox)
    h >= minZonePts and h <= atr * maxZoneAtr and h > syminfo.mintick

f_tp(int dir, float entry, float sl) =>
    float risk = math.abs(entry - sl)
    float tp = dir == 1 ? entry + risk * rrTarget : entry - risk * rrTarget
    if useErlTp
        if dir == 1 and not na(dayHi)
            tp := math.max(tp, dayHi)
        if dir == -1 and not na(dayLo)
            tp := math.min(tp, dayLo)
    tp

// ═══════════════════════════════════════════════════════════════════════════
// SETUP STORE (visual position-tool objects — no signal stickers)
// ═══════════════════════════════════════════════════════════════════════════

var int lastBirth = na

var int[]   sDir = array.new_int()
var int[]   sKind = array.new_int()      // 1 fresh · 2 bb · 3 fs
var int[]   sBirth = array.new_int()
var float[] sProx = array.new_float()
var float[] sDist = array.new_float()
var float[] sEntry = array.new_float()
var float[] sSl = array.new_float()
var float[] sTp = array.new_float()
var int[]   sLeft = array.new_int()
var int[]   sArmed = array.new_int()
var int[]   sDead = array.new_int()
var float[] sLq = array.new_float()

var box[]   poiBoxes = array.new_box()
var box[]   riskBoxes = array.new_box()
var box[]   rewardBoxes = array.new_box()
var line[]  eLines = array.new_line()
var line[]  sLines = array.new_line()
var label[] eLabs = array.new_label()
var label[] sLabs = array.new_label()
var line[]  lqLines = array.new_line()
var label[] lqLabs = array.new_label()

f_can_birth() =>
    na(lastBirth) or (bar_index - lastBirth) >= cooldownBars

f_delete_setup(int i) =>
    if i >= 0 and i < array.size(sDir)
        box.delete(array.get(poiBoxes, i))
        box.delete(array.get(riskBoxes, i))
        box.delete(array.get(rewardBoxes, i))
        line.delete(array.get(eLines, i))
        line.delete(array.get(sLines, i))
        label.delete(array.get(eLabs, i))
        label.delete(array.get(sLabs, i))
        line.delete(array.get(lqLines, i))
        label.delete(array.get(lqLabs, i))

f_shift_oldest() =>
    if array.size(sDir) > 0
        f_delete_setup(0)
        array.shift(sDir)
        array.shift(sKind)
        array.shift(sBirth)
        array.shift(sProx)
        array.shift(sDist)
        array.shift(sEntry)
        array.shift(sSl)
        array.shift(sTp)
        array.shift(sLeft)
        array.shift(sArmed)
        array.shift(sDead)
        array.shift(sLq)
        array.shift(poiBoxes)
        array.shift(riskBoxes)
        array.shift(rewardBoxes)
        array.shift(eLines)
        array.shift(sLines)
        array.shift(eLabs)
        array.shift(sLabs)
        array.shift(lqLines)
        array.shift(lqLabs)

// Create a full visual setup (returns birth bar for lastBirth assign in global scope)
f_make_setup(int dir, int kind, float prox, float dist) =>
    while array.size(sDir) >= maxSetups
        f_shift_oldest()
    int bi = bar_index
    float entry = prox
    float sl = dir == -1 ? dist + slPadPts : dist - slPadPts
    float tp = f_tp(dir, entry, sl)
    int x2 = bi + setupWidth
    color poiC = dir == 1 ? poiDemCol : poiSupCol

    box poi = showPoi ? box.new(bi, math.max(prox, dist), x2, math.min(prox, dist), border_color=color.new(poiC, 35), bgcolor=poiC, border_width=1) : na

    // Position-tool geometry: RISK between entry↔SL, REWARD between entry↔TP
    box risk = na
    box rew = na
    if showSetup
        risk := box.new(bi, math.max(entry, sl), x2, math.min(entry, sl), border_color=color.new(riskCol, 40), bgcolor=riskCol, border_width=1)
        rew := box.new(bi, math.max(entry, tp), x2, math.min(entry, tp), border_color=color.new(rewardCol, 45), bgcolor=rewardCol, border_width=1)

    line el = line.new(bi, entry, x2, entry, color=entryCol, style=line.style_dashed, width=1)
    line sln = line.new(bi, sl, x2, sl, color=slCol, style=line.style_dashed, width=1)
    label elab = showES ? label.new(x2, entry, "E", style=label.style_label_left, color=color.new(entryCol, 100), textcolor=entryCol, size=size.small) : na
    label slab = showES ? label.new(x2, sl, "S", style=label.style_label_left, color=color.new(slCol, 100), textcolor=slCol, size=size.small) : na

    array.push(sDir, dir)
    array.push(sKind, kind)
    array.push(sBirth, bi)
    array.push(sProx, prox)
    array.push(sDist, dist)
    array.push(sEntry, entry)
    array.push(sSl, sl)
    array.push(sTp, tp)
    array.push(sLeft, 0)
    array.push(sArmed, requireLqSweep ? 0 : 1)
    array.push(sDead, 0)
    array.push(sLq, float(na))
    array.push(poiBoxes, poi)
    array.push(riskBoxes, risk)
    array.push(rewardBoxes, rew)
    array.push(eLines, el)
    array.push(sLines, sln)
    array.push(eLabs, elab)
    array.push(sLabs, slab)
    array.push(lqLines, line(na))
    array.push(lqLabs, label(na))
    bi

body = math.abs(close - open)
bearFvg = bar_index >= 2 and low[2] > high and (low[2] - high) >= math.max(atr * 0.15, minZonePts * 0.5)
bullFvg = bar_index >= 2 and high[2] < low and (low - high[2]) >= math.max(atr * 0.15, minZonePts * 0.5)

mssShort = biasOkShort and useFreshZone and not na(lastLo) and not na(lastHi) and not na(lastHiB) and not na(lastLoB) and lastHiB > lastLoB and close < lastLo and body >= atr * mssBodyAtr and close < open
mssLong  = biasOkLong  and useFreshZone and not na(lastHi) and not na(lastLo) and not na(lastHiB) and not na(lastLoB) and lastLoB > lastHiB and close > lastHi and body >= atr * mssBodyAtr and close > open

born = false

// ── Path A: Fresh Zone setup boxes ─────────────────────────────────────────
if mssShort and f_can_birth()
    [p, d, ok] = f_ob(-1, 8)
    if ok == 1 and f_zone_ok(p, d)
        lastBirth := f_make_setup(-1, 1, p, d)
        born := true
        if showMssTag
            label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(mssCol, 55), textcolor=color.white, size=size.tiny)

if mssLong and f_can_birth() and not born
    [p, d, ok] = f_ob(1, 8)
    if ok == 1 and f_zone_ok(p, d)
        lastBirth := f_make_setup(1, 1, p, d)
        born := true
        if showMssTag
            label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(mssCol, 55), textcolor=color.white, size=size.tiny)

// ── Path B: BB + FVG setup boxes ───────────────────────────────────────────
if useBbFvg and biasOkLong and bullFvg and close > open and body >= atr * mssBodyAtr * 0.8 and f_can_birth() and not born
    if not na(lastHi) and close > lastHi
        float prox = low
        float dist = high[2]
        if f_zone_ok(prox, dist)
            lastBirth := f_make_setup(1, 2, prox, dist)
            born := true

if useBbFvg and biasOkShort and bearFvg and close < open and body >= atr * mssBodyAtr * 0.8 and f_can_birth() and not born
    if not na(lastLo) and close < lastLo
        float prox = high
        float dist = low[2]
        if f_zone_ok(prox, dist)
            lastBirth := f_make_setup(-1, 2, prox, dist)
            born := true

// ── Path C: fs — draw setup at sweep reclaim (position boxes, not sticker) ─
if useFsCont and f_can_birth() and not born
    if biasOkLong and not na(lastLo)
        float depth = lastLo - low
        bool sweptFs = low < lastLo - atr * fsPadAtr and depth > 0 and depth <= atr * fsMaxAtr
        bool reclaim = close > lastLo and close > open
        if sweptFs and reclaim
            float prox = close
            float dist = low - slPadPts
            if f_zone_ok(prox, dist) or math.abs(prox - dist) >= minZonePts * 0.5
                // fs: entry near reclaim, SL under sweep low
                lastBirth := f_make_setup(1, 3, prox, dist)
                born := true
                if showLq
                    line.new(bar_index - 6, lastLo, bar_index + setupWidth, lastLo, color=color.new(lqCol, 35), style=line.style_dotted, width=1)
                    label.new(bar_index, lastLo, "fs", style=label.style_label_right, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)

    if biasOkShort and not na(lastHi) and not born
        float depth = high - lastHi
        bool sweptFs = high > lastHi + atr * fsPadAtr and depth > 0 and depth <= atr * fsMaxAtr
        bool reject = close < lastHi and close < open
        if sweptFs and reject
            float prox = close
            float dist = high + slPadPts
            if f_zone_ok(prox, dist) or math.abs(prox - dist) >= minZonePts * 0.5
                lastBirth := f_make_setup(-1, 3, prox, dist)
                born := true
                if showLq
                    line.new(bar_index - 6, lastHi, bar_index + setupWidth, lastHi, color=color.new(lqCol, 35), style=line.style_dotted, width=1)
                    label.new(bar_index, lastHi, "fs", style=label.style_label_right, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// EXTEND / LQ / INVALIDATE live setups
// ═══════════════════════════════════════════════════════════════════════════

nS = array.size(sDir)
armedNow = false
armedDir = 0

if nS > 0
    for i = 0 to nS - 1
        if array.get(sDead, i) == 0
            int dir = array.get(sDir, i)
            float prox = array.get(sProx, i)
            float dist = array.get(sDist, i)
            float entry = array.get(sEntry, i)
            float sl = array.get(sSl, i)
            float tp = array.get(sTp, i)
            float loZ = math.min(prox, dist)
            float hiZ = math.max(prox, dist)
            int bi = array.get(sBirth, i)
            int x2 = math.max(bar_index + 1, bi + setupWidth)

            // Extend all boxes/lines like a live position tool
            box poi = array.get(poiBoxes, i)
            box risk = array.get(riskBoxes, i)
            box rew = array.get(rewardBoxes, i)
            if not na(poi)
                box.set_right(poi, x2)
            if not na(risk)
                box.set_right(risk, x2)
            if not na(rew)
                box.set_right(rew, x2)
            line.set_x2(array.get(eLines, i), x2)
            line.set_x2(array.get(sLines, i), x2)
            if showES
                label labE = array.get(eLabs, i)
                label labS = array.get(sLabs, i)
                if not na(labE)
                    label.set_x(labE, x2)
                if not na(labS)
                    label.set_x(labS, x2)

            if array.get(sLeft, i) == 0
                if (dir == -1 and close < loZ) or (dir == 1 and close > hiZ)
                    array.set(sLeft, i, 1)

            // LQ under construction
            float tol = atr * lqTolAtr
            if array.get(sLeft, i) == 1 and array.get(sArmed, i) == 0
                if dir == -1 and not na(lastHi) and lastHi < loZ and f_eq_hi(lastHi, tol) >= minLqTouches
                    array.set(sLq, i, lastHi)
                    if showLq
                        line.delete(array.get(lqLines, i))
                        label.delete(array.get(lqLabs, i))
                        array.set(lqLines, i, line.new(bi, lastHi, x2, lastHi, color=color.new(lqCol, 30), style=line.style_dotted, width=1))
                        array.set(lqLabs, i, label.new(x2, lastHi, "LQ", style=label.style_label_left, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny))
                if dir == 1 and not na(lastLo) and lastLo > hiZ and f_eq_lo(lastLo, tol) >= minLqTouches
                    array.set(sLq, i, lastLo)
                    if showLq
                        line.delete(array.get(lqLines, i))
                        label.delete(array.get(lqLabs, i))
                        array.set(lqLines, i, line.new(bi, lastLo, x2, lastLo, color=color.new(lqCol, 30), style=line.style_dotted, width=1))
                        array.set(lqLabs, i, label.new(x2, lastLo, "LQ", style=label.style_label_left, color=color.new(lqCol, 100), textcolor=lqCol, size=size.tiny))

            // Arm highlight (optional wait for LQ)
            if requireLqSweep and array.get(sLeft, i) == 1 and array.get(sArmed, i) == 0
                float lq = array.get(sLq, i)
                bool atProx = dir == -1 ? high >= prox : low <= prox
                bool swept = na(lq) ? (bar_index - bi) >= pivotLen * 4 : (dir == -1 ? high >= lq : low <= lq)
                if atProx and swept
                    array.set(sArmed, i, 1)
                    armedNow := true
                    armedDir := dir
                    // Emphasize risk/reward when armed
                    if not na(risk)
                        box.set_bgcolor(risk, color.new(riskCol, 60))
                    if not na(rew)
                        box.set_bgcolor(rew, color.new(rewardCol, 65))

            // Invalidate: close through distal / SL
            bool blown = dir == -1 ? close > sl : close < sl
            bool tpHit = dir == -1 ? low <= tp : high >= tp
            if blown or tpHit
                array.set(sDead, i, 1)
                // Freeze right edge at this bar (keep history like your screenshots)
                if not na(poi)
                    box.set_right(poi, bar_index)
                if not na(risk)
                    box.set_right(risk, bar_index)
                if not na(rew)
                    box.set_right(rew, bar_index)
                line.set_x2(array.get(eLines, i), bar_index)
                line.set_x2(array.get(sLines, i), bar_index)

// ═══════════════════════════════════════════════════════════════════════════
// PANEL + ALERTS (no chart signal stickers)
// ═══════════════════════════════════════════════════════════════════════════

alertcondition(born and mssShort, "Fresh Supply Setup", "TRH-LQ fresh supply setup drawn")
alertcondition(born and mssLong, "Fresh Demand Setup", "TRH-LQ fresh demand setup drawn")
alertcondition(armedNow and armedDir == -1, "Short Armed", "TRH-LQ short setup armed (LQ collect)")
alertcondition(armedNow and armedDir == 1, "Long Armed", "TRH-LQ long setup armed (LQ collect)")

if showPanel
    var table pan = table.new(position.top_right, 1, 6, bgcolor=color.new(#0D1117, 10), border_width=1)
    if barstate.islast
        string biasTxt = biasDir == 1 ? "BUYER" : "SELLER"
        color biasC = biasDir == 1 ? #26A69A : #EF5350
        int live = 0
        if array.size(sDead) > 0
            for j = 0 to array.size(sDead) - 1
                live += array.get(sDead, j) == 0 ? 1 : 0
        table.cell(pan, 0, 0, "TRH LQ Setups", text_color=color.white, text_size=size.small)
        table.cell(pan, 0, 1, stack, text_color=#90A4AE, text_size=size.tiny)
        table.cell(pan, 0, 2, "Bias " + biasTxt, text_color=biasC, text_size=size.small)
        table.cell(pan, 0, 3, "نقدینگی در حال ساخت", text_color=lqCol, text_size=size.tiny)
        table.cell(pan, 0, 4, "Live setups: " + str.tostring(live), text_color=#B0BEC5, text_size=size.tiny)
        table.cell(pan, 0, 5, "POI + Risk/Reward boxes", text_color=#78909C, text_size=size.tiny)
