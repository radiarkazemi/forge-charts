// compile real Pine.

//@version=6
indicator("Sessions [LuxAlgo]", "LuxAlgo - Sessions", overlay = true, max_bars_back = 500, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// Full script body lives in the Forge Sessions runtime:
//   src/features/sessions/runtime.ts
//   src/features/chart/sessions-indicator.ts
//
// Defaults: New York 1300-2200, London 0700-1600, Tokyo 0000-0900, Sydney 2100-0600 (UTC).
