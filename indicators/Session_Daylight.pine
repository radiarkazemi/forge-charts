//@version=6
indicator("Session Daylight Box", shorttitle="Sessions", overlay=true)

// Tiny corner box only — no chart bands.

tz = input.string("America/New_York", "Timezone",
     options=["America/New_York", "Europe/London", "Asia/Tokyo", "UTC", "Exchange"],
     group="Clock")
useExchange = tz == "Exchange"

asiaSess = input.session("1900-0000", "Asia", group="Hours")
lonSess  = input.session("0300-1200", "London", group="Hours")
nySess   = input.session("0800-1700", "New York", group="Hours")
dayBegin = input.int(0, "Day begin hour", minval=0, maxval=23, group="Hours")
dayEnd   = input.int(23, "Day end hour", minval=0, maxval=23, group="Hours")

boxPos = input.string("Bottom right", "Box corner",
     options=["Bottom right", "Bottom left", "Top right", "Top left"], group="Look")

f_tz() =>
    useExchange ? syminfo.timezone : tz

f_in(sess) =>
    not na(time(timeframe.period, sess, f_tz()))

inAsia   = f_in(asiaSess)
inLondon = f_in(lonSess)
inNY     = f_in(nySess)
inOvl    = inLondon and inNY

sessName =
     inOvl ? "LN/NY" :
     inNY ? "NEW YORK" :
     inLondon ? "LONDON" :
     inAsia ? "ASIA" : "OFF"

accent =
     inOvl ? #A78BFA :
     inNY ? #46C39B :
     inLondon ? #E0B44E :
     inAsia ? #5B8DEF : #9AA6B5

pos =
     boxPos == "Bottom left" ? position.bottom_left :
     boxPos == "Top right" ? position.top_right :
     boxPos == "Top left" ? position.top_left :
     position.bottom_right

var string lastPos = na
var table box = na

if barstate.islast
    if na(box) or lastPos != boxPos
        if not na(box)
            table.delete(box)
        box := table.new(pos, 2, 4, bgcolor=color.new(#0B0E12, 12), border_width=1, border_color=color.new(#2A3340, 35), frame_width=0)
        lastPos := boxPos

    clock = str.format_time(time, "HH:mm", f_tz())
    dayB = (dayBegin < 10 ? "0" : "") + str.tostring(dayBegin) + ":00"
    dayE = (dayEnd < 10 ? "0" : "") + str.tostring(dayEnd) + ":59"
    muted = #9AA6B5
    bright = #E8EEF5

    table.cell(box, 0, 0, "SESSION", text_color=muted, text_size=size.tiny, text_halign=text.align_left)
    table.cell(box, 1, 0, sessName, text_color=accent, text_size=size.small, text_halign=text.align_right)
    table.cell(box, 0, 1, "CLOCK", text_color=muted, text_size=size.tiny, text_halign=text.align_left)
    table.cell(box, 1, 1, clock, text_color=bright, text_size=size.small, text_halign=text.align_right)
    table.cell(box, 0, 2, "DAY IN", text_color=muted, text_size=size.tiny, text_halign=text.align_left)
    table.cell(box, 1, 2, dayB, text_color=bright, text_size=size.small, text_halign=text.align_right)
    table.cell(box, 0, 3, "DAY OUT", text_color=muted, text_size=size.tiny, text_halign=text.align_left)
    table.cell(box, 1, 3, dayE, text_color=bright, text_size=size.small, text_halign=text.align_right)
