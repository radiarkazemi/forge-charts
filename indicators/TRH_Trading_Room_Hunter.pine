// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | Trading Room Hunter — quality rooms only, exact ENTRY / SL / TP

//@version=5
indicator("TRH | Trading Room Hunter", shorttitle="TRH", overlay=true, max_boxes_count=50, max_lines_count=100, max_labels_count=100, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — defaults tuned to cut 1m gold noise and hunt sample-style rooms
// ═══════════════════════════════════════════════════════════════════════════

grpCore = "TRH Core"
pivotPeriod     = input.int(8, "Pivot Period", minval=3, maxval=50, group=grpCore,
     tooltip="Higher = fewer major green/red pivots. 8 works well on XAUUSD 1m.")
minImpulseAtr   = input.float(2.0, "Min Impulse Size (ATR×)", minval=0.8, maxval=10.0, step=0.1, group=grpCore,
     tooltip="Impulse that creates the room must travel at least this many ATRs.")
minImpulseBars  = input.int(3, "Min Impulse Bars", minval=2, maxval=20, group=grpCore)
cooldownBars    = input.int(40, "Cooldown Between Setups (bars)", minval=5, maxval=300, group=grpCore)
requireLeave    = input.bool(true, "Require Leave-Zone Before Entry", group=grpCore,
     tooltip="Classic TRH: price must leave the room, then return. Cuts same-bar noise fills.")

grpSweep = "Liquidity Sweep Hunt (04:19 style)"
enableSweepHunt = input.bool(true, "Enable Sweep Hunt", group=grpSweep)
minSweepAtr     = input.float(0.15, "Min Sweep Beyond Pivot (ATR×)", minval=0.0, maxval=2.0, step=0.05, group=grpSweep)
minContextAtr   = input.float(1.5, "Min Prior Opposing Move (ATR×)", minval=0.5, maxval=10.0, step=0.1, group=grpSweep,
     tooltip="Before a bullish sweep, require a prior selloff of this size (and vice versa).")
sweepPivotBars  = input.int(30, "Sweep Pivot Memory (bars)", minval=10, maxval=200, group=grpSweep)

grpPos = "Position Management"
useSlThreshold = input.bool(true, "Stop-Loss Threshold", group=grpPos)
slThreshold    = input.float(0.25, "SL Threshold (ATR×)", minval=0.0, maxval=3.0, step=0.05, group=grpPos)
riskReward     = input.float(2.0, "Risk-Reward Ratio", minval=0.5, maxval=10.0, step=0.1, group=grpPos)
minRiskAtr     = input.float(0.8, "Min Risk Size (ATR×)", minval=0.2, maxval=5.0, step=0.1, group=grpPos,
     tooltip="Reject tiny rooms (the 2–3 point noise trades).")
maxZoneAtr     = input.float(2.5, "Max Zone Width (ATR×)", minval=0.5, maxval=10.0, step=0.1, group=grpPos)
entryMode      = input.string("Mid Zone", "Entry Level", options=["Proximal", "Mid Zone"], group=grpPos,
     tooltip="Mid Zone ≈ sample 04:19 entry style. Proximal = edge of room (Set & Forget).")

grpDisp = "Display"
showEntryLvls  = input.bool(true, "Show Entry / SL / TP Labels", group=grpDisp)
onlyLastPos    = input.bool(true, "Only Display the Last Position", group=grpDisp)
setupWidthBars = input.int(60, "Setup Width (bars)", minval=10, maxval=400, group=grpDisp)
showPivots     = input.bool(true, "Show Major Pivot Circles", group=grpDisp)
showInternal   = input.bool(false, "Show Intermediate (Orange) Pivots", group=grpDisp)
maxSetupsKeep  = input.int(3, "Max Historical Setups", minval=1, maxval=15, group=grpDisp)
hideMarkers    = input.bool(true, "Hide ▶ ENTRY / TP / SL text spam", group=grpDisp,
     tooltip="Keeps chart clean; levels still show on lines + table.")

grpCol = "Colors"
bullZoneCol  = input.color(color.new(#2196F3, 78), "Bullish TRH Zone", group=grpCol)
bearZoneCol  = input.color(color.new(#E53935, 78), "Bearish TRH Zone", group=grpCol)
entryCol     = input.color(#212121, "Entry Line", group=grpCol)
slCol        = input.color(#E53935, "Stop-Loss Line", group=grpCol)
tpCol        = input.color(#43A047, "Take-Profit Line", group=grpCol)
bullPivotCol = input.color(#43A047, "Green Pivot (Lows)", group=grpCol)
bearPivotCol = input.color(#E53935, "Red Pivot (Highs)", group=grpCol)
midPivotCol  = input.color(#FF9800, "Orange Pivot", group=grpCol)

grpAlert = "Alerts"
alertOnZone  = input.bool(true, "Alert on new TRH zone", group=grpAlert)
alertOnEntry = input.bool(true, "Alert on entry fill", group=grpAlert)
alertOnExit  = input.bool(true, "Alert on SL / TP", group=grpAlert)

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(14)

f_levels(dir, proximal, distal) =>
    entry = entryMode == "Proximal" ? proximal : (proximal + distal) * 0.5
    pad = useSlThreshold ? atr * slThreshold : syminfo.mintick * 2.0
    sl = dir == 1 ? distal - pad : distal + pad
    risk = math.abs(entry - sl)
    tp = dir == 1 ? entry + risk * riskReward : entry - risk * riskReward
    [entry, sl, tp, risk]

f_validRoom(dir, proximal, distal) =>
    top = math.max(proximal, distal)
    bot = math.min(proximal, distal)
    w = top - bot
    [entry, sl, tp, risk] = f_levels(dir, proximal, distal)
    sideOk = dir == 1 ? distal < proximal : distal > proximal
    sideOk and w > syminfo.mintick and w <= atr * maxZoneAtr and risk >= atr * minRiskAtr

// ═══════════════════════════════════════════════════════════════════════════
// MAJOR PIVOTS ONLY (green / red) — memory of hunt levels
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float lastMajorHigh = na
var float lastMajorLow = na
var int lastMajorHighBar = na
var int lastMajorLowBar = na
var float[] pivotHighs = array.new<float>()
var int[] pivotHighBars = array.new<int>()
var float[] pivotLows = array.new<float>()
var int[] pivotLowBars = array.new<int>()

f_pushPivot(pv, pb, price, b) =>
    array.push(pv, price)
    array.push(pb, b)
    while array.size(pv) > 20
        array.shift(pv)
        array.shift(pb)

if not na(ph)
    lastMajorHigh := ph
    lastMajorHighBar := bar_index - pivotPeriod
    f_pushPivot(pivotHighs, pivotHighBars, ph, bar_index - pivotPeriod)

if not na(pl)
    lastMajorLow := pl
    lastMajorLowBar := bar_index - pivotPeriod
    f_pushPivot(pivotLows, pivotLowBars, pl, bar_index - pivotPeriod)

plotshape(showPivots and not na(pl) ? pl : na, title="Major Low", style=shape.circle, location=location.absolute, color=bullPivotCol, size=size.small, offset=-pivotPeriod)
plotshape(showPivots and not na(ph) ? ph : na, title="Major High", style=shape.circle, location=location.absolute, color=bearPivotCol, size=size.small, offset=-pivotPeriod)

halfLen = math.max(3, int(pivotPeriod / 2))
intPh = ta.pivothigh(high, halfLen, halfLen)
intPl = ta.pivotlow(low, halfLen, halfLen)
plotshape(showInternal and not na(intPl) ? intPl : na, title="Internal Low", style=shape.circle, location=location.absolute, color=midPivotCol, size=size.tiny, offset=-halfLen)
plotshape(showInternal and not na(intPh) ? intPh : na, title="Internal High", style=shape.circle, location=location.absolute, color=midPivotCol, size=size.tiny, offset=-halfLen)

// Nearest major pivot low/high still “alive” within memory window
f_nearestLow(maxAge) =>
    float best = na
    int bestBar = na
    if array.size(pivotLows) > 0
        for i = 0 to array.size(pivotLows) - 1
            b = array.get(pivotLowBars, i)
            px = array.get(pivotLows, i)
            if bar_index - b <= maxAge and bar_index - b >= pivotPeriod
                if na(best) or px < best
                    best := px
                    bestBar := b
    [best, bestBar]

f_nearestHigh(maxAge) =>
    float best = na
    int bestBar = na
    if array.size(pivotHighs) > 0
        for i = 0 to array.size(pivotHighs) - 1
            b = array.get(pivotHighBars, i)
            px = array.get(pivotHighs, i)
            if bar_index - b <= maxAge and bar_index - b >= pivotPeriod
                if na(best) or px > best
                    best := px
                    bestBar := b
    [best, bestBar]

// ═══════════════════════════════════════════════════════════════════════════
// 1) CLASSIC TRH — strong impulse creates room, wait for retest
// ═══════════════════════════════════════════════════════════════════════════

impulseLook = minImpulseBars + 2
bullImpulseRange = close - ta.lowest(low, impulseLook)
bearImpulseRange = ta.highest(high, impulseLook) - close
bullImpulse = close > open and bullImpulseRange >= atr * minImpulseAtr and close > ta.highest(high[1], pivotPeriod)
bearImpulse = close < open and bearImpulseRange >= atr * minImpulseAtr and close < ta.lowest(low[1], pivotPeriod)

// Origin for bullish impulse = lowest low over the base preceding the run
bullOrigin = ta.lowest(low, impulseLook + pivotPeriod)
bearOrigin = ta.highest(high, impulseLook + pivotPeriod)

// ═══════════════════════════════════════════════════════════════════════════
// 2) SWEEP HUNT — sweep a stored major pivot after opposing context
// ═══════════════════════════════════════════════════════════════════════════

[memLow, memLowBar] = f_nearestLow(sweepPivotBars)
[memHigh, memHighBar] = f_nearestHigh(sweepPivotBars)

// Prior opposing move: selloff into a bullish sweep / rally into a bearish sweep
priorSelloff = ta.highest(high, sweepPivotBars) - low
priorRally = high - ta.lowest(low, sweepPivotBars)

bullSweep = enableSweepHunt and not na(memLow) and low < memLow - atr * minSweepAtr and close > memLow and close > open and priorSelloff >= atr * minContextAtr
bearSweep = enableSweepHunt and not na(memHigh) and high > memHigh + atr * minSweepAtr and close < memHigh and close < open and priorRally >= atr * minContextAtr

// ═══════════════════════════════════════════════════════════════════════════
// CANDIDATE SELECTION (one setup at a time, cooldown gated)
// ═══════════════════════════════════════════════════════════════════════════

var int lastZoneBar = na

int newDir = 0
float newProx = na
float newDist = na
bool newFromSweep = false

cooldownOk = na(lastZoneBar) or bar_index - lastZoneBar >= cooldownBars

if barstate.isconfirmed and cooldownOk
    // Sweep hunt first — matches 04:19 sample better (enter the room after stop raid)
    if bullSweep
        newDist := low
        newProx := memLow
        if f_validRoom(1, newProx, newDist)
            newDir := 1
            newFromSweep := true
    else if bearSweep
        newDist := high
        newProx := memHigh
        if f_validRoom(-1, newProx, newDist)
            newDir := -1
            newFromSweep := true
    // Classic impulse room
    else if bullImpulse
        newDist := bullOrigin
        newProx := math.min(open, close)  // proximal edge of break / impulse candle
        // Prefer last major low if it sits under the impulse
        if not na(lastMajorLow) and lastMajorLow <= newProx and bar_index - nz(lastMajorLowBar) <= sweepPivotBars
            newDist := math.min(newDist, lastMajorLow)
        if f_validRoom(1, newProx, newDist)
            newDir := 1
            newFromSweep := false
    else if bearImpulse
        newDist := bearOrigin
        newProx := math.max(open, close)
        if not na(lastMajorHigh) and lastMajorHigh >= newProx and bar_index - nz(lastMajorHighBar) <= sweepPivotBars
            newDist := math.max(newDist, lastMajorHigh)
        if f_validRoom(-1, newProx, newDist)
            newDir := -1
            newFromSweep := false

// ═══════════════════════════════════════════════════════════════════════════
// STATE + DRAWINGS
// status: 0=wait leave, 1=armed (left zone), 2=in trade, 3=tp, 4=sl, 5=expired
// ═══════════════════════════════════════════════════════════════════════════

var box[] zoneBoxes = array.new<box>()
var line[] entryLines = array.new<line>()
var line[] slLines = array.new<line>()
var line[] tpLines = array.new<line>()
var label[] entryLabels = array.new<label>()
var label[] slLabels = array.new<label>()
var label[] tpLabels = array.new<label>()
var label[] tagLabels = array.new<label>()

var int[] sDir = array.new<int>()
var float[] sEntry = array.new<float>()
var float[] sSl = array.new<float>()
var float[] sTp = array.new<float>()
var float[] sProx = array.new<float>()
var float[] sDist = array.new<float>()
var int[] sStartBar = array.new<int>()
var int[] sStatus = array.new<int>()
var bool[] sLeft = array.new<bool>()
var bool[] sIsSweep = array.new<bool>()
var bool[] sAlertedIn = array.new<bool>()

var float activeEntry = na
var float activeSl = na
var float activeTp = na
var int signalDir = 0
signalDir := 0

if newDir != 0 and not na(newProx) and not na(newDist)
    if onlyLastPos and array.size(sDir) > 0
        for i = 0 to array.size(zoneBoxes) - 1
            box.delete(array.get(zoneBoxes, i))
            line.delete(array.get(entryLines, i))
            line.delete(array.get(slLines, i))
            line.delete(array.get(tpLines, i))
            label.delete(array.get(entryLabels, i))
            label.delete(array.get(slLabels, i))
            label.delete(array.get(tpLabels, i))
            label.delete(array.get(tagLabels, i))
        array.clear(zoneBoxes)
        array.clear(entryLines)
        array.clear(slLines)
        array.clear(tpLines)
        array.clear(entryLabels)
        array.clear(slLabels)
        array.clear(tpLabels)
        array.clear(tagLabels)
        array.clear(sDir)
        array.clear(sEntry)
        array.clear(sSl)
        array.clear(sTp)
        array.clear(sProx)
        array.clear(sDist)
        array.clear(sStartBar)
        array.clear(sStatus)
        array.clear(sLeft)
        array.clear(sIsSweep)
        array.clear(sAlertedIn)

    [entry, sl, tp, risk] = f_levels(newDir, newProx, newDist)
    zoneTop = math.max(newProx, newDist)
    zoneBot = math.min(newProx, newDist)
    rightBar = bar_index + setupWidthBars
    zcol = newDir == 1 ? bullZoneCol : bearZoneCol

    array.push(zoneBoxes, box.new(bar_index, zoneTop, rightBar, zoneBot, bgcolor=zcol, border_color=color.new(zcol, 25), border_width=1))
    array.push(entryLines, line.new(bar_index, entry, rightBar, entry, color=entryCol, width=2))
    array.push(slLines, line.new(bar_index, sl, rightBar, sl, color=slCol, style=line.style_dashed, width=2))
    array.push(tpLines, line.new(bar_index, tp, rightBar, tp, color=tpCol, style=line.style_dashed, width=2))

    eTxt = showEntryLvls ? "ENTRY " + str.tostring(entry, format.mintick) : ""
    sTxt = showEntryLvls ? "SL " + str.tostring(sl, format.mintick) : ""
    tTxt = showEntryLvls ? "TP " + str.tostring(tp, format.mintick) : ""
    array.push(entryLabels, label.new(rightBar, entry, eTxt, style=label.style_label_left, color=showEntryLvls ? entryCol : color.new(entryCol, 100), textcolor=color.white, size=size.small))
    array.push(slLabels, label.new(rightBar, sl, sTxt, style=label.style_label_left, color=showEntryLvls ? slCol : color.new(slCol, 100), textcolor=color.white, size=size.small))
    array.push(tpLabels, label.new(rightBar, tp, tTxt, style=label.style_label_left, color=showEntryLvls ? tpCol : color.new(tpCol, 100), textcolor=color.white, size=size.small))

    side = newDir == 1 ? "LONG" : "SHORT"
    kind = newFromSweep ? "SWEEP" : "IMPULSE"
    array.push(tagLabels, label.new(bar_index, newDir == 1 ? zoneTop : zoneBot, "TRH " + side + " · " + kind + "\nR:R " + str.tostring(riskReward, "#.##"), style=newDir == 1 ? label.style_label_down : label.style_label_up, color=newDir == 1 ? #1565C0 : #B71C1C, textcolor=color.white, size=size.small))

    // Sweep rooms: price is already in the zone → arm immediately if requireLeave is off,
    // otherwise still require a leave+return (can miss same-base entries). For sweep mode
    // we arm as "already left opposing liquidity" and allow entry on next touch of ENTRY.
    initStatus = 0
    initLeft = false
    if newFromSweep
        // Sweep reclaim: allow entry once price trades at/through entry without needing a leave cycle
        initStatus := requireLeave ? 1 : 1
        initLeft := true

    array.push(sDir, newDir)
    array.push(sEntry, entry)
    array.push(sSl, sl)
    array.push(sTp, tp)
    array.push(sProx, newProx)
    array.push(sDist, newDist)
    array.push(sStartBar, bar_index)
    array.push(sStatus, initStatus)
    array.push(sLeft, initLeft)
    array.push(sIsSweep, newFromSweep)
    array.push(sAlertedIn, false)

    lastZoneBar := bar_index

    while array.size(sDir) > maxSetupsKeep
        box.delete(array.shift(zoneBoxes))
        line.delete(array.shift(entryLines))
        line.delete(array.shift(slLines))
        line.delete(array.shift(tpLines))
        label.delete(array.shift(entryLabels))
        label.delete(array.shift(slLabels))
        label.delete(array.shift(tpLabels))
        label.delete(array.shift(tagLabels))
        array.shift(sDir)
        array.shift(sEntry)
        array.shift(sSl)
        array.shift(sTp)
        array.shift(sProx)
        array.shift(sDist)
        array.shift(sStartBar)
        array.shift(sStatus)
        array.shift(sLeft)
        array.shift(sIsSweep)
        array.shift(sAlertedIn)

    if alertOnZone
        alert("TRH " + side + " " + kind + " | ENTRY " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// Manage
n = array.size(sDir)
if n > 0
    for i = 0 to n - 1
        st = array.get(sStatus, i)
        if st <= 2
            dir = array.get(sDir, i)
            entry = array.get(sEntry, i)
            sl = array.get(sSl, i)
            tp = array.get(sTp, i)
            prox = array.get(sProx, i)
            dist = array.get(sDist, i)
            startB = array.get(sStartBar, i)
            left = array.get(sLeft, i)
            isSweep = array.get(sIsSweep, i)
            zoneTop = math.max(prox, dist)
            zoneBot = math.min(prox, dist)
            rightB = math.max(bar_index, startB + setupWidthBars)

            box.set_right(array.get(zoneBoxes, i), rightB)
            line.set_x2(array.get(entryLines, i), rightB)
            line.set_x2(array.get(slLines, i), rightB)
            line.set_x2(array.get(tpLines, i), rightB)
            label.set_x(array.get(entryLabels, i), rightB)
            label.set_x(array.get(slLabels, i), rightB)
            label.set_x(array.get(tpLabels, i), rightB)

            // Expire stale waiting setups
            if st < 2 and bar_index - startB > setupWidthBars * 2
                array.set(sStatus, i, 5)
                box.set_bgcolor(array.get(zoneBoxes, i), color.new(color.gray, 88))
            else
                // Impulse rooms: must fully leave zone first
                if st == 0 and not isSweep
                    away = dir == 1 ? low > zoneTop : high < zoneBot
                    if away or not requireLeave
                        array.set(sLeft, i, true)
                        array.set(sStatus, i, 1)

                // Armed → entry when price revisits ENTRY / zone
                if array.get(sStatus, i) == 1
                    // Fill when price tags entry (wick allowed)
                    tagged = dir == 1 ? low <= entry and high >= entry : high >= entry and low <= entry
                    // Also accept full zone revisit
                    revisited = low <= zoneTop and high >= zoneBot
                    if tagged or revisited
                        array.set(sStatus, i, 2)
                        signalDir := dir
                        activeEntry := entry
                        activeSl := sl
                        activeTp := tp
                        if not array.get(sAlertedIn, i)
                            array.set(sAlertedIn, i, true)
                            if not hideMarkers
                                label.new(bar_index, entry, "▶ ENTRY", style=label.style_label_center, color=dir == 1 ? #1565C0 : #B71C1C, textcolor=color.white, size=size.normal)
                            if alertOnEntry
                                alert("TRH ENTRY " + (dir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(entry, format.mintick), alert.freq_once_per_bar_close)

                // In trade → exits (TP preferred if both wick)
                if array.get(sStatus, i) == 2
                    hitTp = dir == 1 ? high >= tp : low <= tp
                    hitSl = dir == 1 ? low <= sl : high >= sl
                    if hitTp
                        array.set(sStatus, i, 3)
                        box.set_bgcolor(array.get(zoneBoxes, i), color.new(#43A047, 70))
                        if not hideMarkers
                            label.new(bar_index, tp, "✓ TP EXIT", style=label.style_label_center, color=#43A047, textcolor=color.white, size=size.normal)
                        if alertOnExit
                            alert("TRH TP @ " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
                    else if hitSl
                        array.set(sStatus, i, 4)
                        box.set_bgcolor(array.get(zoneBoxes, i), color.new(#E53935, 70))
                        if not hideMarkers
                            label.new(bar_index, sl, "✗ SL EXIT", style=label.style_label_center, color=#E53935, textcolor=color.white, size=size.normal)
                        if alertOnExit
                            alert("TRH SL @ " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)

plotshape(signalDir == 1, title="Buy", style=shape.triangleup, location=location.belowbar, color=#43A047, size=size.tiny)
plotshape(signalDir == -1, title="Sell", style=shape.triangledown, location=location.abovebar, color=#E53935, size=size.tiny)

plot(activeEntry, "Active Entry", color=entryCol, display=display.data_window)
plot(activeSl, "Active SL", color=slCol, display=display.data_window)
plot(activeTp, "Active TP", color=tpCol, display=display.data_window)

var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(#111111, 8), border_width=1, border_color=color.new(color.white, 70))

if barstate.islast
    if array.size(sDir) > 0
        idx = array.size(sDir) - 1
        found = false
        for j = array.size(sDir) - 1 to 0
            if not found and array.get(sStatus, j) <= 2
                idx := j
                found := true
        dir = array.get(sDir, idx)
        st = array.get(sStatus, idx)
        stTxt = st == 0 ? "WAIT LEAVE" : st == 1 ? "ARMED" : st == 2 ? "IN TRADE" : st == 3 ? "TP HIT" : st == 4 ? "SL HIT" : "EXPIRED"
        e = array.get(sEntry, idx)
        s = array.get(sSl, idx)
        t = array.get(sTp, idx)
        kind = array.get(sIsSweep, idx) ? "SWEEP" : "IMPULSE"
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, (dir == 1 ? "LONG" : "SHORT") + " · " + stTxt, text_color=dir == 1 ? #81C784 : #E57373, text_size=size.small)
        table.cell(info, 0, 1, "Type", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, kind, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, str.tostring(e, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "SL", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, str.tostring(s, format.mintick), text_color=#EF9A9A, text_size=size.small)
        table.cell(info, 0, 4, "TP", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, str.tostring(t, format.mintick), text_color=#A5D6A7, text_size=size.small)
        table.cell(info, 0, 5, "Risk", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, str.tostring(math.abs(e - s), format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 6, "Reward", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, str.tostring(math.abs(t - e), format.mintick) + " (" + str.tostring(riskReward, "#.##") + "R)", text_color=color.white, text_size=size.small)
    else
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, "waiting for quality room…", text_color=color.gray, text_size=size.small)

alertcondition(newDir == 1, title="TRH Long Zone", message="TRH LONG zone created")
alertcondition(newDir == -1, title="TRH Short Zone", message="TRH SHORT zone created")
alertcondition(signalDir == 1, title="TRH Long Entry", message="TRH LONG entry fill")
alertcondition(signalDir == -1, title="TRH Short Entry", message="TRH SHORT entry fill")
