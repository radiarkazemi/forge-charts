// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | Trading Room Hunter — built from real XAUUSD sample (25 Aug 2026 04:19 UTC-4)
// Sample geometry: SL≈4620.23 (sweep low) · ENTRY≈4627.84 (mid-room) · TP≈4645.99 (~2.4R)

//@version=5
indicator("TRH | Trading Room Hunter", shorttitle="TRH", overlay=true, max_boxes_count=40, max_lines_count=80, max_labels_count=80, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grp = "TRH Detection"
tradeMode      = input.string("Classic+FVG", "Detection Mode", options=["Classic", "FVG", "Classic+FVG"], group=grp,
     tooltip="Live model: A SWEEP + B FVG. Classic=A only · FVG=B only · Classic+FVG=both (default). BTB removed.")
pivotPeriod    = input.int(5, "Pivot Period", minval=2, maxval=30, group=grp)
minContextAtr  = input.float(1.2, "Min Selloff/Rally Into Sweep (ATR×)", minval=0.5, maxval=8.0, step=0.1, group=grp)
minSweepAtr    = input.float(0.05, "Min Sweep Beyond Pivot (ATR×)", minval=0.0, maxval=1.0, step=0.05, group=grp)
baseConfirmBars= input.int(8, "Min Base Bars After Sweep (Mode A)", minval=2, maxval=40, group=grp)
maxBaseBars    = input.int(40, "Max Bars To Confirm Room (Mode A)", minval=5, maxval=100, group=grp)
minRoomAtr     = input.float(0.8, "Min Room Width (ATR×) Mode A", minval=0.3, maxval=5.0, step=0.1, group=grp)
maxRoomAtr     = input.float(3.5, "Max Room Width (ATR×) Mode A", minval=1.0, maxval=10.0, step=0.1, group=grp)
cooldownBars   = input.int(50, "Cooldown Between Setups", minval=10, maxval=300, group=grp)

grpB = "Mode B — Sweep + Disp + FVG"
minDispAtr     = input.float(0.55, "Min Displacement Body (ATR×)", step=0.05, group=grpB)
maxDispBars    = input.int(6, "Max Bars Sweep → Disp", group=grpB)
maxFvgBars     = input.int(18, "Max Bars Disp → FVG", group=grpB)
minFvgAtr      = input.float(0.45, "Min FVG Size (ATR×)", step=0.01, group=grpB)
minFvgPoints   = input.float(1.50, "Min FVG Size (price)", step=0.05, group=grpB,
     tooltip="Absolute floor. Rejects ~0.8pt micro FVGs that MT5 was taking while TV used ~2pt gaps.")
requireFvgRetest = input.bool(true, "Require FVG Retest", group=grpB)
maxRetestBars  = input.int(12, "Max Bars For Retest", group=grpB)
fvgSlExtraAtr  = input.float(0.45, "Extra SL Pad (ATR×)", step=0.01, group=grpB)
fvgMinRiskAtr  = input.float(1.55, "Min Mode B Risk (ATR×)", step=0.05, group=grpB,
     tooltip="Floor SL so broker stop-hunt wicks do not kill trades TV survives.")

grpC = "Mode C — Pro BTB (quality)"
minBreakAtr    = input.float(0.20, "Min Break Beyond Pivot (ATR×)", step=0.01, group=grpC)
minBreakBodyAtr= input.float(0.45, "Min Breakout Body (ATR×)", step=0.05, group=grpC)
maxBtbRetestBars = input.int(10, "Max BTB Retest Bars", group=grpC)
btbRiskReward  = input.float(2.0, "BTB Risk-Reward (min 2)", minval=2.0, step=0.1, group=grpC)
btbSlExtraAtr  = input.float(0.15, "BTB Extra SL (ATR×)", step=0.01, group=grpC)
btbRequireConfirm = input.bool(true, "Require Confirm Candle On Retest", group=grpC)
btbMinRiskAtr  = input.float(0.50, "Min Risk Size (ATR×)", step=0.05, group=grpC,
     tooltip="Reject tiny SL setups (GOLD M1 noise).")
btbMinConfirmBodyAtr = input.float(0.28, "Min Confirm Body (ATR×)", step=0.02, group=grpC)
btbRequireWickReject = input.bool(true, "Wick Tags BE + Close Rejects", group=grpC)
btbMaxPastEntryAtr = input.float(0.20, "Skip If Past BE Toward TP (ATR×)", step=0.05, group=grpC)
btbMinBarsAfterBreak = input.int(2, "Min Bars After Breakout", minval=1, group=grpC)

grpPos = "Entry / SL / TP"
slPadAtr       = input.float(0.02, "SL Pad (ATR×)", minval=0.0, maxval=1.0, step=0.01, group=grpPos)
riskReward     = input.float(2.4, "Risk-Reward (Mode A/B)", minval=1.0, maxval=6.0, step=0.1, group=grpPos)
useLiquidityTP = input.bool(true, "Prefer Opposing Pivot As TP", group=grpPos)

grpDisp = "Display"
onlyLast       = input.bool(false, "Only Last Setup", group=grpDisp)
setupWidth     = input.int(80, "Box Width (bars)", minval=20, maxval=400, group=grpDisp)
showFillMark   = input.bool(true, "Show ENTRY/TP/SL Markers", group=grpDisp)
showPanel      = input.bool(true, "Info Panel", group=grpDisp)

grpCol = "Colors"
bullZoneCol = input.color(color.new(#26A69A, 82), "Long Room (A SWEEP)", group=grpCol)
bearZoneCol = input.color(color.new(#EF5350, 82), "Short Room (A SWEEP)", group=grpCol)
fvgBullCol  = input.color(color.new(#1E88E5, 78), "Long Zone (B FVG)", group=grpCol)
fvgBearCol  = input.color(color.new(#AB47BC, 78), "Short Zone (B FVG)", group=grpCol)
btbBullCol  = input.color(color.new(#FB8C00, 78), "Long Zone (C BTB)", group=grpCol)
btbBearCol  = input.color(color.new(#E64A19, 78), "Short Zone (C BTB)", group=grpCol)
entryCol    = input.color(#787B86, "Entry", group=grpCol)
slCol       = input.color(#EF5350, "SL", group=grpCol)
tpCol       = input.color(#26A69A, "TP", group=grpCol)

grpAlert = "Alerts"
alertZone  = input.bool(true, "Alert: room confirmed", group=grpAlert)
alertEntry = input.bool(true, "Alert: entry fill", group=grpAlert)
alertExit  = input.bool(true, "Alert: SL/TP", group=grpAlert)

// ═══════════════════════════════════════════════════════════════════════════
// ATR + PIVOTS
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(14)
ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float[] pivHi = array.new<float>()
var int[]   pivHiBar = array.new<int>()
var float[] pivLo = array.new<float>()
var int[]   pivLoBar = array.new<int>()

if not na(ph)
    array.push(pivHi, ph)
    array.push(pivHiBar, bar_index - pivotPeriod)
    while array.size(pivHi) > 30
        array.shift(pivHi)
        array.shift(pivHiBar)

if not na(pl)
    array.push(pivLo, pl)
    array.push(pivLoBar, bar_index - pivotPeriod)
    while array.size(pivLo) > 30
        array.shift(pivLo)
        array.shift(pivLoBar)

f_lastPivotLow(maxAge) =>
    float best = na
    int bestB = na
    if array.size(pivLo) > 0
        for i = array.size(pivLo) - 1 to 0
            int b = array.get(pivLoBar, i)
            float px = array.get(pivLo, i)
            int age = bar_index - b
            if age >= pivotPeriod and age <= maxAge
                if na(best) or px <= best
                    best := px
                    bestB := b
    [best, bestB]

f_lastPivotHigh(maxAge) =>
    float best = na
    int bestB = na
    if array.size(pivHi) > 0
        for i = array.size(pivHi) - 1 to 0
            int b = array.get(pivHiBar, i)
            float px = array.get(pivHi, i)
            int age = bar_index - b
            if age >= pivotPeriod and age <= maxAge
                if na(best) or px >= best
                    best := px
                    bestB := b
    [best, bestB]

f_nextLiquidityHigh(fromPrice, minDist) =>
    float best = na
    if array.size(pivHi) > 0
        for i = 0 to array.size(pivHi) - 1
            px = array.get(pivHi, i)
            if px >= fromPrice + minDist
                if na(best) or px < best
                    best := px
    best

f_nextLiquidityLow(fromPrice, minDist) =>
    float best = na
    if array.size(pivLo) > 0
        for i = 0 to array.size(pivLo) - 1
            px = array.get(pivLo, i)
            if px <= fromPrice - minDist
                if na(best) or px > best
                    best := px
    best

// ═══════════════════════════════════════════════════════════════════════════
// PENDING SWEEP → BUILD ROOM (sample path)
// Long: selloff → sweep pivot low → base → mid-room ENTRY
// Short: mirror
// ═══════════════════════════════════════════════════════════════════════════

useClassic = tradeMode == "Classic" or tradeMode == "Classic+FVG"
useFvgMode = tradeMode == "FVG" or tradeMode == "Classic+FVG"
useBtbMode = false // BTB removed from live model

[huntLo, huntLoBar] = f_lastPivotLow(80)
[huntHi, huntHiBar] = f_lastPivotHigh(80)

priorHigh = ta.highest(high[1], 40)
priorLow  = ta.lowest(low[1], 40)
selloffInto = priorHigh - low
rallyInto   = high - priorLow

bullSweepNow = not na(huntLo) and low < huntLo - atr * minSweepAtr and close > huntLo and close > open and selloffInto >= atr * minContextAtr
bearSweepNow = not na(huntHi) and high > huntHi + atr * minSweepAtr and close < huntHi and close < open and rallyInto >= atr * minContextAtr

var int   pendDir = 0
var float pendDistal = na
var float pendHunt = na
var int   pendBar = na
var float pendBaseHigh = na
var float pendBaseLow = na

// Mode B state
var int   bPhase = 0
var int   bDir = 0
var float bDistal = na
var float bHunt = na
var float bGapTop = na
var float bGapBot = na
var int   bSweepBar = na
var int   bDispBar = na
var int   bFvgBar = na

// Mode C state
var int   cPhase = 0
var int   cDir = 0
var float cBreakLevel = na
var float cBeLevel = na
var float cBreakExt = na
var int   cBreakBar = na

var int lastSetupBar = na
var int lastModeId = 99
var string newMode = "A · SWEEP"
var int newModeId = 0

// Priority A(0) > B(1) > C(2): stronger mode may fire inside cooldown of a weaker one
f_coolOk(int modeId) =>
    na(lastSetupBar) or bar_index - lastSetupBar >= cooldownBars or modeId < lastModeId

int newDir = 0
float newDistal = na
float newProximal = na
float newEntry = na
float newSl = na
float newTp = na
newMode := "A · SWEEP"
newModeId := 0

if barstate.isconfirmed
    // ── Mode A classic (main) ─────────────────────────────────────
    if useClassic
        canStart = pendDir == 0 and f_coolOk(0) and newDir == 0
        if canStart and bullSweepNow
            pendDir := 1
            pendDistal := low
            pendHunt := huntLo
            pendBar := bar_index
            pendBaseHigh := high
            pendBaseLow := low
        else if canStart and bearSweepNow
            pendDir := -1
            pendDistal := high
            pendHunt := huntHi
            pendBar := bar_index
            pendBaseHigh := high
            pendBaseLow := low

        if pendDir != 0
            pendBaseHigh := math.max(nz(pendBaseHigh), high)
            pendBaseLow := math.min(nz(pendBaseLow), low)
            if pendDir == 1 and low < pendDistal
                pendDistal := low
            if pendDir == -1 and high > pendDistal
                pendDistal := high
            if bar_index - pendBar > maxBaseBars
                pendDir := 0
                pendDistal := na
                pendHunt := na
                pendBar := na
                pendBaseHigh := na
                pendBaseLow := na

        if pendDir != 0 and not na(pendBar) and bar_index - pendBar >= baseConfirmBars and newDir == 0
            int age = bar_index - pendBar
            if pendDir == 1
                float distal = pendDistal
                float proximal = pendBaseHigh
                float width = proximal - distal
                float prevBaseHigh = nz(pendBaseHigh[1], proximal)
                bool microBreak = close > open and (high >= prevBaseHigh or close >= distal + width * 0.7)
                if width >= atr * minRoomAtr and width <= atr * maxRoomAtr and microBreak
                    float entry = (distal + proximal) * 0.5
                    float sl = distal - atr * slPadAtr
                    float risk = entry - sl
                    float tpRR = entry + risk * riskReward
                    float liq = f_nextLiquidityHigh(entry, risk * 1.5)
                    float tp = useLiquidityTP and not na(liq) ? math.max(tpRR, liq) : tpRR
                    newDir := 1
                    newDistal := distal
                    newProximal := proximal
                    newEntry := entry
                    newSl := sl
                    newTp := tp
                    newMode := "A · SWEEP"
                    newModeId := 0
            else if pendDir == -1
                float distal = pendDistal
                float proximal = pendBaseLow
                float width = distal - proximal
                float prevBaseLow = nz(pendBaseLow[1], proximal)
                bool microBreak = close < open and (low <= prevBaseLow or close <= distal - width * 0.7)
                if width >= atr * minRoomAtr and width <= atr * maxRoomAtr and microBreak
                    float entry = (distal + proximal) * 0.5
                    float sl = distal + atr * slPadAtr
                    float risk = sl - entry
                    float tpRR = entry - risk * riskReward
                    float liq = f_nextLiquidityLow(entry, risk * 1.5)
                    float tp = useLiquidityTP and not na(liq) ? math.min(tpRR, liq) : tpRR
                    newDir := -1
                    newDistal := distal
                    newProximal := proximal
                    newEntry := entry
                    newSl := sl
                    newTp := tp
                    newMode := "A · SWEEP"
                    newModeId := 0
            if newDir != 0
                pendDir := 0
                pendDistal := na
                pendHunt := na
                pendBar := na
                pendBaseHigh := na
                pendBaseLow := na

    // ── Mode B FVG ────────────────────────────────────────────────
    if useFvgMode
        if bPhase == 1 and not na(bSweepBar) and bar_index - bSweepBar > maxDispBars
            bPhase := 0
            bDir := 0
        if bPhase == 2 and not na(bDispBar) and bar_index - bDispBar > maxFvgBars
            bPhase := 0
            bDir := 0
        if bPhase == 3 and not na(bFvgBar) and bar_index - bFvgBar > maxRetestBars
            bPhase := 0
            bDir := 0

        bool bStart = bPhase == 0 and f_coolOk(1) and newDir == 0
        if bStart and bullSweepNow
            bPhase := 1
            bDir := 1
            bDistal := low
            bHunt := huntLo
            bSweepBar := bar_index
            bDispBar := na
            bFvgBar := na
        else if bStart and bearSweepNow
            bPhase := 1
            bDir := -1
            bDistal := high
            bHunt := huntHi
            bSweepBar := bar_index
            bDispBar := na
            bFvgBar := na

        if bPhase != 0
            if bDir == 1 and low < bDistal
                bDistal := low
            if bDir == -1 and high > bDistal
                bDistal := high
            float body = math.abs(close - open)

            if bPhase == 1 and bar_index > bSweepBar
                bool bullDisp = bDir == 1 and close > open and body >= atr * minDispAtr and close > bHunt
                bool bearDisp = bDir == -1 and close < open and body >= atr * minDispAtr and close < bHunt
                if bullDisp or bearDisp
                    bPhase := 2
                    bDispBar := bar_index

            if bPhase == 2 and bar_index >= 2 and bar_index > bDispBar
                bool found = false
                if bDir == 1
                    float bot = high[2]
                    float top = low
                    if top - bot >= atr * minFvgAtr and top - bot >= minFvgPoints
                        bGapBot := bot
                        bGapTop := top
                        found := true
                else
                    float top2 = low[2]
                    float bot2 = high
                    if top2 - bot2 >= atr * minFvgAtr and top2 - bot2 >= minFvgPoints
                        bGapBot := bot2
                        bGapTop := top2
                        found := true
                if found
                    bFvgBar := bar_index
                    if requireFvgRetest
                        bPhase := 3
                    else if newDir == 0
                        float entry = (bGapTop + bGapBot) * 0.5
                        float pad = atr * (slPadAtr + fvgSlExtraAtr)
                        float slExt = bDir == 1 ? math.min(bDistal, bGapBot) : math.max(bDistal, bGapTop)
                        float sl = bDir == 1 ? slExt - pad : slExt + pad
                        float risk = math.abs(entry - sl)
                        float minRisk = atr * fvgMinRiskAtr
                        if minRisk > 0 and risk < minRisk
                            sl := bDir == 1 ? entry - minRisk : entry + minRisk
                            risk := minRisk
                        if risk > syminfo.mintick and (bDir == 1 ? entry > sl : sl > entry)
                            float tp = bDir == 1 ? entry + risk * riskReward : entry - risk * riskReward
                            if useLiquidityTP
                                if bDir == 1
                                    float liq = f_nextLiquidityHigh(entry, risk * 1.5)
                                    if not na(liq)
                                        tp := math.max(tp, liq)
                                else
                                    float liq2 = f_nextLiquidityLow(entry, risk * 1.5)
                                    if not na(liq2)
                                        tp := math.min(tp, liq2)
                            newDir := bDir
                            newEntry := entry
                            newSl := sl
                            newTp := tp
                            newProximal := bGapTop
                            newDistal := bGapBot
                            newMode := "B · FVG"
                            newModeId := 1
                        bPhase := 0
                        bDir := 0

            if bPhase == 3 and bar_index > bFvgBar and newDir == 0
                bool confirmed = false
                if bDir == 1
                    bool retested = low <= bGapTop and low >= bGapBot - atr * 0.05
                    confirmed := retested and close > open and close >= (bGapBot + bGapTop) * 0.5
                else
                    bool retested2 = high >= bGapBot and high <= bGapTop + atr * 0.05
                    confirmed := retested2 and close < open and close <= (bGapBot + bGapTop) * 0.5
                if confirmed
                    float entry = (bGapTop + bGapBot) * 0.5
                    float pad = atr * (slPadAtr + fvgSlExtraAtr)
                    float slExt = bDir == 1 ? math.min(bDistal, bGapBot) : math.max(bDistal, bGapTop)
                    float sl = bDir == 1 ? slExt - pad : slExt + pad
                    float risk = math.abs(entry - sl)
                    float minRisk = atr * fvgMinRiskAtr
                    if minRisk > 0 and risk < minRisk
                        sl := bDir == 1 ? entry - minRisk : entry + minRisk
                        risk := minRisk
                    if risk > syminfo.mintick and (bDir == 1 ? entry > sl : sl > entry)
                        float tp = bDir == 1 ? entry + risk * riskReward : entry - risk * riskReward
                        if useLiquidityTP
                            if bDir == 1
                                float liq = f_nextLiquidityHigh(entry, risk * 1.5)
                                if not na(liq)
                                    tp := math.max(tp, liq)
                            else
                                float liq2 = f_nextLiquidityLow(entry, risk * 1.5)
                                if not na(liq2)
                                    tp := math.min(tp, liq2)
                        newDir := bDir
                        newEntry := entry
                        newSl := sl
                        newTp := tp
                        newProximal := bGapTop
                        newDistal := bGapBot
                        newMode := "B · FVG"
                        newModeId := 1
                    bPhase := 0
                    bDir := 0

    // ── Mode C Pro BTB (quality filters) ──────────────────────────
    if useBtbMode
        float btbRR = math.max(btbRiskReward, 2.0)
        if cPhase == 1 and not na(cBreakBar) and bar_index - cBreakBar > maxBtbRetestBars
            cPhase := 0
            cDir := 0

        bool cStart = cPhase == 0 and f_coolOk(2) and newDir == 0
        float bodyC = math.abs(close - open)
        if cStart and not na(huntHi)
            bool brokeHi = close > huntHi + atr * minBreakAtr and close > open and bodyC >= atr * minBreakBodyAtr
            if brokeHi
                cPhase := 1
                cDir := 1
                cBreakLevel := huntHi
                cBeLevel := close
                cBreakExt := low
                cBreakBar := bar_index
        if cStart and cPhase == 0 and not na(huntLo)
            bool brokeLo = close < huntLo - atr * minBreakAtr and close < open and bodyC >= atr * minBreakBodyAtr
            if brokeLo
                cPhase := 1
                cDir := -1
                cBreakLevel := huntLo
                cBeLevel := close
                cBreakExt := high
                cBreakBar := bar_index

        if cPhase == 1 and bar_index > cBreakBar and bar_index - cBreakBar >= btbMinBarsAfterBreak and newDir == 0
            if cDir == 1 and low < cBreakExt
                cBreakExt := low
            if cDir == -1 and high > cBreakExt
                cBreakExt := high
            float touchHi = math.max(cBeLevel, cBreakLevel) + atr * 0.05
            float touchLo = math.min(cBeLevel, cBreakLevel) - atr * 0.05
            bool touched = low <= touchHi and high >= touchLo
            if touched
                float confBody = math.abs(close - open)
                bool confirmed = true
                if btbRequireConfirm
                    if cDir == 1
                        confirmed := close > open and close >= math.min(cBeLevel, cBreakLevel) and confBody >= atr * btbMinConfirmBodyAtr
                    else
                        confirmed := close < open and close <= math.max(cBeLevel, cBreakLevel) and confBody >= atr * btbMinConfirmBodyAtr
                if confirmed and btbRequireWickReject
                    float midZone = (touchHi + touchLo) * 0.5
                    if cDir == 1
                        confirmed := low <= midZone and close >= midZone
                    else
                        confirmed := high >= midZone and close <= midZone
                if confirmed
                    if (cDir == 1 and close < cBreakExt) or (cDir == -1 and close > cBreakExt)
                        cPhase := 0
                        cDir := 0
                    else
                        float entry = cBeLevel
                        bool pastOk = true
                        if btbMaxPastEntryAtr > 0
                            if cDir == 1 and close > entry + atr * btbMaxPastEntryAtr
                                pastOk := false
                            if cDir == -1 and close < entry - atr * btbMaxPastEntryAtr
                                pastOk := false
                        float pad = atr * (slPadAtr + btbSlExtraAtr)
                        float sl = cDir == 1 ? cBreakExt - pad : cBreakExt + pad
                        float risk = math.abs(entry - sl)
                        if pastOk and risk >= atr * btbMinRiskAtr
                            float tp = cDir == 1 ? entry + risk * btbRR : entry - risk * btbRR
                            if useLiquidityTP
                                if cDir == 1
                                    float liq = f_nextLiquidityHigh(entry, risk * 1.5)
                                    if not na(liq)
                                        tp := math.max(tp, liq)
                                else
                                    float liq2 = f_nextLiquidityLow(entry, risk * 1.5)
                                    if not na(liq2)
                                        tp := math.min(tp, liq2)
                            newDir := cDir
                            newEntry := entry
                            newSl := sl
                            newTp := tp
                            newProximal := cBreakLevel
                            newDistal := sl
                            newMode := "C · BTB"
                            newModeId := 2
                        cPhase := 0
                        cDir := 0

// ═══════════════════════════════════════════════════════════════════════════
// DRAWINGS + TRADE STATE
// ═══════════════════════════════════════════════════════════════════════════

var box[]   bZone = array.new<box>()
var box[]   bTp = array.new<box>()
var box[]   bSl = array.new<box>()
var line[]  lEntry = array.new<line>()
var label[] labE = array.new<label>()
var label[] labS = array.new<label>()
var label[] labT = array.new<label>()
var label[] labTag = array.new<label>()

var int[]   sDir = array.new<int>()
var float[] sEntry = array.new<float>()
var float[] sSl = array.new<float>()
var float[] sTp = array.new<float>()
var float[] sProx = array.new<float>()
var float[] sDist = array.new<float>()
var int[]   sBar = array.new<int>()
var int[]   sStat = array.new<int>()
var bool[]  sFilled = array.new<bool>()

var float activeE = na
var float activeS = na
var float activeT = na
var int signalDir = 0
signalDir := 0

if newDir != 0
    if onlyLast and array.size(sDir) > 0
        int nClear = array.size(bZone)
        if nClear > 0
            for i = 0 to nClear - 1
                box.delete(array.get(bZone, i))
                box.delete(array.get(bTp, i))
                box.delete(array.get(bSl, i))
                line.delete(array.get(lEntry, i))
                label.delete(array.get(labE, i))
                label.delete(array.get(labS, i))
                label.delete(array.get(labT, i))
                label.delete(array.get(labTag, i))
        array.clear(bZone)
        array.clear(bTp)
        array.clear(bSl)
        array.clear(lEntry)
        array.clear(labE)
        array.clear(labS)
        array.clear(labT)
        array.clear(labTag)
        array.clear(sDir)
        array.clear(sEntry)
        array.clear(sSl)
        array.clear(sTp)
        array.clear(sProx)
        array.clear(sDist)
        array.clear(sBar)
        array.clear(sStat)
        array.clear(sFilled)

    zTop = math.max(newProximal, newDistal)
    zBot = math.min(newProximal, newDistal)
    right = bar_index + setupWidth
    zcol = newModeId == 1 ? (newDir == 1 ? fvgBullCol : fvgBearCol) : newModeId == 2 ? (newDir == 1 ? btbBullCol : btbBearCol) : (newDir == 1 ? bullZoneCol : bearZoneCol)
    tagCol = newModeId == 1 ? (newDir == 1 ? #1E88E5 : #8E24AA) : newModeId == 2 ? (newDir == 1 ? #EF6C00 : #D84315) : (newDir == 1 ? #00897B : #C62828)

    // Room / AOI box
    array.push(bZone, box.new(bar_index, zTop, right, zBot, bgcolor=zcol, border_color=color.new(tagCol, 20), border_width=2))
    // TP / SL shade
    if newDir == 1
        array.push(bTp, box.new(bar_index, newTp, right, newEntry, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newEntry, right, newSl, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))
    else
        array.push(bTp, box.new(bar_index, newEntry, right, newTp, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newSl, right, newEntry, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))

    array.push(lEntry, line.new(bar_index, newEntry, right, newEntry, color=entryCol, width=2))
    array.push(labE, label.new(right, newEntry, "ENTRY " + str.tostring(newEntry, format.mintick), style=label.style_label_left, color=entryCol, textcolor=color.white, size=size.small))
    array.push(labS, label.new(right, newSl, "SL " + str.tostring(newSl, format.mintick), style=label.style_label_left, color=slCol, textcolor=color.white, size=size.small))
    array.push(labT, label.new(right, newTp, "TP " + str.tostring(newTp, format.mintick), style=label.style_label_left, color=tpCol, textcolor=color.white, size=size.small))
    rrShow = newModeId == 2 ? btbRiskReward : riskReward
    array.push(labTag, label.new(bar_index, newDir == 1 ? zTop : zBot, "TRH " + (newDir == 1 ? "LONG" : "SHORT") + " · " + newMode + "\nR:R " + str.tostring(rrShow, "#.#"), style=newDir == 1 ? label.style_label_down : label.style_label_up, color=tagCol, textcolor=color.white, size=size.normal))

    array.push(sDir, newDir)
    array.push(sEntry, newEntry)
    array.push(sSl, newSl)
    array.push(sTp, newTp)
    array.push(sProx, newProximal)
    array.push(sDist, newDistal)
    array.push(sBar, bar_index)
    array.push(sStat, 0)
    array.push(sFilled, false)
    lastSetupBar := bar_index
    lastModeId := newModeId

    // If price already traded through entry during the base, count as filled (Set & Forget)
    alreadyFilled = newDir == 1 ? low <= newEntry : high >= newEntry
    // On confirm bar, price is often already above entry (sample 04:22) — mark in-trade
    if alreadyFilled or (newDir == 1 and close >= newEntry) or (newDir == -1 and close <= newEntry)
        array.set(sStat, array.size(sStat) - 1, 1)
        array.set(sFilled, array.size(sFilled) - 1, true)
        signalDir := newDir
        activeE := newEntry
        activeS := newSl
        activeT := newTp
        if showFillMark
            label.new(bar_index, newEntry, "▶ ENTRY", style=label.style_label_center, color=newDir == 1 ? #00897B : #C62828, textcolor=color.white, size=size.normal)
        if alertEntry
            alert("TRH " + newMode + " ENTRY " + (newDir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(newEntry, format.mintick) + " | SL " + str.tostring(newSl, format.mintick) + " | TP " + str.tostring(newTp, format.mintick), alert.freq_once_per_bar_close)

    if alertZone
        alert("TRH " + newMode + " setup | ENTRY " + str.tostring(newEntry, format.mintick) + " | SL " + str.tostring(newSl, format.mintick) + " | TP " + str.tostring(newTp, format.mintick), alert.freq_once_per_bar_close)

// Manage live setups
n = array.size(sDir)
if n > 0
    for i = 0 to n - 1
        st = array.get(sStat, i)
        if st <= 1
            dir = array.get(sDir, i)
            e = array.get(sEntry, i)
            s = array.get(sSl, i)
            t = array.get(sTp, i)
            startB = array.get(sBar, i)
            right = math.max(bar_index, startB + setupWidth)
            box.set_right(array.get(bZone, i), right)
            box.set_right(array.get(bTp, i), right)
            box.set_right(array.get(bSl, i), right)
            line.set_x2(array.get(lEntry, i), right)
            label.set_x(array.get(labE, i), right)
            label.set_x(array.get(labS, i), right)
            label.set_x(array.get(labT, i), right)

            if st == 0 and bar_index - startB > setupWidth
                array.set(sStat, i, 4)
            else if st == 0
                hitE = dir == 1 ? low <= e : high >= e
                if hitE
                    array.set(sStat, i, 1)
                    array.set(sFilled, i, true)
                    signalDir := dir
                    activeE := e
                    activeS := s
                    activeT := t
                    if showFillMark
                        label.new(bar_index, e, "▶ ENTRY", style=label.style_label_center, color=dir == 1 ? #00897B : #C62828, textcolor=color.white, size=size.normal)
                    if alertEntry
                        alert("TRH ENTRY @ " + str.tostring(e, format.mintick), alert.freq_once_per_bar_close)

            if array.get(sStat, i) == 1
                // Prefer TP if both wick in one bar
                hitT = dir == 1 ? high >= t : low <= t
                hitS = dir == 1 ? low <= s : high >= s
                if hitT
                    array.set(sStat, i, 2)
                    if showFillMark
                        label.new(bar_index, t, "✓ TP EXIT", style=label.style_label_center, color=#26A69A, textcolor=color.white, size=size.normal)
                    if alertExit
                        alert("TRH TP EXIT @ " + str.tostring(t, format.mintick), alert.freq_once_per_bar_close)
                else if hitS
                    array.set(sStat, i, 3)
                    if showFillMark
                        label.new(bar_index, s, "✗ SL EXIT", style=label.style_label_center, color=#EF5350, textcolor=color.white, size=size.normal)
                    if alertExit
                        alert("TRH SL EXIT @ " + str.tostring(s, format.mintick), alert.freq_once_per_bar_close)

plot(activeE, "ENTRY", color=entryCol, display=display.data_window)
plot(activeS, "SL", color=slCol, display=display.data_window)
plot(activeT, "TP", color=tpCol, display=display.data_window)

var string lastModeShown = "A · SWEEP"
if newDir != 0
    lastModeShown := newMode

var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(#111111, 5), border_width=1, border_color=color.new(color.white, 70))
if showPanel and barstate.islast
    if array.size(sDir) > 0
        idx = array.size(sDir) - 1
        dir = array.get(sDir, idx)
        st = array.get(sStat, idx)
        stTxt = st == 0 ? "WAIT FILL" : st == 1 ? "IN TRADE" : st == 2 ? "TP HIT" : st == 3 ? "SL HIT" : "EXPIRED"
        e = array.get(sEntry, idx)
        s = array.get(sSl, idx)
        t = array.get(sTp, idx)
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, (dir == 1 ? "LONG" : "SHORT") + " · " + stTxt, text_color=dir == 1 ? #69F0AE : #FF8A80, text_size=size.small)
        table.cell(info, 0, 1, "Mode", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, lastModeShown + " · " + tradeMode, text_color=color.white, text_size=size.small) // A·SWEEP or B·FVG
        table.cell(info, 0, 2, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, str.tostring(e, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "SL", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, str.tostring(s, format.mintick), text_color=#FF8A80, text_size=size.small)
        table.cell(info, 0, 4, "TP", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, str.tostring(t, format.mintick), text_color=#69F0AE, text_size=size.small)
        table.cell(info, 0, 5, "Risk", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, str.tostring(math.abs(e - s), format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 6, "Reward", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, str.tostring(math.abs(t - e), format.mintick), text_color=color.white, text_size=size.small)
    else
        scanTxt = pendDir != 0 ? "A building…" : bPhase != 0 ? "B phase " + str.tostring(bPhase) : cPhase != 0 ? "C wait retest" : "scanning…"
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, scanTxt + " · " + tradeMode, text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 1, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 2, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 3, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 6, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, "", text_color=color.gray, text_size=size.small)

alertcondition(newDir == 1, title="TRH Long Room", message="TRH LONG sweep room confirmed")
alertcondition(newDir == -1, title="TRH Short Room", message="TRH SHORT sweep room confirmed")
alertcondition(signalDir == 1, title="TRH Long Entry", message="TRH LONG entry")
alertcondition(signalDir == -1, title="TRH Short Entry", message="TRH SHORT entry")
