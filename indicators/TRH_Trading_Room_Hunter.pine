// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// TRH | Trading Room Hunter — exact ENTRY / SL / TP for Khosro-style Smart Money zones

//@version=5
indicator("TRH | Trading Room Hunter", shorttitle="TRH", overlay=true, max_boxes_count=100, max_lines_count=150, max_labels_count=150, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpSpike = "Spike Filter | Movement"
minSpikeBars    = input.int(3, "Minimum Spike Bars", minval=2, maxval=20, group=grpSpike)
useMovePower    = input.bool(true, "Movement Power", group=grpSpike)
movePowerLevel  = input.float(1.5, "Movement Power Level (ATR×)", minval=0.5, maxval=5.0, step=0.1, group=grpSpike)
pivotPeriod     = input.int(5, "Pivot Period", minval=2, maxval=50, group=grpSpike)
enableSweepHunt = input.bool(true, "Liquidity Sweep Hunt Mode", group=grpSpike,
     tooltip="Mark TRH rooms after a stop-hunt sweep + reclaim (Aug 25 04:19 gold style).")
sweepLookback   = input.int(20, "Sweep Lookback Bars", minval=5, maxval=100, group=grpSpike)

grpPos = "Position Management"
useSlThreshold = input.bool(true, "Stop-Loss Threshold", group=grpPos)
slThreshold    = input.float(0.5, "Stop-Loss Threshold Value (ATR×)", minval=0.0, maxval=5.0, step=0.1, group=grpPos)
riskReward     = input.float(2.0, "Risk-Reward Ratio", minval=0.5, maxval=10.0, step=0.1, group=grpPos)
wideZoneFilter = input.bool(true, "Wide Zone Filter", group=grpPos)
maxZoneAtr     = input.float(3.0, "Max Zone Width (ATR×)", minval=0.5, maxval=15.0, step=0.1, group=grpPos)

grpDisp = "Display"
displayMode    = input.string("Setup", "Display Mode", options=["Setup", "Signal"], group=grpDisp)
showEntryLvls  = input.bool(true, "Show Entry / SL / TP Levels", group=grpDisp)
onlyLastPos    = input.bool(false, "Only Display the Last Position", group=grpDisp)
setupWidthBars = input.int(25, "Setup Width (bars)", minval=5, maxval=200, group=grpDisp)
showPivots     = input.bool(true, "Show Pivot Circles", group=grpDisp)
showInternal   = input.bool(true, "Show Intermediate (Orange) Pivots", group=grpDisp)
maxSetupsKeep  = input.int(8, "Max Historical Setups", minval=1, maxval=30, group=grpDisp)

grpCol = "Colors"
bullZoneCol  = input.color(color.new(#2196F3, 78), "Bullish TRH Zone", group=grpCol)
bearZoneCol  = input.color(color.new(#E53935, 78), "Bearish TRH Zone", group=grpCol)
entryCol     = input.color(#212121, "Entry Line", group=grpCol)
slCol        = input.color(#E53935, "Stop-Loss Line", group=grpCol)
tpCol        = input.color(#43A047, "Take-Profit Line", group=grpCol)
bullPivotCol = input.color(#43A047, "Green Pivot (Lows)", group=grpCol)
bearPivotCol = input.color(#E53935, "Red Pivot (Highs)", group=grpCol)
midPivotCol  = input.color(#FF9800, "Orange Pivot (Internal)", group=grpCol)

grpAlert = "Alerts"
alertOnZone  = input.bool(true, "Alert when TRH zone is created", group=grpAlert)
alertOnEntry = input.bool(true, "Alert when price revisits TRH zone (entry)", group=grpAlert)
alertOnExit  = input.bool(true, "Alert on SL / TP hit", group=grpAlert)

// ═══════════════════════════════════════════════════════════════════════════
// PURE HELPERS (no global mutation)
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(14)

f_spikeUp(len) =>
    ok = true
    bodySum = 0.0
    for i = 0 to len - 1
        if close[i] <= open[i]
            ok := false
        bodySum += math.abs(close[i] - open[i])
    powerOk = not useMovePower or bodySum >= atr * movePowerLevel
    ok and powerOk and close > open[len - 1]

f_spikeDn(len) =>
    ok = true
    bodySum = 0.0
    for i = 0 to len - 1
        if close[i] >= open[i]
            ok := false
        bodySum += math.abs(close[i] - open[i])
    powerOk = not useMovePower or bodySum >= atr * movePowerLevel
    ok and powerOk and close < open[len - 1]

f_levels(dir, proximal, distal) =>
    entry = (proximal + distal) * 0.5
    pad = useSlThreshold ? atr * slThreshold : syminfo.mintick * 2.0
    sl = dir == 1 ? distal - pad : distal + pad
    risk = math.abs(entry - sl)
    tp = dir == 1 ? entry + risk * riskReward : entry - risk * riskReward
    [entry, sl, tp]

f_zoneOk(proximal, distal) =>
    top = math.max(proximal, distal)
    bot = math.min(proximal, distal)
    w = top - bot
    w > syminfo.mintick and (not wideZoneFilter or w <= atr * maxZoneAtr)

// ═══════════════════════════════════════════════════════════════════════════
// PIVOTS
// ═══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float lastMajorHigh = na
var float lastMajorLow = na
var int lastMajorHighBar = na
var int lastMajorLowBar = na
var float lastInternalHigh = na
var float lastInternalLow = na

if not na(ph)
    lastInternalHigh := ph
    if na(lastMajorHigh) or ph >= lastMajorHigh or bar_index - nz(lastMajorHighBar) > pivotPeriod * 4
        lastMajorHigh := ph
        lastMajorHighBar := bar_index - pivotPeriod

if not na(pl)
    lastInternalLow := pl
    if na(lastMajorLow) or pl <= lastMajorLow or bar_index - nz(lastMajorLowBar) > pivotPeriod * 4
        lastMajorLow := pl
        lastMajorLowBar := bar_index - pivotPeriod

plotshape(showPivots and not na(pl) ? pl : na, title="Major Low", style=shape.circle, location=location.absolute, color=bullPivotCol, size=size.tiny, offset=-pivotPeriod)
plotshape(showPivots and not na(ph) ? ph : na, title="Major High", style=shape.circle, location=location.absolute, color=bearPivotCol, size=size.tiny, offset=-pivotPeriod)

halfLen = math.max(2, int(pivotPeriod / 2))
intPh = ta.pivothigh(high, halfLen, halfLen)
intPl = ta.pivotlow(low, halfLen, halfLen)
plotshape(showInternal and not na(intPl) ? intPl : na, title="Internal Low", style=shape.circle, location=location.absolute, color=midPivotCol, size=size.tiny, offset=-halfLen)
plotshape(showInternal and not na(intPh) ? intPh : na, title="Internal High", style=shape.circle, location=location.absolute, color=midPivotCol, size=size.tiny, offset=-halfLen)

// ═══════════════════════════════════════════════════════════════════════════
// DETECT SETUPS (series flags + candidate prices)
// ═══════════════════════════════════════════════════════════════════════════

spikeUp = f_spikeUp(minSpikeBars)
spikeDn = f_spikeDn(minSpikeBars)
structHigh = ta.highest(high[1], pivotPeriod * 2)
structLow = ta.lowest(low[1], pivotPeriod * 2)
bullBos = spikeUp and close > structHigh and not na(lastMajorLow)
bearBos = spikeDn and close < structLow and not na(lastMajorHigh)

priorSwingLow = ta.lowest(low[1], sweepLookback)
priorSwingHigh = ta.highest(high[1], sweepLookback)
bullSweep = enableSweepHunt and low < priorSwingLow and close > priorSwingLow and close > open
bearSweep = enableSweepHunt and high > priorSwingHigh and close < priorSwingHigh and close < open

var int lastBullZoneBar = na
var int lastBearZoneBar = na

// Candidate pack: dir, proximal, distal, fire
int newDir = 0
float newProx = na
float newDist = na

if barstate.isconfirmed
    // Priority 1: classic BoS TRH
    if bullBos and (na(lastBullZoneBar) or bar_index - lastBullZoneBar > minSpikeBars)
        float d = nz(lastMajorLow, ta.lowest(low, minSpikeBars + pivotPeriod))
        if not na(lastInternalLow)
            d := math.min(d, lastInternalLow)
        float p = low
        if d < p and f_zoneOk(p, d)
            newDir := 1
            newProx := p
            newDist := d
    else if bearBos and (na(lastBearZoneBar) or bar_index - lastBearZoneBar > minSpikeBars)
        float d = nz(lastMajorHigh, ta.highest(high, minSpikeBars + pivotPeriod))
        if not na(lastInternalHigh)
            d := math.max(d, lastInternalHigh)
        float p = high
        if d > p and f_zoneOk(p, d)
            newDir := -1
            newProx := p
            newDist := d
    // Priority 2: liquidity sweep hunt
    else if bullSweep and (na(lastBullZoneBar) or bar_index - lastBullZoneBar > pivotPeriod)
        float d = low
        float p = math.max(close, open)
        p := math.min(p, priorSwingLow + atr * 0.8)
        p := math.max(p, d + syminfo.mintick * 5)
        if d < p and f_zoneOk(p, d)
            newDir := 1
            newProx := p
            newDist := d
    else if bearSweep and (na(lastBearZoneBar) or bar_index - lastBearZoneBar > pivotPeriod)
        float d = high
        float p = math.min(close, open)
        p := math.max(p, priorSwingHigh - atr * 0.8)
        p := math.min(p, d - syminfo.mintick * 5)
        if d > p and f_zoneOk(p, d)
            newDir := -1
            newProx := p
            newDist := d

// ═══════════════════════════════════════════════════════════════════════════
// STATE + DRAWINGS (all mutation in global scope)
// ═══════════════════════════════════════════════════════════════════════════

var box[] zoneBoxes = array.new<box>()
var line[] entryLines = array.new<line>()
var line[] slLines = array.new<line>()
var line[] tpLines = array.new<line>()
var label[] entryLabels = array.new<label>()
var label[] slLabels = array.new<label>()
var label[] tpLabels = array.new<label>()
var label[] tagLabels = array.new<label>()

var int[] sDir = array.new<int>()
var float[] sEntry = array.new<float>()
var float[] sSl = array.new<float>()
var float[] sTp = array.new<float>()
var float[] sProx = array.new<float>()
var float[] sDist = array.new<float>()
var int[] sStartBar = array.new<int>()
var int[] sStatus = array.new<int>() // 0 wait, 1 in trade, 2 tp, 3 sl, 4 expired
var bool[] sAlertedIn = array.new<bool>()

var float activeEntry = na
var float activeSl = na
var float activeTp = na
var int signalDir = 0

signalDir := 0

// Create new setup
if newDir != 0 and not na(newProx) and not na(newDist)
    if onlyLastPos and array.size(sDir) > 0
        for i = 0 to array.size(zoneBoxes) - 1
            box.delete(array.get(zoneBoxes, i))
            line.delete(array.get(entryLines, i))
            line.delete(array.get(slLines, i))
            line.delete(array.get(tpLines, i))
            label.delete(array.get(entryLabels, i))
            label.delete(array.get(slLabels, i))
            label.delete(array.get(tpLabels, i))
            label.delete(array.get(tagLabels, i))
        array.clear(zoneBoxes)
        array.clear(entryLines)
        array.clear(slLines)
        array.clear(tpLines)
        array.clear(entryLabels)
        array.clear(slLabels)
        array.clear(tpLabels)
        array.clear(tagLabels)
        array.clear(sDir)
        array.clear(sEntry)
        array.clear(sSl)
        array.clear(sTp)
        array.clear(sProx)
        array.clear(sDist)
        array.clear(sStartBar)
        array.clear(sStatus)
        array.clear(sAlertedIn)

    [entry, sl, tp] = f_levels(newDir, newProx, newDist)
    zoneTop = math.max(newProx, newDist)
    zoneBot = math.min(newProx, newDist)
    rightBar = bar_index + setupWidthBars
    zcol = newDir == 1 ? bullZoneCol : bearZoneCol

    array.push(zoneBoxes, box.new(bar_index, zoneTop, rightBar, zoneBot, bgcolor=zcol, border_color=color.new(zcol, 30), border_width=1))
    array.push(entryLines, line.new(bar_index, entry, rightBar, entry, color=entryCol, width=2))
    array.push(slLines, line.new(bar_index, sl, rightBar, sl, color=slCol, style=line.style_dashed, width=2))
    array.push(tpLines, line.new(bar_index, tp, rightBar, tp, color=tpCol, style=line.style_dashed, width=2))

    eTxt = showEntryLvls ? "ENTRY " + str.tostring(entry, format.mintick) : ""
    sTxt = showEntryLvls ? "SL " + str.tostring(sl, format.mintick) : ""
    tTxt = showEntryLvls ? "TP " + str.tostring(tp, format.mintick) : ""
    array.push(entryLabels, label.new(rightBar, entry, eTxt, style=label.style_label_left, color=showEntryLvls ? entryCol : color.new(entryCol, 100), textcolor=color.white, size=size.small))
    array.push(slLabels, label.new(rightBar, sl, sTxt, style=label.style_label_left, color=showEntryLvls ? slCol : color.new(slCol, 100), textcolor=color.white, size=size.small))
    array.push(tpLabels, label.new(rightBar, tp, tTxt, style=label.style_label_left, color=showEntryLvls ? tpCol : color.new(tpCol, 100), textcolor=color.white, size=size.small))

    side = newDir == 1 ? "LONG" : "SHORT"
    array.push(tagLabels, label.new(bar_index, newDir == 1 ? zoneTop : zoneBot, "TRH " + side + "\nR:R " + str.tostring(riskReward, "#.##"), style=newDir == 1 ? label.style_label_down : label.style_label_up, color=newDir == 1 ? #1565C0 : #B71C1C, textcolor=color.white, size=size.small))

    array.push(sDir, newDir)
    array.push(sEntry, entry)
    array.push(sSl, sl)
    array.push(sTp, tp)
    array.push(sProx, newProx)
    array.push(sDist, newDist)
    array.push(sStartBar, bar_index)
    array.push(sStatus, 0)
    array.push(sAlertedIn, false)

    if newDir == 1
        lastBullZoneBar := bar_index
    else
        lastBearZoneBar := bar_index

    // Trim oldest
    while array.size(sDir) > maxSetupsKeep
        box.delete(array.shift(zoneBoxes))
        line.delete(array.shift(entryLines))
        line.delete(array.shift(slLines))
        line.delete(array.shift(tpLines))
        label.delete(array.shift(entryLabels))
        label.delete(array.shift(slLabels))
        label.delete(array.shift(tpLabels))
        label.delete(array.shift(tagLabels))
        array.shift(sDir)
        array.shift(sEntry)
        array.shift(sSl)
        array.shift(sTp)
        array.shift(sProx)
        array.shift(sDist)
        array.shift(sStartBar)
        array.shift(sStatus)
        array.shift(sAlertedIn)

    if alertOnZone
        alert("TRH " + side + " zone | ENTRY " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// Manage setups
n = array.size(sDir)
if n > 0
    for i = 0 to n - 1
        st = array.get(sStatus, i)
        if st < 2
            dir = array.get(sDir, i)
            entry = array.get(sEntry, i)
            sl = array.get(sSl, i)
            tp = array.get(sTp, i)
            prox = array.get(sProx, i)
            dist = array.get(sDist, i)
            startB = array.get(sStartBar, i)
            zoneTop = math.max(prox, dist)
            zoneBot = math.min(prox, dist)
            rightB = math.max(bar_index, startB + setupWidthBars)

            box.set_right(array.get(zoneBoxes, i), rightB)
            line.set_x2(array.get(entryLines, i), rightB)
            line.set_x2(array.get(slLines, i), rightB)
            line.set_x2(array.get(tpLines, i), rightB)
            label.set_x(array.get(entryLabels, i), rightB)
            label.set_x(array.get(slLabels, i), rightB)
            label.set_x(array.get(tpLabels, i), rightB)

            if st == 0 and bar_index - startB > setupWidthBars * 3
                array.set(sStatus, i, 4)
                box.set_bgcolor(array.get(zoneBoxes, i), color.new(color.gray, 85))
            else
                if st == 0 and low <= zoneTop and high >= zoneBot
                    array.set(sStatus, i, 1)
                    signalDir := dir
                    activeEntry := entry
                    activeSl := sl
                    activeTp := tp
                    if not array.get(sAlertedIn, i)
                        array.set(sAlertedIn, i, true)
                        label.new(bar_index, entry, "▶ ENTRY", style=label.style_label_center, color=dir == 1 ? #1565C0 : #B71C1C, textcolor=color.white, size=size.normal)
                        if alertOnEntry
                            alert("TRH ENTRY " + (dir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

                if array.get(sStatus, i) == 1
                    hitTp = dir == 1 ? high >= tp : low <= tp
                    hitSl = dir == 1 ? low <= sl : high >= sl
                    if hitTp
                        array.set(sStatus, i, 2)
                        box.set_bgcolor(array.get(zoneBoxes, i), color.new(#43A047, 70))
                        label.new(bar_index, tp, "✓ TP EXIT", style=label.style_label_center, color=#43A047, textcolor=color.white, size=size.normal)
                        if alertOnExit
                            alert("TRH TAKE PROFIT @ " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
                    else if hitSl
                        array.set(sStatus, i, 3)
                        box.set_bgcolor(array.get(zoneBoxes, i), color.new(#E53935, 70))
                        label.new(bar_index, sl, "✗ SL EXIT", style=label.style_label_center, color=#E53935, textcolor=color.white, size=size.normal)
                        if alertOnExit
                            alert("TRH STOP LOSS @ " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)

plotshape(displayMode == "Signal" and signalDir == 1, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=#43A047, size=size.small, text="TRH BUY")
plotshape(displayMode == "Signal" and signalDir == -1, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=#E53935, size=size.small, text="TRH SELL")

plot(activeEntry, "Active Entry", color=entryCol, display=display.data_window)
plot(activeSl, "Active SL", color=slCol, display=display.data_window)
plot(activeTp, "Active TP", color=tpCol, display=display.data_window)

// Exact levels table
var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(#111111, 10), border_width=1, border_color=color.new(color.white, 70))

if barstate.islast
    if array.size(sDir) > 0
        idx = array.size(sDir) - 1
        found = false
        for j = array.size(sDir) - 1 to 0
            if not found and array.get(sStatus, j) <= 1
                idx := j
                found := true
        dir = array.get(sDir, idx)
        st = array.get(sStatus, idx)
        stTxt = st == 0 ? "WAIT RETEST" : st == 1 ? "IN TRADE" : st == 2 ? "TP HIT" : st == 3 ? "SL HIT" : "EXPIRED"
        e = array.get(sEntry, idx)
        s = array.get(sSl, idx)
        t = array.get(sTp, idx)
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, (dir == 1 ? "LONG" : "SHORT") + " · " + stTxt, text_color=dir == 1 ? #81C784 : #E57373, text_size=size.small)
        table.cell(info, 0, 1, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, str.tostring(e, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "SL", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, str.tostring(s, format.mintick), text_color=#EF9A9A, text_size=size.small)
        table.cell(info, 0, 3, "TP", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, str.tostring(t, format.mintick), text_color=#A5D6A7, text_size=size.small)
        table.cell(info, 0, 4, "Risk", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, str.tostring(math.abs(e - s), format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 5, "Reward", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, str.tostring(math.abs(t - e), format.mintick) + " (" + str.tostring(riskReward, "#.##") + "R)", text_color=color.white, text_size=size.small)
    else
        table.cell(info, 0, 0, "TRH", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, "scanning…", text_color=color.gray, text_size=size.small)

alertcondition(bullBos or bullSweep, title="TRH Bullish Zone Created", message="TRH bullish zone — place limit at ENTRY")
alertcondition(bearBos or bearSweep, title="TRH Bearish Zone Created", message="TRH bearish zone — place limit at ENTRY")
alertcondition(signalDir == 1, title="TRH Long Entry", message="TRH LONG entry — price revisited the room")
alertcondition(signalDir == -1, title="TRH Short Entry", message="TRH SHORT entry — price revisited the room")
