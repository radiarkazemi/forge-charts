//@version=5
indicator("LH · Liquidity Hunter", overlay=true, max_boxes_count=50, max_lines_count=100, max_labels_count=50)

// Liquidity Hunter — our strategy
// 1) Map BSL/SSL  2) Raid  3) CISD  4) MSS/BOS  5) FVG entry  6) SL beyond raid · TP opposing liq

pivotPeriod      = input.int(5, "Pivot Period", minval=2, group="Detection")
minSweepAtr      = input.float(0.05, "Min Sweep Beyond Pivot (ATRx)", step=0.01, group="Detection")
minDispAtr       = input.float(0.40, "Min Structure Displacement (ATRx)", step=0.05, group="Detection")
minFvgAtr        = input.float(0.10, "Min FVG Size (ATRx)", step=0.01, group="Detection")
maxCisdBars      = input.int(8, "Max Bars After Raid For CISD", group="Detection")
maxStructBars    = input.int(12, "Max Bars After CISD For MSS/BOS", group="Detection")
maxFvgBars       = input.int(10, "Max Bars After Structure For FVG", group="Detection")
requireCisd      = input.bool(true, "Require CISD", group="Detection")
allowBos         = input.bool(true, "Allow Internal BOS (else MSS only)", group="Detection")
requireFvgRetest = input.bool(true, "Wait For FVG Retest", group="Detection")
maxRetestBars    = input.int(10, "Max Bars For Retest", group="Detection")
cooldownBars     = input.int(40, "Cooldown Between Setups", group="Detection")

slPadAtr         = input.float(0.08, "SL Pad Beyond Sweep (ATRx)", step=0.01, group="Entry / SL / TP")
riskReward       = input.float(3.0, "Fallback RR", step=0.1, group="Entry / SL / TP")
useOpposingLiq   = input.bool(true, "TP = Opposing Liquidity", group="Entry / SL / TP")
liqExtendAtr     = input.float(1.5, "Min Dist To Opposing Liq (ATRx)", step=0.1, group="Entry / SL / TP")

onlyLast         = input.bool(true, "Only Last Setup", group="Display")
historyCount     = input.int(4, "History Count", minval=1, maxval=12, group="Display")
showLiqPivots    = input.bool(true, "Mark Active BSL/SSL", group="Display")
showFvg          = input.bool(true, "Show FVG Box", group="Display")
showLevels       = input.bool(true, "Show ENTRY / SL / TP lines", group="Display")
showLevelLabels  = input.bool(true, "Show ENTRY / SL / TP price labels", group="Display")
longCol          = input.color(color.new(#26A69A, 0), "Long", group="Display")
shortCol         = input.color(color.new(#EF5350, 0), "Short", group="Display")
entryCol         = input.color(color.new(#B0BEC5, 0), "Entry line", group="Display")

atr = ta.atr(14)
ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float[] pivHiPx = array.new_float()
var int[]   pivHiBar = array.new_int()
var float[] pivLoPx = array.new_float()
var int[]   pivLoBar = array.new_int()

f_push(float[] px, int[] br, float p, int b) =>
    array.push(px, p)
    array.push(br, b)
    if array.size(px) > 40
        array.shift(px)
        array.shift(br)

if not na(ph)
    f_push(pivHiPx, pivHiBar, ph, bar_index - pivotPeriod)
if not na(pl)
    f_push(pivLoPx, pivLoBar, pl, bar_index - pivotPeriod)

f_lastPivot(float[] px, int[] br, int before, int lookback, int minAge) =>
    float out = na
    bool done = false
    int n = array.size(px)
    if n > 0
        for i = n - 1 to 0
            if not done
                int b = array.get(br, i)
                age = before - b
                if b < before and age >= minAge
                    if age > lookback
                        done := true
                    else
                        out := array.get(px, i)
                        done := true
    out

f_nextHi(float from, float minDist) =>
    float out = na
    int n = array.size(pivHiPx)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(pivHiPx, i)
            if p > from + minDist
                out := na(out) ? p : math.min(out, p)
    out

f_nextLo(float from, float minDist) =>
    float out = na
    int n = array.size(pivLoPx)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(pivLoPx, i)
            if p < from - minDist
                out := na(out) ? p : math.max(out, p)
    out

// State machine (confirmed on closed bar via barstate.isconfirmed)
var int phase = 0
var int pendDir = 0
var float sweepPx = na
var float sweepExt = na
var float cisdLevel = na
var float mssLevel = na
var float fvgTop = na
var float fvgBot = na
var int sweepBar = na
var int cisdBar = na
var int mssBar = na
var int fvgBar = na
var int structType = 0
var int lastSetupBar = -9999

var float setupEntry = na
var float setupSl = na
var float setupTp = na
var int setupDir = 0
var int setupBar = na
var float setupFvgTop = na
var float setupFvgBot = na
var string setupTag = ""

type Setup
    int dir
    float entry
    float sl
    float tp
    float fvgTop
    float fvgBot
    int bar
    string tag

var Setup[] history = array.new<Setup>()

f_emit(int dir, float entry, float sl, float tp, float ft, float fb, int bar, string tag) =>
    Setup s = Setup.new(dir, entry, sl, tp, ft, fb, bar, tag)
    array.push(history, s)
    if array.size(history) > 20
        array.shift(history)
    true

huntLo = f_lastPivot(pivLoPx, pivLoBar, bar_index, 100, pivotPeriod)
huntHi = f_lastPivot(pivHiPx, pivHiBar, bar_index, 100, pivotPeriod)

if barstate.isconfirmed
    if phase == 1 and not na(sweepBar) and (bar_index - sweepBar) > maxCisdBars
        phase := 0
        pendDir := 0
    if phase == 2 and not na(cisdBar) and (bar_index - cisdBar) > maxStructBars
        phase := 0
        pendDir := 0
    if phase == 3 and not na(mssBar) and (bar_index - mssBar) > maxFvgBars
        phase := 0
        pendDir := 0
    if phase == 4 and not na(fvgBar) and (bar_index - fvgBar) > maxRetestBars
        phase := 0
        pendDir := 0

    canStart = phase == 0 and (bar_index - lastSetupBar >= cooldownBars)
    a = atr

    sslRaid = canStart and not na(huntLo) and low < huntLo - a * minSweepAtr and close > huntLo
    bslRaid = canStart and not na(huntHi) and high > huntHi + a * minSweepAtr and close < huntHi

    if sslRaid
        phase := requireCisd ? 1 : 2
        pendDir := 1
        sweepPx := huntLo
        sweepExt := low
        sweepBar := bar_index
        cisdLevel := open
        cisdBar := requireCisd ? na : bar_index
        mssLevel := huntHi
        mssBar := na
        fvgBar := na
        structType := 0
    else if bslRaid
        phase := requireCisd ? 1 : 2
        pendDir := -1
        sweepPx := huntHi
        sweepExt := high
        sweepBar := bar_index
        cisdLevel := open
        cisdBar := requireCisd ? na : bar_index
        mssLevel := huntLo
        mssBar := na
        fvgBar := na
        structType := 0

    if phase != 0
        if pendDir == 1
            sweepExt := math.min(sweepExt, low)
        else
            sweepExt := math.max(sweepExt, high)

        body = math.abs(close - open)

        // CISD
        if phase == 1
            cisdOk = pendDir == 1 ? (close > cisdLevel and close > open) : (close < cisdLevel and close < open)
            if cisdOk
                cisdBar := bar_index
                phase := 2

        // MSS / BOS
        if phase == 2 and (na(cisdBar) ? bar_index > sweepBar : bar_index > cisdBar)
            float mssRef = na
            float bosRef = na
            bool hitMss = false
            bool hitBos = false
            if pendDir == 1
                mx = high
                barsBack = math.min(bar_index - sweepBar, 30)
                if barsBack > 0
                    for k = 0 to barsBack
                        mx := math.max(mx, high[k])
                mssRef := na(mssLevel) ? mx : mssLevel
                hitMss := close > mssRef and close > open and body >= a * minDispAtr
                bosRef := f_lastPivot(pivHiPx, pivHiBar, bar_index, math.max(bar_index - sweepBar + 2, 5), 1)
                hitBos := allowBos and not na(bosRef) and bosRef > sweepPx and close > bosRef and close > open and body >= a * minDispAtr * 0.75
            else
                mn = low
                barsBack = math.min(bar_index - sweepBar, 30)
                if barsBack > 0
                    for k = 0 to barsBack
                        mn := math.min(mn, low[k])
                mssRef := na(mssLevel) ? mn : mssLevel
                hitMss := close < mssRef and close < open and body >= a * minDispAtr
                bosRef := f_lastPivot(pivLoPx, pivLoBar, bar_index, math.max(bar_index - sweepBar + 2, 5), 1)
                hitBos := allowBos and not na(bosRef) and bosRef < sweepPx and close < bosRef and close < open and body >= a * minDispAtr * 0.75
            if hitMss or hitBos
                mssLevel := hitMss ? mssRef : bosRef
                structType := hitMss ? 1 : 2
                mssBar := bar_index
                phase := 3

        // FVG
        if phase == 3 and bar_index >= mssBar and bar_index >= 2
            found = false
            ft = 0.0
            fb = 0.0
            if pendDir == 1
                bot = high[2]
                top = low
                if top - bot >= a * minFvgAtr
                    fb := bot
                    ft := top
                    found := true
            else
                top = low[2]
                bot = high
                if top - bot >= a * minFvgAtr
                    fb := bot
                    ft := top
                    found := true
            if found
                fvgTop := ft
                fvgBot := fb
                fvgBar := bar_index
                if requireFvgRetest
                    phase := 4
                else
                    entry = (ft + fb) * 0.5
                    if cisdLevel >= fb and cisdLevel <= ft
                        entry := cisdLevel
                    pad = a * slPadAtr
                    if pendDir == 1
                        sl = sweepExt - pad
                        if entry > sl
                            risk = entry - sl
                            tp = entry + risk * riskReward
                            liq = f_nextHi(entry, a * liqExtendAtr)
                            if useOpposingLiq and not na(liq)
                                tp := math.max(tp, liq)
                            tag = structType == 2 ? "BOS" : "MSS"
                            f_emit(1, entry, sl, tp, ft, fb, bar_index, tag)
                            setupEntry := entry
                            setupSl := sl
                            setupTp := tp
                            setupDir := 1
                            setupBar := bar_index
                            setupFvgTop := ft
                            setupFvgBot := fb
                            setupTag := tag
                            lastSetupBar := bar_index
                    else
                        sl = sweepExt + pad
                        if sl > entry
                            risk = sl - entry
                            tp = entry - risk * riskReward
                            liq = f_nextLo(entry, a * liqExtendAtr)
                            if useOpposingLiq and not na(liq)
                                tp := math.min(tp, liq)
                            tag = structType == 2 ? "BOS" : "MSS"
                            f_emit(-1, entry, sl, tp, ft, fb, bar_index, tag)
                            setupEntry := entry
                            setupSl := sl
                            setupTp := tp
                            setupDir := -1
                            setupBar := bar_index
                            setupFvgTop := ft
                            setupFvgBot := fb
                            setupTag := tag
                            lastSetupBar := bar_index
                    phase := 0
                    pendDir := 0

        // Retest
        if phase == 4 and bar_index > fvgBar
            confirmed = false
            if pendDir == 1
                retested = low <= fvgTop and low >= fvgBot - a * 0.05
                confirmed := retested and close > open and close >= (fvgBot + fvgTop) * 0.5
            else
                retested = high >= fvgBot and high <= fvgTop + a * 0.05
                confirmed := retested and close < open and close <= (fvgBot + fvgTop) * 0.5
            if confirmed
                entry = (fvgTop + fvgBot) * 0.5
                if cisdLevel >= fvgBot and cisdLevel <= fvgTop
                    entry := cisdLevel
                pad = a * slPadAtr
                if pendDir == 1
                    sl = sweepExt - pad
                    if entry > sl
                        risk = entry - sl
                        tp = entry + risk * riskReward
                        liq = f_nextHi(entry, a * liqExtendAtr)
                        if useOpposingLiq and not na(liq)
                            tp := math.max(tp, liq)
                        tag = structType == 2 ? "BOS" : "MSS"
                        f_emit(1, entry, sl, tp, fvgTop, fvgBot, bar_index, tag)
                        setupEntry := entry
                        setupSl := sl
                        setupTp := tp
                        setupDir := 1
                        setupBar := bar_index
                        setupFvgTop := fvgTop
                        setupFvgBot := fvgBot
                        setupTag := tag
                        lastSetupBar := bar_index
                else
                    sl = sweepExt + pad
                    if sl > entry
                        risk = sl - entry
                        tp = entry - risk * riskReward
                        liq = f_nextLo(entry, a * liqExtendAtr)
                        if useOpposingLiq and not na(liq)
                            tp := math.min(tp, liq)
                        tag = structType == 2 ? "BOS" : "MSS"
                        f_emit(-1, entry, sl, tp, fvgTop, fvgBot, bar_index, tag)
                        setupEntry := entry
                        setupSl := sl
                        setupTp := tp
                        setupDir := -1
                        setupBar := bar_index
                        setupFvgTop := fvgTop
                        setupFvgBot := fvgBot
                        setupTag := tag
                        lastSetupBar := bar_index
                phase := 0
                pendDir := 0

// Active liquidity levels (last confirmed pivots)
plot(showLiqPivots ? huntHi : na, "BSL", color=color.new(shortCol, 50), style=plot.style_linebr, linewidth=1)
plot(showLiqPivots ? huntLo : na, "SSL", color=color.new(longCol, 50), style=plot.style_linebr, linewidth=1)

nHist = array.size(history)

// Keep last setup vars synced from history (panel + plots always show latest)
if barstate.islast and nHist > 0
    Setup lastS = array.get(history, nHist - 1)
    setupEntry := lastS.entry
    setupSl := lastS.sl
    setupTp := lastS.tp
    setupDir := lastS.dir
    setupBar := lastS.bar
    setupFvgTop := lastS.fvgTop
    setupFvgBot := lastS.fvgBot
    setupTag := lastS.tag

// Persistent ENTRY / SL / TP plots for the last setup
plot(showLevels and not na(setupEntry) ? setupEntry : na, "ENTRY", color=entryCol, linewidth=2, style=plot.style_linebr)
plot(showLevels and not na(setupSl) ? setupSl : na, "SL", color=shortCol, linewidth=2, style=plot.style_linebr)
plot(showLevels and not na(setupTp) ? setupTp : na, "TP", color=longCol, linewidth=2, style=plot.style_linebr)

var box[] drawBoxes = array.new_box()
var line[] drawLines = array.new_line()
var label[] drawLabels = array.new_label()

if barstate.islast and nHist > 0
    // clear previous drawings
    if array.size(drawBoxes) > 0
        for i = 0 to array.size(drawBoxes) - 1
            box.delete(array.get(drawBoxes, i))
        array.clear(drawBoxes)
    if array.size(drawLines) > 0
        for i = 0 to array.size(drawLines) - 1
            line.delete(array.get(drawLines, i))
        array.clear(drawLines)
    if array.size(drawLabels) > 0
        for i = 0 to array.size(drawLabels) - 1
            label.delete(array.get(drawLabels, i))
        array.clear(drawLabels)

    // Always draw the LAST setup prominently
    Setup last = array.get(history, nHist - 1)
    sideCol = last.dir == 1 ? longCol : shortCol
    sideTxt = last.dir == 1 ? "LONG" : "SHORT"
    if showFvg
        array.push(drawBoxes, box.new(last.bar, last.fvgTop, bar_index + 8, last.fvgBot, bgcolor=color.new(sideCol, 82), border_color=color.new(sideCol, 40), border_width=1))

    // Side banner at setup bar
    array.push(drawLabels, label.new(last.bar, last.dir == 1 ? last.fvgTop : last.fvgBot, "LH " + sideTxt + " · " + last.tag, style=last.dir == 1 ? label.style_label_down : label.style_label_up, color=sideCol, textcolor=color.white, size=size.normal))

    // Right-edge price labels: ENTRY / SL / TP
    if showLevelLabels
        array.push(drawLabels, label.new(bar_index + 2, last.entry, "ENTRY  " + str.tostring(last.entry, format.mintick), style=label.style_label_left, color=color.new(entryCol, 10), textcolor=color.black, size=size.normal))
        array.push(drawLabels, label.new(bar_index + 2, last.sl, "SL  " + str.tostring(last.sl, format.mintick), style=label.style_label_left, color=color.new(shortCol, 10), textcolor=color.white, size=size.normal))
        array.push(drawLabels, label.new(bar_index + 2, last.tp, "TP  " + str.tostring(last.tp, format.mintick), style=label.style_label_left, color=color.new(longCol, 10), textcolor=color.white, size=size.normal))

    // Optional older history (fainter)
    if not onlyLast and nHist > 1
        start = math.max(0, nHist - historyCount)
        endHist = nHist - 2
        if endHist >= start
            for i = start to endHist
                s = array.get(history, i)
                col = s.dir == 1 ? longCol : shortCol
                if showFvg
                    array.push(drawBoxes, box.new(s.bar, s.fvgTop, s.bar + 12, s.fvgBot, bgcolor=color.new(col, 92), border_color=color.new(col, 70)))
                array.push(drawLabels, label.new(s.bar, s.dir == 1 ? s.fvgTop : s.fvgBot, (s.dir == 1 ? "L" : "S") + " · " + s.tag, style=label.style_label_down, color=color.new(col, 50), textcolor=color.white, size=size.tiny))

var table panel = table.new(position.top_left, 2, 8, bgcolor=color.new(#0D1117, 5), border_width=1, border_color=color.new(#30363D, 0), frame_color=color.new(#30363D, 0), frame_width=1)
if barstate.islast
    if na(setupEntry) or setupDir == 0
        table.cell(panel, 0, 0, "LH · Liquidity Hunter", text_color=color.white, text_size=size.normal)
        table.merge_cells(panel, 0, 0, 1, 0)
        table.cell(panel, 0, 1, "Waiting for setup…", text_color=color.gray, text_size=size.small)
        table.merge_cells(panel, 0, 1, 1, 1)
    else
        risk = math.abs(setupEntry - setupSl)
        rr = risk > 0 ? math.abs(setupTp - setupEntry) / risk : 0
        liveR = risk > 0 ? (setupDir == 1 ? (close - setupEntry) / risk : (setupEntry - close) / risk) : 0
        sideCol = setupDir == 1 ? longCol : shortCol
        sideTxt = setupDir == 1 ? "LONG" : "SHORT"

        table.cell(panel, 0, 0, "LH · Liquidity Hunter", text_color=color.white, text_size=size.normal)
        table.merge_cells(panel, 0, 0, 1, 0)

        table.cell(panel, 0, 1, "POSITION", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 1, sideTxt, text_color=sideCol, text_size=size.large)

        table.cell(panel, 0, 2, "SETUP", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 2, "RAID→CISD→" + setupTag + "→FVG", text_color=sideCol, text_size=size.small)

        table.cell(panel, 0, 3, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 3, str.tostring(setupEntry, format.mintick), text_color=color.white, text_size=size.normal)

        table.cell(panel, 0, 4, "SL", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 4, str.tostring(setupSl, format.mintick), text_color=shortCol, text_size=size.normal)

        table.cell(panel, 0, 5, "TP", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 5, str.tostring(setupTp, format.mintick) + "  (" + str.tostring(rr, "#.0") + "R)", text_color=longCol, text_size=size.normal)

        table.cell(panel, 0, 6, "LIVE", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 6, str.tostring(liveR, "#.00") + "R", text_color=liveR >= 0 ? longCol : shortCol, text_size=size.normal)

        table.cell(panel, 0, 7, "Liquidity first — don't become liquidity", text_color=color.new(color.gray, 20), text_size=size.tiny)
        table.merge_cells(panel, 0, 7, 1, 7)

alertcondition(not na(setupEntry) and setupBar == bar_index, "LH New Setup", "Liquidity Hunter setup")
