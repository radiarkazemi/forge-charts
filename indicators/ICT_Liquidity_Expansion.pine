//@version=5
indicator("ICT Liquidity Expansion", shorttitle="ICT", overlay=true, max_boxes_count=60, max_lines_count=100, max_labels_count=100, max_bars_back=5000)

// PARKED — side #2 on hold for now (focus: CRT OrderFlow exact source model).
// ICT: Raid SSL/BSL → MSS (displacement) → FVG → ENTRY (retest optional)
// Standalone — not TRH / not CRT

grp = "ICT Detection"
pivotPeriod     = input.int(5, "Pivot Period", minval=2, maxval=20, group=grp)
minSweepAtr     = input.float(0.05, "Min Raid Beyond Pivot (ATR×)", step=0.01, group=grp)
minDispAtr      = input.float(0.40, "Min MSS Displacement Body (ATR×)", step=0.05, group=grp)
minFvgAtr       = input.float(0.10, "Min FVG Size (ATR×)", step=0.01, group=grp)
maxMssBars      = input.int(12, "Max Bars Sweep → MSS", minval=2, group=grp)
maxFvgBars      = input.int(10, "Max Bars MSS → FVG", minval=2, group=grp)
requireRetest   = input.bool(true, "Require FVG Retest", group=grp)
maxRetestBars   = input.int(10, "Max Bars For Retest", minval=1, group=grp)
cooldownBars    = input.int(40, "Cooldown Between Setups", group=grp)

grpPos = "Entry / SL / TP"
slPadAtr        = input.float(0.08, "SL Pad (ATR×)", step=0.01, group=grpPos)
riskReward      = input.float(3.0, "Fallback Risk-Reward", step=0.1, group=grpPos)
useOpposingLiq  = input.bool(true, "Prefer Opposing Liquidity TP", group=grpPos)
liqExtendAtr    = input.float(1.5, "Min Opposing Liq Distance (ATR×)", step=0.1, group=grpPos)

grpDisp = "Display"
onlyLast        = input.bool(true, "Only Last Setup", group=grpDisp)
setupWidth      = input.int(80, "Box Width (bars)", minval=20, group=grpDisp)
extendLive      = input.bool(true, "Extend Until TP/SL", group=grpDisp)
showFillMark    = input.bool(true, "Show ENTRY/TP/SL Markers", group=grpDisp)
showRaidMarks   = input.bool(true, "Show Raid Dots", group=grpDisp)
showPanel       = input.bool(true, "Info Panel", group=grpDisp)

grpCol = "Colors"
bullZoneCol = input.color(color.new(#26A69A, 82), "Long FVG Zone", group=grpCol)
bearZoneCol = input.color(color.new(#EF5350, 82), "Short FVG Zone", group=grpCol)
entryCol    = input.color(#787B86, "Entry", group=grpCol)
slCol       = input.color(#EF5350, "SL", group=grpCol)
tpCol       = input.color(#26A69A, "TP", group=grpCol)

grpAlert = "Alerts"
alertOnSetup = input.bool(true, "Alert: setup", group=grpAlert)
alertEntry   = input.bool(true, "Alert: entry fill", group=grpAlert)
alertExit    = input.bool(true, "Alert: SL/TP", group=grpAlert)

atr = ta.atr(14)
ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float[] pivHi = array.new<float>()
var int[]   pivHiBar = array.new<int>()
var float[] pivLo = array.new<float>()
var int[]   pivLoBar = array.new<int>()

if not na(ph)
    array.push(pivHi, ph)
    array.push(pivHiBar, bar_index - pivotPeriod)
    while array.size(pivHi) > 40
        array.shift(pivHi)
        array.shift(pivHiBar)
if not na(pl)
    array.push(pivLo, pl)
    array.push(pivLoBar, bar_index - pivotPeriod)
    while array.size(pivLo) > 40
        array.shift(pivLo)
        array.shift(pivLoBar)

f_lastLo(maxAge) =>
    float best = na
    int bestB = na
    if array.size(pivLo) > 0
        for i = array.size(pivLo) - 1 to 0
            int b = array.get(pivLoBar, i)
            float px = array.get(pivLo, i)
            int age = bar_index - b
            if age >= pivotPeriod and age <= maxAge
                if na(best) or px <= best
                    best := px
                    bestB := b
    [best, bestB]

f_lastHi(maxAge) =>
    float best = na
    int bestB = na
    if array.size(pivHi) > 0
        for i = array.size(pivHi) - 1 to 0
            int b = array.get(pivHiBar, i)
            float px = array.get(pivHi, i)
            int age = bar_index - b
            if age >= pivotPeriod and age <= maxAge
                if na(best) or px >= best
                    best := px
                    bestB := b
    [best, bestB]

f_nextHi(fromPx, minDist) =>
    float best = na
    if array.size(pivHi) > 0
        for i = 0 to array.size(pivHi) - 1
            px = array.get(pivHi, i)
            if px >= fromPx + minDist
                if na(best) or px < best
                    best := px
    best

f_nextLo(fromPx, minDist) =>
    float best = na
    if array.size(pivLo) > 0
        for i = 0 to array.size(pivLo) - 1
            px = array.get(pivLo, i)
            if px <= fromPx - minDist
                if na(best) or px > best
                    best := px
    best

// phase: 0 idle, 1 wait MSS, 2 wait FVG, 3 wait retest
var int   phase = 0
var int   pendDir = 0
var float sweepPx = na
var float sweepExt = na
var float mssLevel = na
var float fvgTop = na
var float fvgBot = na
var int   sweepBar = na
var int   mssBar = na
var int   fvgBar = na
var int   lastSetupBar = na

var int   newDir = 0
var float newEntry = na
var float newSl = na
var float newTp = na
var float newProx = na
var float newDist = na
var float newMss = na

raidDot = false
raidDir = 0

newDir := 0

if barstate.isconfirmed
    [huntLo, huntLoB] = f_lastLo(100)
    [huntHi, huntHiB] = f_lastHi(100)
    float a = atr
    float body = math.abs(close - open)

    if phase == 1 and not na(sweepBar) and bar_index - sweepBar > maxMssBars
        phase := 0
        pendDir := 0
    if phase == 2 and not na(mssBar) and bar_index - mssBar > maxFvgBars
        phase := 0
        pendDir := 0
    if phase == 3 and not na(fvgBar) and bar_index - fvgBar > maxRetestBars
        phase := 0
        pendDir := 0

    bool coolOk = na(lastSetupBar) or bar_index - lastSetupBar >= cooldownBars
    bool canStart = phase == 0 and coolOk

    bool sslRaid = canStart and not na(huntLo) and low < huntLo - a * minSweepAtr and close > huntLo
    bool bslRaid = canStart and not na(huntHi) and high > huntHi + a * minSweepAtr and close < huntHi

    if sslRaid
        phase := 1
        pendDir := 1
        sweepPx := huntLo
        sweepExt := low
        sweepBar := bar_index
        mssLevel := huntHi
        mssBar := na
        fvgBar := na
        raidDot := true
        raidDir := 1
    else if bslRaid
        phase := 1
        pendDir := -1
        sweepPx := huntHi
        sweepExt := high
        sweepBar := bar_index
        mssLevel := huntLo
        mssBar := na
        fvgBar := na
        raidDot := true
        raidDir := -1

    if phase != 0
        if pendDir == 1 and low < sweepExt
            sweepExt := low
        if pendDir == -1 and high > sweepExt
            sweepExt := high

        // Phase 1: MSS
        if phase == 1 and bar_index > sweepBar
            if pendDir == 1
                float mx = high[math.max(1, bar_index - sweepBar)]
                // structure: highest high since sweep (excl current)
                float structHi = high[1]
                int look = math.min(bar_index - sweepBar, maxMssBars)
                if look > 1
                    structHi := ta.highest(high[1], look)
                if na(mssLevel) or mssLevel <= 0
                    mssLevel := structHi
                bool mss = close > mssLevel and close > open and body >= a * minDispAtr
                if mss
                    phase := 2
                    mssBar := bar_index
                    mssLevel := math.max(mssLevel, structHi)
            else
                float structLo = low[1]
                int look2 = math.min(bar_index - sweepBar, maxMssBars)
                if look2 > 1
                    structLo := ta.lowest(low[1], look2)
                if na(mssLevel) or mssLevel <= 0
                    mssLevel := structLo
                bool mss2 = close < mssLevel and close < open and body >= a * minDispAtr
                if mss2
                    phase := 2
                    mssBar := bar_index
                    mssLevel := math.min(mssLevel, structLo)

        // Phase 2: FVG
        if phase == 2 and bar_index >= mssBar and bar_index >= 2
            bool found = false
            float top = na
            float bot = na
            if pendDir == 1
                bot := high[2]
                top := low
                if top - bot >= a * minFvgAtr
                    found := true
            else
                top := low[2]
                bot := high
                if top - bot >= a * minFvgAtr
                    found := true
            if found
                fvgTop := top
                fvgBot := bot
                fvgBar := bar_index
                if requireRetest
                    phase := 3
                else
                    // fire now
                    float entry = (top + bot) * 0.5
                    float pad = a * slPadAtr
                    float sl = pendDir == 1 ? sweepExt - pad : sweepExt + pad
                    float risk = math.abs(entry - sl)
                    if risk > syminfo.mintick
                        float tp = pendDir == 1 ? entry + risk * riskReward : entry - risk * riskReward
                        if useOpposingLiq
                            if pendDir == 1
                                float liq = f_nextHi(entry, a * liqExtendAtr)
                                if not na(liq)
                                    tp := math.max(tp, liq)
                            else
                                float liq2 = f_nextLo(entry, a * liqExtendAtr)
                                if not na(liq2)
                                    tp := math.min(tp, liq2)
                        newDir := pendDir
                        newEntry := entry
                        newSl := sl
                        newTp := tp
                        newProx := top
                        newDist := bot
                        newMss := mssLevel
                        lastSetupBar := bar_index
                        phase := 0
                        pendDir := 0

        // Phase 3: retest FVG
        if phase == 3
            bool touched = low <= fvgTop and high >= fvgBot
            if touched
                float entry = (fvgTop + fvgBot) * 0.5
                float pad = a * slPadAtr
                float sl = pendDir == 1 ? sweepExt - pad : sweepExt + pad
                float risk = math.abs(entry - sl)
                if risk > syminfo.mintick
                    float tp = pendDir == 1 ? entry + risk * riskReward : entry - risk * riskReward
                    if useOpposingLiq
                        if pendDir == 1
                            float liq = f_nextHi(entry, a * liqExtendAtr)
                            if not na(liq)
                                tp := math.max(tp, liq)
                        else
                            float liq2 = f_nextLo(entry, a * liqExtendAtr)
                            if not na(liq2)
                                tp := math.min(tp, liq2)
                    newDir := pendDir
                    newEntry := entry
                    newSl := sl
                    newTp := tp
                    newProx := fvgTop
                    newDist := fvgBot
                    newMss := mssLevel
                    lastSetupBar := bar_index
                    phase := 0
                    pendDir := 0

plotshape(showRaidMarks and raidDot and raidDir == 1, title="SSL Raid", style=shape.triangleup, location=location.belowbar, color=color.new(#42A5F5, 20), size=size.tiny)
plotshape(showRaidMarks and raidDot and raidDir == -1, title="BSL Raid", style=shape.triangledown, location=location.abovebar, color=color.new(#AB47BC, 20), size=size.tiny)

// ── Drawings (last setup) ─────────────────────────────────────────────────
var box[]   bZone = array.new<box>()
var box[]   bTp = array.new<box>()
var box[]   bSl = array.new<box>()
var line[]  lEntry = array.new<line>()
var line[]  lSl = array.new<line>()
var line[]  lTp = array.new<line>()
var label[] labE = array.new<label>()
var label[] labS = array.new<label>()
var label[] labT = array.new<label>()
var label[] labTag = array.new<label>()
var label[] labEvt = array.new<label>()

var int[]   sDir = array.new<int>()
var float[] sEntry = array.new<float>()
var float[] sSl = array.new<float>()
var float[] sTp = array.new<float>()
var int[]   sBar = array.new<int>()
var int[]   sStat = array.new<int>()

var float activeE = na
var float activeS = na
var float activeT = na

f_clear() =>
    if array.size(bZone) > 0
        for i = 0 to array.size(bZone) - 1
            box.delete(array.get(bZone, i))
            box.delete(array.get(bTp, i))
            box.delete(array.get(bSl, i))
            line.delete(array.get(lEntry, i))
            line.delete(array.get(lSl, i))
            line.delete(array.get(lTp, i))
            label.delete(array.get(labE, i))
            label.delete(array.get(labS, i))
            label.delete(array.get(labT, i))
            label.delete(array.get(labTag, i))
            if i < array.size(labEvt)
                label.delete(array.get(labEvt, i))
    array.clear(bZone)
    array.clear(bTp)
    array.clear(bSl)
    array.clear(lEntry)
    array.clear(lSl)
    array.clear(lTp)
    array.clear(labE)
    array.clear(labS)
    array.clear(labT)
    array.clear(labTag)
    array.clear(labEvt)
    array.clear(sDir)
    array.clear(sEntry)
    array.clear(sSl)
    array.clear(sTp)
    array.clear(sBar)
    array.clear(sStat)

if newDir != 0
    if onlyLast and array.size(sDir) > 0
        f_clear()
    zTop = math.max(newProx, newDist)
    zBot = math.min(newProx, newDist)
    right = bar_index + setupWidth
    zcol = newDir == 1 ? bullZoneCol : bearZoneCol
    array.push(bZone, box.new(bar_index, zTop, right, zBot, bgcolor=zcol, border_color=color.new(zcol, 40), border_width=1))
    if newDir == 1
        array.push(bTp, box.new(bar_index, newTp, right, newEntry, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newEntry, right, newSl, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))
    else
        array.push(bTp, box.new(bar_index, newEntry, right, newTp, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newSl, right, newEntry, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))
    array.push(lEntry, line.new(bar_index, newEntry, right, newEntry, color=entryCol, width=2, style=line.style_dashed))
    array.push(lSl, line.new(bar_index, newSl, right, newSl, color=slCol, width=1, style=line.style_dashed))
    array.push(lTp, line.new(bar_index, newTp, right, newTp, color=tpCol, width=1, style=line.style_dashed))
    array.push(labE, label.new(right, newEntry, "ENTRY " + str.tostring(newEntry, format.mintick), style=label.style_label_left, color=entryCol, textcolor=color.white, size=size.small))
    array.push(labS, label.new(right, newSl, "SL " + str.tostring(newSl, format.mintick), style=label.style_label_left, color=slCol, textcolor=color.white, size=size.small))
    array.push(labT, label.new(right, newTp, "TP " + str.tostring(newTp, format.mintick), style=label.style_label_left, color=tpCol, textcolor=color.white, size=size.small))
    array.push(labTag, label.new(bar_index, newDir == 1 ? zTop : zBot, "ICT " + (newDir == 1 ? "LONG" : "SHORT") + "\nRaid→MSS→FVG · R:R " + str.tostring(riskReward, "#.#"), style=newDir == 1 ? label.style_label_down : label.style_label_up, color=newDir == 1 ? #1565C0 : #6A1B9A, textcolor=color.white, size=size.small))
    array.push(labEvt, na)
    array.push(sDir, newDir)
    array.push(sEntry, newEntry)
    array.push(sSl, newSl)
    array.push(sTp, newTp)
    array.push(sBar, bar_index)
    array.push(sStat, 0)
    already = newDir == 1 ? (low <= newEntry or close >= newEntry) : (high >= newEntry or close <= newEntry)
    if already
        array.set(sStat, array.size(sStat) - 1, 1)
        activeE := newEntry
        activeS := newSl
        activeT := newTp
        if showFillMark
            array.set(labEvt, array.size(labEvt) - 1, label.new(bar_index, newEntry, "▶ ENTRY", style=label.style_label_center, color=newDir == 1 ? #1565C0 : #6A1B9A, textcolor=color.white, size=size.normal))
        if alertEntry
            alert("ICT ENTRY " + (newDir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(newEntry, format.mintick), alert.freq_once_per_bar_close)
    if alertOnSetup
        alert("ICT " + (newDir == 1 ? "LONG" : "SHORT") + " SETUP | E " + str.tostring(newEntry, format.mintick) + " | SL " + str.tostring(newSl, format.mintick) + " | TP " + str.tostring(newTp, format.mintick), alert.freq_once_per_bar_close)

n = array.size(sDir)
if n > 0
    for i = 0 to n - 1
        st = array.get(sStat, i)
        if i < array.size(bZone) and not na(array.get(bZone, i)) and st <= 1
            dir = array.get(sDir, i)
            e = array.get(sEntry, i)
            s = array.get(sSl, i)
            t = array.get(sTp, i)
            startB = array.get(sBar, i)
            right = extendLive ? math.max(bar_index, startB + setupWidth) : startB + setupWidth
            box.set_right(array.get(bZone, i), right)
            box.set_right(array.get(bTp, i), right)
            box.set_right(array.get(bSl, i), right)
            line.set_x2(array.get(lEntry, i), right)
            line.set_x2(array.get(lSl, i), right)
            line.set_x2(array.get(lTp, i), right)
            label.set_x(array.get(labE, i), right)
            label.set_x(array.get(labS, i), right)
            label.set_x(array.get(labT, i), right)
            if st == 0
                hitE = dir == 1 ? low <= e : high >= e
                if hitE or (dir == 1 and close >= e) or (dir == -1 and close <= e)
                    array.set(sStat, i, 1)
                    activeE := e
                    activeS := s
                    activeT := t
                    if showFillMark and i < array.size(labEvt)
                        label.delete(array.get(labEvt, i))
                        array.set(labEvt, i, label.new(bar_index, e, "▶ ENTRY", style=label.style_label_center, color=dir == 1 ? #1565C0 : #6A1B9A, textcolor=color.white, size=size.normal))
                    if alertEntry
                        alert("ICT ENTRY @ " + str.tostring(e, format.mintick), alert.freq_once_per_bar_close)
            if array.get(sStat, i) == 1
                hitT = dir == 1 ? high >= t : low <= t
                hitS = dir == 1 ? low <= s : high >= s
                if hitT or hitS
                    array.set(sStat, i, hitT ? 2 : 3)
                    if showFillMark and i < array.size(labEvt)
                        label.delete(array.get(labEvt, i))
                        array.set(labEvt, i, label.new(bar_index, hitT ? t : s, hitT ? "✓ TP EXIT" : "✗ SL EXIT", style=label.style_label_center, color=hitT ? #26A69A : #EF5350, textcolor=color.white, size=size.normal))
                    if alertExit
                        alert((hitT ? "ICT TP EXIT @ " : "ICT SL EXIT @ ") + str.tostring(hitT ? t : s, format.mintick), alert.freq_once_per_bar_close)

plot(activeE, "ENTRY", color=entryCol, display=display.data_window)
plot(activeS, "SL", color=slCol, display=display.data_window)
plot(activeT, "TP", color=tpCol, display=display.data_window)

var table info = table.new(position.top_right, 2, 8, bgcolor=color.new(#111111, 5), border_width=1, border_color=color.new(color.white, 70))
if showPanel and barstate.islast
    phaseTxt = phase == 0 ? "idle" : phase == 1 ? "wait MSS" : phase == 2 ? "wait FVG" : "wait retest"
    if array.size(sDir) > 0
        idx = array.size(sDir) - 1
        dir = array.get(sDir, idx)
        st = array.get(sStat, idx)
        stTxt = st == 0 ? "WAIT FILL" : st == 1 ? "IN TRADE" : st == 2 ? "TP HIT" : "SL HIT"
        e = array.get(sEntry, idx)
        s = array.get(sSl, idx)
        t = array.get(sTp, idx)
        risk = math.abs(e - s)
        rew = math.abs(t - e)
        liveR = risk > 0 ? ((dir == 1 ? close - e : e - close) / risk) : 0.0
        if st == 2
            liveR := riskReward
        if st == 3
            liveR := -1.0
        table.cell(info, 0, 0, "ICT", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, (dir == 1 ? "LONG" : "SHORT") + " · " + stTxt, text_color=dir == 1 ? #69F0AE : #FF8A80, text_size=size.small)
        table.cell(info, 0, 1, "Model", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, "Raid → MSS → FVG", text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, str.tostring(e, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "SL", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, str.tostring(s, format.mintick), text_color=#FF8A80, text_size=size.small)
        table.cell(info, 0, 4, "TP", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, str.tostring(t, format.mintick), text_color=#69F0AE, text_size=size.small)
        table.cell(info, 0, 5, "Risk", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, str.tostring(risk, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 6, "Reward", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, str.tostring(rew, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 7, st <= 1 ? "Live" : "Final", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 7, str.tostring(liveR, "#.##") + "R", text_color=st == 3 ? #FF8A80 : #69F0AE, text_size=size.small)
    else
        table.cell(info, 0, 0, "ICT", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, "scanning · " + phaseTxt, text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 1, "Need", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, "Raid → MSS → FVG" + (requireRetest ? " → retest" : ""), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 3, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 6, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, "", text_color=color.gray, text_size=size.small)
