//@version=5
indicator("CRT OrderFlow", shorttitle="CRT OF", overlay=true, max_boxes_count=120, max_lines_count=150, max_labels_count=150, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// CRT OrderFlow — EXACT source model (STRATEGY / Instagram Jul 29)
// Sequence from the graphics:
//   1) Structure (swing high/low)
//   2) Break of Structure (BOS)
//   3) FVG = Area of Interest (AOI) after the break
//   4) CRT Bias = ≥N CRT models same direction into that FVG
//   5) Entry on CRT confirm inside FVG → delivery
//
// RunRox tools on the source images were VISUALIZATION ONLY:
//   • MTF FVG [RunRox]  — multi-TF FVG boxes (15m / 30m / 1H)
//   • RunRox Entry Model — M1 dots / entry areas (not this strategy)
// This script is NOT a RunRox product.
// ICT Liquidity Expansion is parked for now.
// ═══════════════════════════════════════════════════════════════════════════

grpSeq = "1) Structure → BOS"
pivotLen     = input.int(5, "Structure Pivot Length", minval=2, maxval=20, group=grpSeq)
bosBufferAtr = input.float(0.02, "BOS Beyond Structure (ATR×)", step=0.01, group=grpSeq)
bosLookback  = input.int(80, "Max Bars Structure → BOS", group=grpSeq)

grpCrt = "2) CRT Model + Bias"
rcLookback       = input.int(3, "RC Lookback", minval=1, maxval=8, group=grpCrt)
minSweepAtr      = input.float(0.08, "Min CRT Sweep ATR", step=0.01, group=grpCrt)
minRcRangeAtr    = input.float(0.25, "Min RC Range ATR", step=0.05, group=grpCrt)
requireCloseBack = input.bool(true, "CRT Close Back Into RC", group=grpCrt)
requireCloseMid  = input.bool(true, "CRT Close Beyond RC Mid", group=grpCrt)
minBiasModels    = input.int(2, "Min CRT Same Dir (CRT Bias)", minval=1, maxval=5, group=grpCrt,
     tooltip="Source shows stacked CRT Bias (1,2,3). Default ≥2.")
biasLookback     = input.int(40, "Bias Lookback Bars", group=grpCrt)
minCrtGapBars    = input.int(5, "Min Bars Between CRT Marks", minval=1, group=grpCrt)
cooldownBars     = input.int(10, "Cooldown Between Setups", group=grpCrt)

grpFvg = "3) FVG AOI (like MTF FVG on source chart)"
useMtfFvg   = input.bool(true, "Use Multi-TF FVG AOI (15m+30m+1H)", group=grpFvg,
     tooltip="Matches RunRox MTF FVG look on the source: AOI from higher TFs on LTF chart.")
autoSingleHtf = input.bool(true, "If Multi off: Auto HTF (1m→5m…)", group=grpFvg)
htfManual   = input.timeframe("15", "Single HTF (if Multi+Auto off)", group=grpFvg)
minFvgAtr   = input.float(0.05, "Min FVG ATR", step=0.01, group=grpFvg)
mitigateCloseOnly = input.bool(true, "Mitigate FVG on Close Only", group=grpFvg)
maxAoiKeep  = input.int(12, "Max Live AOI", minval=1, maxval=40, group=grpFvg)
requireBosBeforeFvg = input.bool(true, "FVG Must Follow BOS Same Dir", group=grpFvg)
crtMustTouchFvg = input.bool(true, "CRT Must Touch FVG AOI", group=grpFvg)

grpRisk = "4) Entry / SL / TP"
slPadAtr   = input.float(0.06, "SL Pad ATR", step=0.01, group=grpRisk)
riskReward = input.float(2.5, "Risk Reward", step=0.1, group=grpRisk)
tpToStructure = input.bool(true, "Prefer Next Structure As TP", group=grpRisk)

grpDisp = "Display"
onlyLast       = input.bool(true, "Only Last Setup", group=grpDisp)
setupWidth     = input.int(80, "Box Width (bars)", minval=20, group=grpDisp)
extendLive     = input.bool(true, "Extend Until TP/SL", group=grpDisp)
showStructure  = input.bool(true, "Show Structure Lines", group=grpDisp)
showBosMark    = input.bool(true, "Show BOS Marks", group=grpDisp)
showCrtMarks   = input.bool(true, "Show CRT Bias Dots + Numbers", group=grpDisp)
showAoiBox     = input.bool(true, "Show FVG AOI Boxes", group=grpDisp)
maxAoiDraw     = input.int(4, "Max AOI Boxes Drawn", minval=1, maxval=12, group=grpDisp)
showFillMark   = input.bool(true, "Show ENTRY/TP/SL Markers", group=grpDisp)
showPanel      = input.bool(true, "Info Panel", group=grpDisp)

grpCol = "Colors"
structCol   = input.color(color.new(#42A5F5, 0), "Structure", group=grpCol)
bullZoneCol = input.color(color.new(#26A69A, 82), "Long Zone", group=grpCol)
bearZoneCol = input.color(color.new(#EF5350, 82), "Short Zone", group=grpCol)
fvgBullCol  = input.color(color.new(#42A5F5, 82), "Bull FVG AOI", group=grpCol)
fvgBearCol  = input.color(color.new(#AB47BC, 82), "Bear FVG AOI", group=grpCol)
entryCol    = input.color(#787B86, "Entry", group=grpCol)
slCol       = input.color(#EF5350, "SL", group=grpCol)
tpCol       = input.color(#26A69A, "TP", group=grpCol)

grpAlert = "Alerts"
alertOnSetup = input.bool(true, "Alert: CRT OrderFlow setup", group=grpAlert)
alertEntry   = input.bool(true, "Alert: entry fill", group=grpAlert)
alertExit    = input.bool(true, "Alert: SL/TP", group=grpAlert)

atr = ta.atr(14)

// ── Structure pivots ──────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float[] shPx = array.new_float()
var int[]   shBar = array.new_int()
var float[] slPx = array.new_float()
var int[]   slBar = array.new_int()
var line[]  structLines = array.new_line()

if not na(ph)
    array.push(shPx, ph)
    array.push(shBar, bar_index - pivotLen)
    while array.size(shPx) > 20
        array.shift(shPx)
        array.shift(shBar)
    if showStructure
        array.push(structLines, line.new(bar_index - pivotLen, ph, bar_index + 8, ph, color=structCol, style=line.style_dashed, width=1))
        while array.size(structLines) > 30
            line.delete(array.shift(structLines))
if not na(pl)
    array.push(slPx, pl)
    array.push(slBar, bar_index - pivotLen)
    while array.size(slPx) > 20
        array.shift(slPx)
        array.shift(slBar)
    if showStructure
        array.push(structLines, line.new(bar_index - pivotLen, pl, bar_index + 8, pl, color=color.new(#26A69A, 30), style=line.style_dashed, width=1))
        while array.size(structLines) > 30
            line.delete(array.shift(structLines))

f_lastStructHigh() =>
    float px = na
    int b = na
    if array.size(shPx) > 0
        px := array.get(shPx, array.size(shPx) - 1)
        b := array.get(shBar, array.size(shBar) - 1)
    [px, b]

f_lastStructLow() =>
    float px = na
    int b = na
    if array.size(slPx) > 0
        px := array.get(slPx, array.size(slPx) - 1)
        b := array.get(slBar, array.size(slBar) - 1)
    [px, b]

f_nextStructHigh(fromPx) =>
    float best = na
    if array.size(shPx) > 0
        for i = 0 to array.size(shPx) - 1
            p = array.get(shPx, i)
            if p > fromPx
                if na(best) or p < best
                    best := p
    best

f_nextStructLow(fromPx) =>
    float best = na
    if array.size(slPx) > 0
        for i = 0 to array.size(slPx) - 1
            p = array.get(slPx, i)
            if p < fromPx
                if na(best) or p > best
                    best := p
    best

// ── BOS state ─────────────────────────────────────────────────────────────
var int   lastBosDir = 0
var int   lastBosBar = na
var float lastBosLevel = na
bosNow = false
bosDirNow = 0

if barstate.isconfirmed
    [shi, shiB] = f_lastStructHigh()
    [slo, sloB] = f_lastStructLow()
    float buf = atr * bosBufferAtr
    if not na(shi) and not na(shiB) and bar_index - shiB <= bosLookback and close > shi + buf and close > open
        lastBosDir := 1
        lastBosBar := bar_index
        lastBosLevel := shi
        bosNow := true
        bosDirNow := 1
    if not na(slo) and not na(sloB) and bar_index - sloB <= bosLookback and close < slo - buf and close < open
        lastBosDir := -1
        lastBosBar := bar_index
        lastBosLevel := slo
        bosNow := true
        bosDirNow := -1

plotshape(showBosMark and bosNow and bosDirNow == 1, title="BOS Up", style=shape.xcross, location=location.belowbar, color=color.new(#42A5F5, 10), size=size.tiny)
plotshape(showBosMark and bosNow and bosDirNow == -1, title="BOS Dn", style=shape.xcross, location=location.abovebar, color=color.new(#AB47BC, 10), size=size.tiny)

// ── CRT detect ────────────────────────────────────────────────────────────
var int[]   crtBars  = array.new_int()
var int[]   crtDirs  = array.new_int()
var float[] crtSweep = array.new_float()
var float[] crtMid   = array.new_float()
var label[] crtLabs  = array.new_label()

crtFound = false
crtDirNow = 0

f_bias(int dir) =>
    int n = 0
    if array.size(crtBars) > 0
        for i = 0 to array.size(crtBars) - 1
            if bar_index - array.get(crtBars, i) <= biasLookback and array.get(crtDirs, i) == dir
                n += 1
    n

if barstate.isconfirmed
    float minPierce = math.max(atr * minSweepAtr, syminfo.mintick)
    float minRc = math.max(atr * minRcRangeAtr, syminfo.mintick * 5)
    bool foundNow = false
    int dirNow = 0
    float sweepNow = na
    float midNow = na

    for rc = 1 to rcLookback
        float rcH = high[rc]
        float rcL = low[rc]
        float rcMid = (rcH + rcL) * 0.5
        if rcH - rcL >= minRc
            // Classic CRT: RC at [rc], sweep on bars [0..rc-1] (incl. current), close back on [0]
            float bullExt = rcL
            int bullSw = -1
            for s = 0 to rc - 1
                if low[s] < rcL - minPierce
                    if bullSw < 0 or low[s] < bullExt
                        bullSw := s
                        bullExt := low[s]
            bool bullOk = bullSw >= 0
            if bullOk and requireCloseBack
                bullOk := close > rcL
            if bullOk and requireCloseMid
                bullOk := close >= rcMid
            if bullOk and close <= open
                bullOk := false

            float bearExt = rcH
            int bearSw = -1
            for s = 0 to rc - 1
                if high[s] > rcH + minPierce
                    if bearSw < 0 or high[s] > bearExt
                        bearSw := s
                        bearExt := high[s]
            bool bearOk = bearSw >= 0
            if bearOk and requireCloseBack
                bearOk := close < rcH
            if bearOk and requireCloseMid
                bearOk := close <= rcMid
            if bearOk and close >= open
                bearOk := false

            if bullOk and (not bearOk or close > open)
                foundNow := true
                dirNow := 1
                sweepNow := bullExt
                midNow := rcMid
                break
            if bearOk
                foundNow := true
                dirNow := -1
                sweepNow := bearExt
                midNow := rcMid
                break

    if foundNow
        bool dup = false
        if array.size(crtBars) > 0
            dup := bar_index - array.get(crtBars, array.size(crtBars) - 1) < minCrtGapBars
        if not dup
            array.push(crtBars, bar_index)
            array.push(crtDirs, dirNow)
            array.push(crtSweep, sweepNow)
            array.push(crtMid, midNow)
            crtFound := true
            crtDirNow := dirNow
            int biasN = f_bias(dirNow)
            if showCrtMarks
                array.push(crtLabs, label.new(bar_index, dirNow == 1 ? low : high, str.tostring(biasN), style=dirNow == 1 ? label.style_label_up : label.style_label_down, color=dirNow == 1 ? #26A69A : #EF5350, textcolor=color.white, size=size.tiny))
                while array.size(crtLabs) > 40
                    label.delete(array.shift(crtLabs))
            while array.size(crtBars) > 80
                array.shift(crtBars)
                array.shift(crtDirs)
                array.shift(crtSweep)
                array.shift(crtMid)

plotshape(showCrtMarks and crtFound and crtDirNow == 1, title="CRT Bias Long", style=shape.circle, location=location.belowbar, color=color.new(#26A69A, 15), size=size.tiny)
plotshape(showCrtMarks and crtFound and crtDirNow == -1, title="CRT Bias Short", style=shape.circle, location=location.abovebar, color=color.new(#EF5350, 15), size=size.tiny)

// ── HTF / MTF FVG AOI ─────────────────────────────────────────────────────
f_fvg_tuple() =>
    float a = ta.atr(14)
    bool bull = low > high[2] and (low - high[2]) >= a * minFvgAtr
    bool bear = high < low[2] and (low[2] - high) >= a * minFvgAtr
    bool neu = bull and bear
    bool isNew = (bull or bear) and not neu
    int d = bull and not bear ? 1 : bear and not bull ? -1 : 0
    float top = d == 1 ? low : d == -1 ? low[2] : na
    float bot = d == 1 ? high[2] : d == -1 ? high : na
    [isNew, d, top, bot]

htfSingle = autoSingleHtf ? (timeframe.period == "1" ? "5" : timeframe.period == "5" ? "15" : timeframe.period == "15" ? "60" : timeframe.period == "60" ? "240" : htfManual) : htfManual

[f15n, f15d, f15t, f15b] = request.security(syminfo.tickerid, "15", f_fvg_tuple(), barmerge.gaps_off, barmerge.lookahead_off)
[f30n, f30d, f30t, f30b] = request.security(syminfo.tickerid, "30", f_fvg_tuple(), barmerge.gaps_off, barmerge.lookahead_off)
[f60n, f60d, f60t, f60b] = request.security(syminfo.tickerid, "60", f_fvg_tuple(), barmerge.gaps_off, barmerge.lookahead_off)
[fXn, fXd, fXt, fXb] = request.security(syminfo.tickerid, htfSingle, f_fvg_tuple(), barmerge.gaps_off, barmerge.lookahead_off)

var int last15 = na
var int last30 = na
var int last60 = na
var int lastX = na
bi15 = request.security(syminfo.tickerid, "15", bar_index, barmerge.gaps_off, barmerge.lookahead_off)
bi30 = request.security(syminfo.tickerid, "30", bar_index, barmerge.gaps_off, barmerge.lookahead_off)
bi60 = request.security(syminfo.tickerid, "60", bar_index, barmerge.gaps_off, barmerge.lookahead_off)
biX  = request.security(syminfo.tickerid, htfSingle, bar_index, barmerge.gaps_off, barmerge.lookahead_off)

var float[] aoiTops = array.new_float()
var float[] aoiBots = array.new_float()
var int[]   aoiDirs = array.new_int()
var int[]   aoiBars = array.new_int()
var string[] aoiTf  = array.new_string()
var box[]   aoiBoxes = array.new<box>()
var label[] aoiLabs = array.new_label()

f_push_aoi(bool isNew, int d, float top, float bot, string tfName) =>
    if isNew and not na(top) and not na(bot) and d != 0
        bool allow = true
        if requireBosBeforeFvg
            allow := lastBosDir == d and not na(lastBosBar) and bar_index - lastBosBar <= bosLookback
        if allow
            array.push(aoiTops, top)
            array.push(aoiBots, bot)
            array.push(aoiDirs, d)
            array.push(aoiBars, bar_index)
            array.push(aoiTf, tfName)
            while array.size(aoiTops) > maxAoiKeep
                array.shift(aoiTops)
                array.shift(aoiBots)
                array.shift(aoiDirs)
                array.shift(aoiBars)
                array.shift(aoiTf)

if barstate.isconfirmed
    if useMtfFvg
        if na(last15) or bi15 != last15
            last15 := bi15
            f_push_aoi(f15n, f15d, f15t, f15b, "15m")
        if na(last30) or bi30 != last30
            last30 := bi30
            f_push_aoi(f30n, f30d, f30t, f30b, "30m")
        if na(last60) or bi60 != last60
            last60 := bi60
            f_push_aoi(f60n, f60d, f60t, f60b, "1H")
    else
        if na(lastX) or biX != lastX
            lastX := biX
            f_push_aoi(fXn, fXd, fXt, fXb, htfSingle)

    if array.size(aoiTops) > 0
        for i = array.size(aoiTops) - 1 to 0
            int d = array.get(aoiDirs, i)
            float t = array.get(aoiTops, i)
            float b = array.get(aoiBots, i)
            bool dead = mitigateCloseOnly ? ((d == 1 and close < b) or (d == -1 and close > t)) : ((d == 1 and low < b) or (d == -1 and high > t))
            if dead
                array.remove(aoiTops, i)
                array.remove(aoiBots, i)
                array.remove(aoiDirs, i)
                array.remove(aoiBars, i)
                array.remove(aoiTf, i)

f_find_aoi(int dir, float px1, float px2, float px3) =>
    float bestTop = na
    float bestBot = na
    string bestTf = ""
    bool found = false
    if array.size(aoiTops) > 0
        for i = array.size(aoiTops) - 1 to 0
            if array.get(aoiDirs, i) == dir
                float t = array.get(aoiTops, i)
                float b = array.get(aoiBots, i)
                bool touch = not crtMustTouchFvg
                if crtMustTouchFvg
                    touch := (px1 <= t and px1 >= b) or (px2 <= t and px2 >= b) or (px3 <= t and px3 >= b) or (math.max(math.max(px1, px2), px3) >= b and math.min(math.min(px1, px2), px3) <= t)
                if touch
                    bestTop := t
                    bestBot := b
                    bestTf := array.get(aoiTf, i)
                    found := true
                    break
    [found, bestTop, bestBot, bestTf]

if showAoiBox and barstate.islast
    if array.size(aoiBoxes) > 0
        for i = 0 to array.size(aoiBoxes) - 1
            box.delete(array.get(aoiBoxes, i))
        array.clear(aoiBoxes)
    if array.size(aoiLabs) > 0
        for i = 0 to array.size(aoiLabs) - 1
            label.delete(array.get(aoiLabs, i))
        array.clear(aoiLabs)
    if array.size(aoiTops) > 0
        int aoiN = array.size(aoiTops)
        int from = math.max(0, aoiN - maxAoiDraw)
        for i = from to aoiN - 1
            float t = array.get(aoiTops, i)
            float b = array.get(aoiBots, i)
            int d = array.get(aoiDirs, i)
            int sb = array.get(aoiBars, i)
            string tf = array.get(aoiTf, i)
            col = d == 1 ? fvgBullCol : fvgBearCol
            array.push(aoiBoxes, box.new(sb, t, bar_index + 30, b, bgcolor=col, border_color=color.new(#42A5F5, 35), border_width=1, extend=extend.right))
            array.push(aoiLabs, label.new(bar_index + 2, (t + b) * 0.5, tf, style=label.style_label_left, color=color.new(#1E88E5, 30), textcolor=color.white, size=size.tiny))

// ── Setup: BOS + FVG AOI + CRT Bias ───────────────────────────────────────
var int   newDir = 0
var float newEntry = na
var float newSl = na
var float newTp = na
var float newProx = na
var float newDist = na
var int   newBias = 0
var string newAoiTf = ""
var int   lastSetupBar = na

var int[]   sDir = array.new<int>()
var float[] sEntry = array.new<float>()
var float[] sSl = array.new<float>()
var float[] sTp = array.new<float>()
var int[]   sBar = array.new<int>()
var int[]   sStat = array.new<int>()
var int[]   sBias = array.new<int>()
var float activeE = na
var float activeS = na
var float activeT = na

newDir := 0

if barstate.isconfirmed and crtFound and array.size(crtBars) > 0
    int dir = crtDirNow
    int bias = f_bias(dir)
    bool biasOk = bias >= minBiasModels
    bool bosOk = lastBosDir == dir and not na(lastBosBar) and bar_index - lastBosBar <= bosLookback
    float sw = array.get(crtSweep, array.size(crtSweep) - 1)
    float mid = array.get(crtMid, array.size(crtMid) - 1)
    bool fvgOk = true
    float fTop = na
    float fBot = na
    string fTf = ""
    if crtMustTouchFvg or requireBosBeforeFvg
        [ok, t, b, tf] = f_find_aoi(dir, close, mid, sw)
        fvgOk := ok
        fTop := t
        fBot := b
        fTf := tf
    bool lastExited = false
    if array.size(sStat) > 0
        lastExited := array.get(sStat, array.size(sStat) - 1) >= 2
    bool coolOk = lastExited or na(lastSetupBar) or (bar_index - lastSetupBar >= cooldownBars)

    if biasOk and bosOk and fvgOk and coolOk
        float entry = not na(fTop) ? (fTop + fBot) * 0.5 : mid
        float pad = atr * slPadAtr
        float sl = dir == 1 ? sw - pad : sw + pad
        float risk = math.abs(entry - sl)
        if risk > syminfo.mintick
            float tp = dir == 1 ? entry + risk * riskReward : entry - risk * riskReward
            if tpToStructure
                if dir == 1
                    float ns = f_nextStructHigh(entry)
                    if not na(ns)
                        tp := math.max(tp, ns)
                else
                    float ns2 = f_nextStructLow(entry)
                    if not na(ns2)
                        tp := math.min(tp, ns2)
            newDir := dir
            newEntry := entry
            newSl := sl
            newTp := tp
            newBias := bias
            newProx := not na(fTop) ? fTop : entry + risk
            newDist := not na(fBot) ? fBot : entry - risk
            newAoiTf := fTf
            lastSetupBar := bar_index

// ── Drawings ──────────────────────────────────────────────────────────────
var box[]   bZone = array.new<box>()
var box[]   bTp = array.new<box>()
var box[]   bSl = array.new<box>()
var line[]  lEntry = array.new<line>()
var line[]  lSl = array.new<line>()
var line[]  lTp = array.new<line>()
var label[] labE = array.new<label>()
var label[] labS = array.new<label>()
var label[] labT = array.new<label>()
var label[] labTag = array.new<label>()
var label[] labEvt = array.new<label>()

f_clear() =>
    if array.size(bZone) > 0
        for i = 0 to array.size(bZone) - 1
            box.delete(array.get(bZone, i))
            box.delete(array.get(bTp, i))
            box.delete(array.get(bSl, i))
            line.delete(array.get(lEntry, i))
            line.delete(array.get(lSl, i))
            line.delete(array.get(lTp, i))
            label.delete(array.get(labE, i))
            label.delete(array.get(labS, i))
            label.delete(array.get(labT, i))
            label.delete(array.get(labTag, i))
            if i < array.size(labEvt)
                label.delete(array.get(labEvt, i))
    array.clear(bZone)
    array.clear(bTp)
    array.clear(bSl)
    array.clear(lEntry)
    array.clear(lSl)
    array.clear(lTp)
    array.clear(labE)
    array.clear(labS)
    array.clear(labT)
    array.clear(labTag)
    array.clear(labEvt)
    array.clear(sDir)
    array.clear(sEntry)
    array.clear(sSl)
    array.clear(sTp)
    array.clear(sBar)
    array.clear(sStat)
    array.clear(sBias)

if newDir != 0
    if onlyLast and array.size(sDir) > 0
        f_clear()
    zTop = math.max(newProx, newDist)
    zBot = math.min(newProx, newDist)
    right = bar_index + setupWidth
    zcol = newDir == 1 ? bullZoneCol : bearZoneCol
    array.push(bZone, box.new(bar_index, zTop, right, zBot, bgcolor=zcol, border_color=color.new(zcol, 40), border_width=1))
    if newDir == 1
        array.push(bTp, box.new(bar_index, newTp, right, newEntry, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newEntry, right, newSl, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))
    else
        array.push(bTp, box.new(bar_index, newEntry, right, newTp, bgcolor=color.new(#26A69A, 85), border_color=color.new(#26A69A, 60), border_width=1))
        array.push(bSl, box.new(bar_index, newSl, right, newEntry, bgcolor=color.new(#EF5350, 85), border_color=color.new(#EF5350, 60), border_width=1))
    array.push(lEntry, line.new(bar_index, newEntry, right, newEntry, color=entryCol, width=2, style=line.style_dashed))
    array.push(lSl, line.new(bar_index, newSl, right, newSl, color=slCol, width=1, style=line.style_dashed))
    array.push(lTp, line.new(bar_index, newTp, right, newTp, color=tpCol, width=1, style=line.style_dashed))
    array.push(labE, label.new(right, newEntry, "ENTRY " + str.tostring(newEntry, format.mintick), style=label.style_label_left, color=entryCol, textcolor=color.white, size=size.small))
    array.push(labS, label.new(right, newSl, "SL " + str.tostring(newSl, format.mintick), style=label.style_label_left, color=slCol, textcolor=color.white, size=size.small))
    array.push(labT, label.new(right, newTp, "TP " + str.tostring(newTp, format.mintick), style=label.style_label_left, color=tpCol, textcolor=color.white, size=size.small))
    array.push(labTag, label.new(bar_index, newDir == 1 ? zTop : zBot, "CRT OrderFlow " + (newDir == 1 ? "LONG" : "SHORT") + "\nBOS → FVG" + (newAoiTf == "" ? "" : " " + newAoiTf) + " → Bias x" + str.tostring(newBias), style=newDir == 1 ? label.style_label_down : label.style_label_up, color=newDir == 1 ? #00897B : #C62828, textcolor=color.white, size=size.small))
    array.push(labEvt, na)
    array.push(sDir, newDir)
    array.push(sEntry, newEntry)
    array.push(sSl, newSl)
    array.push(sTp, newTp)
    array.push(sBar, bar_index)
    array.push(sStat, 0)
    array.push(sBias, newBias)
    already = newDir == 1 ? (low <= newEntry or close >= newEntry) : (high >= newEntry or close <= newEntry)
    if already
        array.set(sStat, array.size(sStat) - 1, 1)
        activeE := newEntry
        activeS := newSl
        activeT := newTp
        if showFillMark
            array.set(labEvt, array.size(labEvt) - 1, label.new(bar_index, newEntry, "▶ ENTRY", style=label.style_label_center, color=newDir == 1 ? #00897B : #C62828, textcolor=color.white, size=size.normal))
        if alertEntry
            alert("CRT OF ENTRY " + (newDir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(newEntry, format.mintick), alert.freq_once_per_bar_close)
    if alertOnSetup
        alert("CRT OrderFlow " + (newDir == 1 ? "LONG" : "SHORT") + " | BOS→FVG→Bias x" + str.tostring(newBias) + " | E " + str.tostring(newEntry, format.mintick), alert.freq_once_per_bar_close)

n = array.size(sDir)
if n > 0
    for i = 0 to n - 1
        st = array.get(sStat, i)
        if i < array.size(bZone) and not na(array.get(bZone, i)) and st <= 1
            dir = array.get(sDir, i)
            e = array.get(sEntry, i)
            s = array.get(sSl, i)
            t = array.get(sTp, i)
            startB = array.get(sBar, i)
            right = extendLive ? math.max(bar_index, startB + setupWidth) : startB + setupWidth
            box.set_right(array.get(bZone, i), right)
            box.set_right(array.get(bTp, i), right)
            box.set_right(array.get(bSl, i), right)
            line.set_x2(array.get(lEntry, i), right)
            line.set_x2(array.get(lSl, i), right)
            line.set_x2(array.get(lTp, i), right)
            label.set_x(array.get(labE, i), right)
            label.set_x(array.get(labS, i), right)
            label.set_x(array.get(labT, i), right)
            if st == 0
                hitE = dir == 1 ? low <= e : high >= e
                if hitE or (dir == 1 and close >= e) or (dir == -1 and close <= e)
                    array.set(sStat, i, 1)
                    activeE := e
                    activeS := s
                    activeT := t
                    if showFillMark and i < array.size(labEvt)
                        label.delete(array.get(labEvt, i))
                        array.set(labEvt, i, label.new(bar_index, e, "▶ ENTRY", style=label.style_label_center, color=dir == 1 ? #00897B : #C62828, textcolor=color.white, size=size.normal))
                    if alertEntry
                        alert("CRT OF ENTRY @ " + str.tostring(e, format.mintick), alert.freq_once_per_bar_close)
            if array.get(sStat, i) == 1
                hitT = dir == 1 ? high >= t : low <= t
                hitS = dir == 1 ? low <= s : high >= s
                if hitT or hitS
                    array.set(sStat, i, hitT ? 2 : 3)
                    if showFillMark and i < array.size(labEvt)
                        label.delete(array.get(labEvt, i))
                        array.set(labEvt, i, label.new(bar_index, hitT ? t : s, hitT ? "✓ TP EXIT" : "✗ SL EXIT", style=label.style_label_center, color=hitT ? #26A69A : #EF5350, textcolor=color.white, size=size.normal))
                    if alertExit
                        alert((hitT ? "CRT OF TP @ " : "CRT OF SL @ ") + str.tostring(hitT ? t : s, format.mintick), alert.freq_once_per_bar_close)

plot(activeE, "ENTRY", color=entryCol, display=display.data_window)
plot(activeS, "SL", color=slCol, display=display.data_window)
plot(activeT, "TP", color=tpCol, display=display.data_window)

var table info = table.new(position.top_right, 2, 8, bgcolor=color.new(#111111, 5), border_width=1, border_color=color.new(color.white, 70))
if showPanel and barstate.islast
    longBias = f_bias(1)
    shortBias = f_bias(-1)
    aoiN = array.size(aoiTops)
    if array.size(sDir) > 0
        idx = array.size(sDir) - 1
        dir = array.get(sDir, idx)
        st = array.get(sStat, idx)
        stTxt = st == 0 ? "WAIT FILL" : st == 1 ? "IN TRADE" : st == 2 ? "TP HIT" : "SL HIT"
        e = array.get(sEntry, idx)
        s = array.get(sSl, idx)
        t = array.get(sTp, idx)
        bias = array.get(sBias, idx)
        risk = math.abs(e - s)
        rew = math.abs(t - e)
        liveR = risk > 0 ? ((dir == 1 ? close - e : e - close) / risk) : 0.0
        if st == 2
            liveR := riskReward
        if st == 3
            liveR := -1.0
        table.cell(info, 0, 0, "CRT OF", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, (dir == 1 ? "LONG" : "SHORT") + " · " + stTxt, text_color=dir == 1 ? #69F0AE : #FF8A80, text_size=size.small)
        table.cell(info, 0, 1, "Path", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, "BOS → FVG → Bias x" + str.tostring(bias), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, str.tostring(e, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "SL", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, str.tostring(s, format.mintick), text_color=#FF8A80, text_size=size.small)
        table.cell(info, 0, 4, "TP", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, str.tostring(t, format.mintick), text_color=#69F0AE, text_size=size.small)
        table.cell(info, 0, 5, "Risk", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, str.tostring(risk, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(info, 0, 6, "Reward", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, str.tostring(rew, format.mintick) + " (" + str.tostring(riskReward, "#.#") + "R)", text_color=color.white, text_size=size.small)
        table.cell(info, 0, 7, st <= 1 ? "Live" : "Final", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 7, str.tostring(liveR, "#.##") + "R", text_color=st == 3 ? #FF8A80 : #69F0AE, text_size=size.small)
    else
        bosTxt = lastBosDir == 0 ? "need BOS" : (lastBosDir == 1 ? "BOS↑" : "BOS↓")
        status = aoiN > 0 ? (bosTxt + " · AOI x" + str.tostring(aoiN) + " · bias L/S " + str.tostring(longBias) + "/" + str.tostring(shortBias)) : (bosTxt + " · need FVG AOI")
        table.cell(info, 0, 0, "CRT OF", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, status, text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 1, "Model", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 1, "Structure→BOS→FVG→CRT Bias", text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "Bias need", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 2, "≥" + str.tostring(minBiasModels) + " CRT same dir", text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "AOI", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 3, useMtfFvg ? ("MTF FVG live " + str.tostring(aoiN)) : ("HTF " + htfSingle + " · " + str.tostring(aoiN)), text_color=aoiN > 0 ? #69F0AE : color.white, text_size=size.small)
        table.cell(info, 0, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 4, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 5, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 6, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 6, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 0, 7, "", text_color=color.gray, text_size=size.small)
        table.cell(info, 1, 7, "", text_color=color.gray, text_size=size.small)
