[Unit]
Description=Forge TradingView news + Forex Factory calendar
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/forge-charts
Environment=NODE_OPTIONS=--experimental-sqlite
Environment=NEWS_HOST=127.0.0.1
Environment=NEWS_PORT=8787
Environment=NEWS_DB_PATH=/var/lib/forge-charts/news.sqlite
ExecStart=/usr/bin/node --experimental-sqlite server/news/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
