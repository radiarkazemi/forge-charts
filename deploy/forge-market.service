[Unit]
Description=Forge FXPro market feed
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/forge-charts
Environment=MARKET_HOST=127.0.0.1
Environment=MARKET_PORT=8788
ExecStart=/usr/bin/node server/market/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
