[Unit]
Description=Forge Charts cross-device profile sync
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/forge-charts-src
Environment=MONGO_URI=mongodb://127.0.0.1:27017/
Environment=FORGE_PROFILE_HOST=127.0.0.1
Environment=FORGE_PROFILE_PORT=8010
ExecStart=/usr/bin/python3 /var/www/forge-charts-src/deploy/vps/forge_profile_sync.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
