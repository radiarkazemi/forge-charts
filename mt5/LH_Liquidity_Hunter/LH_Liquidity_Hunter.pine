//@version=6
indicator("LH · Liquidity Hunter", overlay=true, max_boxes_count=60, max_lines_count=120, max_labels_count=80, max_bars_back=5000)

// Complete setup: 1 RAID → 2 CISD → 3 MSS → 4 FVG → ENTRY / SL / TP
// Quality: rejection raid · body CISD · displacement MSS · PD FVG · CE tap · raid-leg SL

pivotPeriod      = input.int(3, "Pivot Period (1m)", minval=2, group="Detection")
minSweepAtr      = input.float(0.06, "Min Sweep Beyond Pivot (ATRx)", step=0.01, group="Detection")
minDispAtr       = input.float(0.45, "Min MSS Displacement (ATRx)", step=0.05, group="Detection")
minFvgAtr        = input.float(0.06, "Min FVG Size (ATRx)", step=0.01, group="Detection")
maxFvgAtr        = input.float(0.35, "Max FVG Size (ATRx)", step=0.01, group="Detection")
maxCisdBars      = input.int(4, "Max Bars After Raid For CISD", group="Detection")
maxStructBars    = input.int(6, "Max Bars After CISD For MSS", group="Detection")
maxFvgLagBars    = input.int(1, "Max Bars After MSS For FVG", minval=0, maxval=3, group="Detection")
requireCisd      = input.bool(true, "Require CISD", group="Detection")
allowBos         = input.bool(false, "Allow Internal BOS (OFF = MSS only)", group="Detection")
requireFvgRetest = input.bool(true, "Wait For FVG Retest", group="Detection")
maxRetestBars    = input.int(5, "Max Bars For Retest", group="Detection")
cooldownBars     = input.int(18, "Cooldown Between Setups", group="Detection")
cooldownAfterSl  = input.int(8, "Cooldown After SL Hit", minval=0, group="Detection")

requireRejectRaid = input.bool(true, "Strong RAID — close back + rejection wick", group="Quality")
requireStrongCisd = input.bool(true, "Strong CISD — body close through raid open", group="Quality")
requireStrongMss  = input.bool(true, "Strong MSS — close beyond structure, body candle", group="Quality")
minBodyRatio     = input.float(0.55, "Min MSS Body / Range", step=0.05, minval=0.35, maxval=0.90, group="Quality")
minCloseThruAtr  = input.float(0.08, "Min MSS Close Beyond Structure (ATRx)", step=0.01, group="Quality")
requirePd        = input.bool(true, "Entry in Discount (long) / Premium (short)", group="Quality")
pdLevel          = input.float(0.50, "PD Threshold (0.50 = half of raid→MSS range)", step=0.05, minval=0.35, maxval=0.70, group="Quality")
requireFvgIntact = input.bool(true, "FVG distal must stay unfilled", group="Quality")
requireRejectEntry = input.bool(true, "Strong ENTRY — tap CE, close back through CE", group="Quality")

entryMode        = input.string("FVG CE (50%)", "Entry Level", options=["FVG CE (50%)", "FVG Proximal"], group="Entry / SL / TP")
slPadAtr         = input.float(0.30, "SL Pad Beyond Raid Leg (ATRx)", step=0.01, group="Entry / SL / TP")
minRiskAtr       = input.float(0.35, "Min Risk Size (ATRx)", step=0.05, group="Entry / SL / TP")
maxRiskAtr       = input.float(2.20, "Max Risk Size (ATRx) — skip stretched SL", step=0.05, group="Entry / SL / TP")
riskReward       = input.float(2.5, "Fallback RR", step=0.1, group="Entry / SL / TP")
useOpposingLiq   = input.bool(true, "TP = Opposing Liquidity", group="Entry / SL / TP")
liqExtendAtr     = input.float(1.0, "Min Dist To Opposing Liq (ATRx)", step=0.1, group="Entry / SL / TP")
minTpR           = input.float(1.5, "Min TP Distance (R)", step=0.1, group="Entry / SL / TP")

onlyLast         = input.bool(true, "Only Last Setup", group="Display")
historyCount     = input.int(3, "History Count", minval=1, maxval=10, group="Display")
showAnatomy      = input.bool(true, "Show Full Anatomy (RAID/CISD/MSS/FVG)", group="Display")
showLiqPivots    = input.bool(true, "Mark Active BSL/SSL", group="Display")
showFvg          = input.bool(true, "Show FVG Box", group="Display")
showLevels       = input.bool(true, "Show ENTRY / SL / TP lines", group="Display")
showLevelLabels  = input.bool(true, "Show price labels", group="Display")
longCol          = input.color(#26A69A, "Long", group="Display")
shortCol         = input.color(#EF5350, "Short", group="Display")
entryCol         = input.color(#CFD8DC, "Entry", group="Display")
raidCol          = input.color(#FFB74D, "Raid / Sweep", group="Display")
cisdCol          = input.color(#64B5F6, "CISD", group="Display")
mssCol           = input.color(#BA68C8, "MSS", group="Display")

f_push(float[] px, int[] br, float p, int b) =>
    array.push(px, p)
    array.push(br, b)
    if array.size(px) > 40
        array.shift(px)
        array.shift(br)

f_lastPivot(float[] px, int[] br, int before, int lookback, int minAge) =>
    float out = na
    bool done = false
    int n = array.size(px)
    if n > 0
        for i = n - 1 to 0
            if not done
                int b = array.get(br, i)
                int age = before - b
                if b < before and age >= minAge
                    if age > lookback
                        done := true
                    else
                        out := array.get(px, i)
                        done := true
    out

f_nextHi(float[] px, float from, float minDist) =>
    float out = na
    int n = array.size(px)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(px, i)
            if p > from + minDist
                out := na(out) ? p : math.min(out, p)
    out

f_nextLo(float[] px, float from, float minDist) =>
    float out = na
    int n = array.size(px)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(px, i)
            if p < from - minDist
                out := na(out) ? p : math.max(out, p)
    out

f_validRisk(float entry, float sl, float a) =>
    float r = math.abs(entry - sl)
    r >= a * minRiskAtr and r <= a * maxRiskAtr

f_candleRange() =>
    math.max(high - low, syminfo.mintick)

f_bodyRatio() =>
    math.abs(close - open) / f_candleRange()

f_closePos() =>
    (close - low) / f_candleRange()

// Longs buy discount of raid→MSS range; shorts sell premium
f_inPd(int dir, float entry, float legLo, float legHi) =>
    bool ok = true
    float span = legHi - legLo
    if requirePd and span > 0
        float pos = (entry - legLo) / span
        ok := dir == 1 ? pos <= pdLevel : pos >= (1.0 - pdLevel)
    ok

f_strongRaid(int dir) =>
    bool ok = true
    if requireRejectRaid
        float cr = f_candleRange()
        // Wick raid: close back in the body half away from the sweep
        if dir == 1
            ok := (close - low) / cr >= 0.50
        else
            ok := (high - close) / cr >= 0.50
    ok

f_strongMss(int dir, float structPx, float a) =>
    bool ok = true
    if requireStrongMss
        bool bodyOk = f_bodyRatio() >= minBodyRatio
        bool dirOk = dir == 1 ? close > open : close < open
        bool thru = dir == 1 ? close >= structPx + a * minCloseThruAtr : close <= structPx - a * minCloseThruAtr
        bool posOk = dir == 1 ? f_closePos() >= 0.60 : f_closePos() <= 0.40
        ok := bodyOk and dirOk and thru and posOk
    ok

f_fvgStillIntact(int dir, float ft, float fb) =>
    bool ok = true
    if requireFvgIntact
        ok := dir == 1 ? low > fb : high < ft
    ok

f_strongEntry(int dir, float entry, float ft, float fb, float a) =>
    bool ok = true
    float ce = (ft + fb) * 0.5
    float tol = a * 0.04
    if requireRejectEntry
        if dir == 1
            bool tap = low <= entry + tol and low >= fb - tol
            bool back = close > open and close >= ce and close <= ft + a * 0.05
            bool noFill = not requireFvgIntact or low > fb
            ok := tap and back and noFill
        else
            bool tap = high >= entry - tol and high <= ft + tol
            bool back = close < open and close <= ce and close >= fb - a * 0.05
            bool noFill = not requireFvgIntact or high < ft
            ok := tap and back and noFill
    ok

// FVG on MSS displacement bar — split helpers (no tuple [a,b] syntax)
f_fvgTop(int dir) =>
    dir == 1 ? low : low[2]

f_fvgBot(int dir) =>
    dir == 1 ? high[2] : high

f_fvgOk(int dir, float a) =>
    bool ok = false
    if bar_index >= 2
        float ft = f_fvgTop(dir)
        float fb = f_fvgBot(dir)
        float sz = ft - fb
        ok := sz >= a * minFvgAtr and sz <= a * maxFvgAtr and ft > fb
    ok

// Exact entry: CE (50%) or proximal edge — never fuzzy midpoint + CISD fallback
f_entryPx(int dir, float ft, float fb) =>
    float ce = (ft + fb) * 0.5
    entryMode == "FVG Proximal" ? (dir == 1 ? ft : fb) : ce

// SL beyond full raid leg (sweep→CISD→MSS), not just the sweep wick + tiny pad
f_buildSl(int dir, float entry, float sweepPx, float sweepExt, float cisdPx, float legHi, float legLo, float a) =>
    float pad = a * slPadAtr
    float sl = na
    if dir == 1
        float base = math.min(nz(legLo, sweepExt), sweepExt, sweepPx)
        if not na(cisdPx)
            base := math.min(base, cisdPx)
        sl := base - pad
    else
        float base = math.max(nz(legHi, sweepExt), sweepExt, sweepPx)
        if not na(cisdPx)
            base := math.max(base, cisdPx)
        sl := base + pad
    sl

f_buildTp(int dir, float entry, float sl, float a, float[] pivHi, float[] pivLo) =>
    float risk = math.abs(entry - sl)
    float tp = dir == 1 ? entry + risk * riskReward : entry - risk * riskReward
    if useOpposingLiq
        float liq = dir == 1 ? f_nextHi(pivHi, entry, a * liqExtendAtr) : f_nextLo(pivLo, entry, a * liqExtendAtr)
        if not na(liq)
            tp := dir == 1 ? math.max(tp, liq) : math.min(tp, liq)
    float minDist = risk * minTpR
    tp := dir == 1 ? math.max(tp, entry + minDist) : math.min(tp, entry - minDist)
    tp

type Setup
    int dir
    float entry
    float sl
    float tp
    float fvgTop
    float fvgBot
    float raidPx
    float raidExt
    float cisdPx
    float mssPx
    int raidBar
    int cisdBar
    int mssBar
    int bar
    string tag
    int status
    int fillBar

f_emit(Setup[] hist, int dir, float entry, float sl, float tp, float ft, float fb, float raidPx, float raidExt, float cisdPx, float mssPx, int raidBar, int cisdBar, int mssBar, int bar, string tag) =>
    array.push(hist, Setup.new(dir, entry, sl, tp, ft, fb, raidPx, raidExt, cisdPx, mssPx, raidBar, cisdBar, mssBar, bar, tag, 0, -1))
    if array.size(hist) > 20
        array.shift(hist)
    true

// Update last setup's fill/TP/SL using only the current bar (no deep []).
// Never resolve TP/SL on the fill bar — same-bar highs/lows include price BEFORE entry
// and caused false "TP HIT" while price later smoked the SL.
f_updateStatus(Setup[] hist) =>
    int n = array.size(hist)
    if n > 0
        Setup s = array.get(hist, n - 1)
        if s.status < 2 and bar_index >= s.bar
            if s.status == 0
                bool tradedAt = s.dir == 1 ? low <= s.entry and high >= s.entry : high >= s.entry and low <= s.entry
                bool closedThru = s.dir == 1 ? close >= s.entry and open < s.entry : close <= s.entry and open > s.entry
                // Limit fill only when price actually trades at entry (not just on signal bar)
                if tradedAt or closedThru
                    s.fillBar := bar_index
                    s.status := 1
                    array.set(hist, n - 1, s)
            if s.status == 1 and bar_index > s.fillBar
                bool hitT = s.dir == 1 ? high >= s.tp : low <= s.tp
                bool hitS = s.dir == 1 ? low <= s.sl : high >= s.sl
                if hitS and hitT
                    // Both wicked — decide by close (which side settled)
                    bool slWins = s.dir == 1 ? close <= s.entry : close >= s.entry
                    s.status := slWins ? 3 : 2
                    array.set(hist, n - 1, s)
                else if hitS
                    s.status := 3
                    array.set(hist, n - 1, s)
                else if hitT
                    s.status := 2
                    array.set(hist, n - 1, s)
    true

atr = ta.atr(14)
ph = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pl = ta.pivotlow(low, pivotPeriod, pivotPeriod)

var float[] pivHiPx = array.new_float()
var int[] pivHiBar = array.new_int()
var float[] pivLoPx = array.new_float()
var int[] pivLoBar = array.new_int()
var Setup[] history = array.new<Setup>()

var int phase = 0
var int pendDir = 0
var float sweepPx = na
var float sweepExt = na
var float cisdLevel = na
var float mssLevel = na
var float fvgTop = na
var float fvgBot = na
var int sweepBar = na
var int cisdBar = na
var int mssBar = na
var int fvgBar = na
var float raidLegHi = na
var float raidLegLo = na
var int structType = 0
var int lastSetupBar = -9999

var float setupEntry = na
var float setupSl = na
var float setupTp = na
var int setupDir = 0
var int setupBar = na
var float setupFvgTop = na
var float setupFvgBot = na
var string setupTag = ""
var float setupRaidPx = na
var float setupRaidExt = na
var float setupCisdPx = na
var float setupMssPx = na
var int setupRaidBar = na
var int setupCisdBar = na
var int setupMssBar = na

var box[] drawBoxes = array.new_box()
var line[] drawLines = array.new_line()
var label[] drawLabels = array.new_label()

// Safe window for drawings — Pine rejects x-coords whose offset exceeds the historical buffer
SAFE_DRAW = 480

if not na(ph)
    f_push(pivHiPx, pivHiBar, ph, bar_index - pivotPeriod)
if not na(pl)
    f_push(pivLoPx, pivLoBar, pl, bar_index - pivotPeriod)

huntLo = f_lastPivot(pivLoPx, pivLoBar, bar_index, 100, pivotPeriod)
huntHi = f_lastPivot(pivHiPx, pivHiBar, bar_index, 100, pivotPeriod)

if barstate.isconfirmed
    if phase == 1 and not na(sweepBar) and bar_index - sweepBar > maxCisdBars
        phase := 0
        pendDir := 0
    if phase == 2 and not na(cisdBar) and bar_index - cisdBar > maxStructBars
        phase := 0
        pendDir := 0
    if phase == 3 and not na(mssBar) and bar_index - mssBar > maxFvgLagBars
        phase := 0
        pendDir := 0
    if phase == 4 and not na(fvgBar) and bar_index - fvgBar > maxRetestBars
        phase := 0
        pendDir := 0

    int cdBars = cooldownBars
    int hN = array.size(history)
    if hN > 0
        Setup cdS = array.get(history, hN - 1)
        if cdS.status == 3
            cdBars := cooldownAfterSl
    bool canStart = phase == 0 and bar_index - lastSetupBar >= cdBars
    float a = atr
    bool sslRaid = canStart and not na(huntLo) and low < huntLo - a * minSweepAtr and close > huntLo and f_strongRaid(1)
    bool bslRaid = canStart and not na(huntHi) and high > huntHi + a * minSweepAtr and close < huntHi and f_strongRaid(-1)

    if sslRaid
        phase := requireCisd ? 1 : 2
        pendDir := 1
        sweepPx := huntLo
        sweepExt := low
        sweepBar := bar_index
        cisdLevel := open
        cisdBar := requireCisd ? na : bar_index
        mssLevel := huntHi
        mssBar := na
        fvgBar := na
        structType := 0
        raidLegHi := high
        raidLegLo := low
    else if bslRaid
        phase := requireCisd ? 1 : 2
        pendDir := -1
        sweepPx := huntHi
        sweepExt := high
        sweepBar := bar_index
        cisdLevel := open
        cisdBar := requireCisd ? na : bar_index
        mssLevel := huntLo
        mssBar := na
        fvgBar := na
        structType := 0
        raidLegHi := high
        raidLegLo := low

    if phase != 0
        raidLegHi := math.max(raidLegHi, high)
        raidLegLo := math.min(raidLegLo, low)
        sweepExt := pendDir == 1 ? math.min(sweepExt, low) : math.max(sweepExt, high)
        float body = math.abs(close - open)

        if phase == 1
            bool cisdOk = false
            if pendDir == 1
                cisdOk := close > cisdLevel and close > open
            else
                cisdOk := close < cisdLevel and close < open
            if requireStrongCisd
                cisdOk := cisdOk and body >= a * 0.20 and f_bodyRatio() >= 0.45
            if cisdOk
                cisdBar := bar_index
                phase := 2

        if phase == 2 and (na(cisdBar) ? bar_index > sweepBar : bar_index > cisdBar)
            float mssRef = na
            float bosRef = na
            bool hitMss = false
            bool hitBos = false
            int barsBack = math.min(bar_index - sweepBar, 30)
            if pendDir == 1
                float mx = high
                if barsBack > 0
                    for k = 0 to barsBack
                        mx := math.max(mx, high[k])
                mssRef := na(mssLevel) ? mx : mssLevel
                hitMss := close > mssRef and close > open and body >= a * minDispAtr and f_strongMss(1, mssRef, a)
                bosRef := f_lastPivot(pivHiPx, pivHiBar, bar_index, math.max(bar_index - sweepBar + 2, 5), 1)
                hitBos := allowBos and not na(bosRef) and bosRef > sweepPx and close > bosRef and close > open and body >= a * minDispAtr * 0.85 and f_strongMss(1, bosRef, a)
            else
                float mn = low
                if barsBack > 0
                    for k = 0 to barsBack
                        mn := math.min(mn, low[k])
                mssRef := na(mssLevel) ? mn : mssLevel
                hitMss := close < mssRef and close < open and body >= a * minDispAtr and f_strongMss(-1, mssRef, a)
                bosRef := f_lastPivot(pivLoPx, pivLoBar, bar_index, math.max(bar_index - sweepBar + 2, 5), 1)
                hitBos := allowBos and not na(bosRef) and bosRef < sweepPx and close < bosRef and close < open and body >= a * minDispAtr * 0.85 and f_strongMss(-1, bosRef, a)
            if hitMss or hitBos
                mssLevel := hitMss ? mssRef : bosRef
                structType := hitMss ? 1 : 2
                mssBar := bar_index
                phase := 3

        if phase == 3 and not na(mssBar) and bar_index >= mssBar and bar_index <= mssBar + maxFvgLagBars
            if f_fvgOk(pendDir, a)
                float ft = f_fvgTop(pendDir)
                float fb = f_fvgBot(pendDir)
                float ceNow = (ft + fb) * 0.5
                if f_inPd(pendDir, ceNow, raidLegLo, raidLegHi)
                    fvgTop := ft
                    fvgBot := fb
                    fvgBar := bar_index
                    if requireFvgRetest
                        phase := 4
                    else
                        float entry = f_entryPx(pendDir, ft, fb)
                        string tag = structType == 2 ? "BOS" : "MSS"
                        int cBar = na(cisdBar) ? sweepBar : cisdBar
                        float sl = f_buildSl(pendDir, entry, sweepPx, sweepExt, cisdLevel, raidLegHi, raidLegLo, a)
                        if pendDir == 1
                            if entry > sl and f_validRisk(entry, sl, a)
                                float tp = f_buildTp(1, entry, sl, a, pivHiPx, pivLoPx)
                                f_emit(history, 1, entry, sl, tp, ft, fb, sweepPx, sweepExt, cisdLevel, mssLevel, sweepBar, cBar, mssBar, bar_index, tag)
                                setupEntry := entry
                                setupSl := sl
                                setupTp := tp
                                setupDir := 1
                                setupBar := bar_index
                                setupFvgTop := ft
                                setupFvgBot := fb
                                setupTag := tag
                                setupRaidPx := sweepPx
                                setupRaidExt := sweepExt
                                setupCisdPx := cisdLevel
                                setupMssPx := mssLevel
                                setupRaidBar := sweepBar
                                setupCisdBar := cBar
                                setupMssBar := mssBar
                                lastSetupBar := bar_index
                        else
                            if sl > entry and f_validRisk(entry, sl, a)
                                float tp2 = f_buildTp(-1, entry, sl, a, pivHiPx, pivLoPx)
                                f_emit(history, -1, entry, sl, tp2, ft, fb, sweepPx, sweepExt, cisdLevel, mssLevel, sweepBar, cBar, mssBar, bar_index, tag)
                                setupEntry := entry
                                setupSl := sl
                                setupTp := tp2
                                setupDir := -1
                                setupBar := bar_index
                                setupFvgTop := ft
                                setupFvgBot := fb
                                setupTag := tag
                                setupRaidPx := sweepPx
                                setupRaidExt := sweepExt
                                setupCisdPx := cisdLevel
                                setupMssPx := mssLevel
                                setupRaidBar := sweepBar
                                setupCisdBar := cBar
                                setupMssBar := mssBar
                                lastSetupBar := bar_index
                        phase := 0
                        pendDir := 0

        if phase == 4 and bar_index > fvgBar
            bool raidBroken = pendDir == 1 ? close < raidLegLo - a * 0.05 : close > raidLegHi + a * 0.05
            bool fvgFilled = not f_fvgStillIntact(pendDir, fvgTop, fvgBot)
            if raidBroken or fvgFilled
                phase := 0
                pendDir := 0
            else if f_strongEntry(pendDir, f_entryPx(pendDir, fvgTop, fvgBot), fvgTop, fvgBot, a)
                float entry = f_entryPx(pendDir, fvgTop, fvgBot)
                string tag = structType == 2 ? "BOS" : "MSS"
                int cBar = na(cisdBar) ? sweepBar : cisdBar
                float sl = f_buildSl(pendDir, entry, sweepPx, sweepExt, cisdLevel, raidLegHi, raidLegLo, a)
                bool locStill = f_inPd(pendDir, entry, raidLegLo, raidLegHi)
                if locStill
                    if pendDir == 1
                        if entry > sl and f_validRisk(entry, sl, a)
                            float tp = f_buildTp(1, entry, sl, a, pivHiPx, pivLoPx)
                            f_emit(history, 1, entry, sl, tp, fvgTop, fvgBot, sweepPx, sweepExt, cisdLevel, mssLevel, sweepBar, cBar, mssBar, bar_index, tag)
                            setupEntry := entry
                            setupSl := sl
                            setupTp := tp
                            setupDir := 1
                            setupBar := bar_index
                            setupFvgTop := fvgTop
                            setupFvgBot := fvgBot
                            setupTag := tag
                            setupRaidPx := sweepPx
                            setupRaidExt := sweepExt
                            setupCisdPx := cisdLevel
                            setupMssPx := mssLevel
                            setupRaidBar := sweepBar
                            setupCisdBar := cBar
                            setupMssBar := mssBar
                            lastSetupBar := bar_index
                    else
                        if sl > entry and f_validRisk(entry, sl, a)
                            float tp2 = f_buildTp(-1, entry, sl, a, pivHiPx, pivLoPx)
                            f_emit(history, -1, entry, sl, tp2, fvgTop, fvgBot, sweepPx, sweepExt, cisdLevel, mssLevel, sweepBar, cBar, mssBar, bar_index, tag)
                            setupEntry := entry
                            setupSl := sl
                            setupTp := tp2
                            setupDir := -1
                            setupBar := bar_index
                            setupFvgTop := fvgTop
                            setupFvgBot := fvgBot
                            setupTag := tag
                            setupRaidPx := sweepPx
                            setupRaidExt := sweepExt
                            setupCisdPx := cisdLevel
                            setupMssPx := mssLevel
                            setupRaidBar := sweepBar
                            setupCisdBar := cBar
                            setupMssBar := mssBar
                            lastSetupBar := bar_index
                phase := 0
                pendDir := 0

plot(showLiqPivots ? huntHi : na, "BSL", color=color.new(shortCol, 55), style=plot.style_linebr, linewidth=1)
plot(showLiqPivots ? huntLo : na, "SSL", color=color.new(longCol, 55), style=plot.style_linebr, linewidth=1)

int nHist = array.size(history)
f_updateStatus(history)

if barstate.islast and nHist > 0
    Setup lastS = array.get(history, nHist - 1)
    setupEntry := lastS.entry
    setupSl := lastS.sl
    setupTp := lastS.tp
    setupDir := lastS.dir
    setupBar := lastS.bar
    setupFvgTop := lastS.fvgTop
    setupFvgBot := lastS.fvgBot
    setupTag := lastS.tag
    setupRaidPx := lastS.raidPx
    setupRaidExt := lastS.raidExt
    setupCisdPx := lastS.cisdPx
    setupMssPx := lastS.mssPx
    setupRaidBar := lastS.raidBar
    setupCisdBar := lastS.cisdBar
    setupMssBar := lastS.mssBar

int setupStatus = 0
int setupFillBar = -1
if nHist > 0
    Setup stS = array.get(history, nHist - 1)
    setupStatus := stS.status
    setupFillBar := stS.fillBar

string statusTxt = na(setupEntry) or setupDir == 0 ? "-" : setupStatus == 0 ? "WAIT FILL" : setupStatus == 1 ? "IN TRADE" : setupStatus == 2 ? "TP HIT" : "SL HIT"
color statusCol = setupStatus == 0 ? color.gray : setupStatus == 1 ? color.orange : setupStatus == 2 ? longCol : shortCol

plot(showLevels and not na(setupEntry) ? setupEntry : na, "ENTRY", color=entryCol, linewidth=2, style=plot.style_linebr)
plot(showLevels and not na(setupSl) ? setupSl : na, "SL", color=shortCol, linewidth=2, style=plot.style_linebr)
plot(showLevels and not na(setupTp) ? setupTp : na, "TP", color=longCol, linewidth=2, style=plot.style_linebr)

if barstate.islast
    // clear old drawings
    if array.size(drawBoxes) > 0
        for i = 0 to array.size(drawBoxes) - 1
            box.delete(array.get(drawBoxes, i))
        array.clear(drawBoxes)
    if array.size(drawLines) > 0
        for i = 0 to array.size(drawLines) - 1
            line.delete(array.get(drawLines, i))
        array.clear(drawLines)
    if array.size(drawLabels) > 0
        for i = 0 to array.size(drawLabels) - 1
            label.delete(array.get(drawLabels, i))
        array.clear(drawLabels)

    if nHist > 0
        Setup s = array.get(history, nHist - 1)
        color sideCol = s.dir == 1 ? longCol : shortCol
        string sideTxt = s.dir == 1 ? "LONG" : "SHORT"
        int endBar = bar_index + 8
        // Clamp object x into SAFE_DRAW — Pine errors if offset > historical buffer (e.g. 766 > 765)
        int minX = math.max(0, bar_index - SAFE_DRAW)
        int xRaid = math.max(nz(s.raidBar, minX), minX)
        int xCisd = math.max(nz(s.cisdBar, xRaid), minX)
        int xMss = math.max(nz(s.mssBar, xCisd), minX)
        int xSetup = math.max(nz(s.bar, xMss), minX)
        int zoneEnd = math.min(endBar, xSetup + 5)
        float risk = math.abs(s.entry - s.sl)
        float rr = risk > 0 ? math.abs(s.tp - s.entry) / risk : 0.0
        float fvgCe = (s.fvgTop + s.fvgBot) * 0.5
        float tick = syminfo.mintick

        if showFvg
            // FVG zone = gap edges; ENTRY = CE line inside (not the whole box)
            array.push(drawBoxes, box.new(xMss, s.fvgTop, zoneEnd, s.fvgBot, xloc=xloc.bar_index, bgcolor=color.new(sideCol, 88), border_color=color.new(sideCol, 50), border_width=1))
            array.push(drawLines, line.new(xMss, s.fvgTop, zoneEnd, s.fvgTop, xloc=xloc.bar_index, color=color.new(sideCol, 20), style=line.style_solid, width=1))
            array.push(drawLines, line.new(xMss, s.fvgBot, zoneEnd, s.fvgBot, xloc=xloc.bar_index, color=color.new(sideCol, 20), style=line.style_solid, width=1))
            array.push(drawLines, line.new(xMss, fvgCe, zoneEnd, fvgCe, xloc=xloc.bar_index, color=entryCol, style=line.style_solid, width=2))
            array.push(drawLabels, label.new(zoneEnd, s.fvgTop, "FVG TOP\n" + str.tostring(s.fvgTop, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(sideCol, 30), textcolor=color.white, size=size.tiny))
            array.push(drawLabels, label.new(zoneEnd, s.fvgBot, "FVG BOT\n" + str.tostring(s.fvgBot, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(sideCol, 30), textcolor=color.white, size=size.tiny))
            array.push(drawLabels, label.new(zoneEnd, fvgCe, "ENTRY · CE\n" + str.tostring(s.entry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(entryCol, 0), textcolor=color.black, size=size.small))

        if showAnatomy
            array.push(drawLines, line.new(xRaid, s.raidPx, endBar, s.raidPx, xloc=xloc.bar_index, color=color.new(raidCol, 15), style=line.style_dotted, width=2))
            array.push(drawLabels, label.new(xRaid, s.raidPx, "1 RAID " + (s.dir == 1 ? "SSL" : "BSL") + "\n" + str.tostring(s.raidPx, format.mintick), xloc=xloc.bar_index, style=label.style_label_right, color=raidCol, textcolor=color.black, size=size.small))
            array.push(drawLines, line.new(xRaid, s.raidExt, math.min(math.max(xCisd, xRaid + 1), xRaid + 10), s.raidExt, xloc=xloc.bar_index, color=color.new(raidCol, 35), style=line.style_dashed, width=1))
            array.push(drawLabels, label.new(xRaid, s.raidExt, "SWEEP\n" + str.tostring(s.raidExt, format.mintick), xloc=xloc.bar_index, style=s.dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(raidCol, 10), textcolor=color.black, size=size.tiny))

            if not na(s.cisdPx)
                array.push(drawLines, line.new(xCisd, s.cisdPx, endBar, s.cisdPx, xloc=xloc.bar_index, color=color.new(cisdCol, 20), style=line.style_dotted, width=2))
                array.push(drawLabels, label.new(xCisd, s.cisdPx, "2 CISD\n" + str.tostring(s.cisdPx, format.mintick), xloc=xloc.bar_index, style=label.style_label_right, color=cisdCol, textcolor=color.white, size=size.small))

            if not na(s.mssPx)
                array.push(drawLines, line.new(xMss, s.mssPx, endBar, s.mssPx, xloc=xloc.bar_index, color=color.new(mssCol, 15), style=line.style_dotted, width=2))
                array.push(drawLabels, label.new(xMss, s.mssPx, "3 " + s.tag + "\n" + str.tostring(s.mssPx, format.mintick), xloc=xloc.bar_index, style=label.style_label_right, color=mssCol, textcolor=color.white, size=size.small))

            // Entry pin at exact CE price
            array.push(drawBoxes, box.new(xSetup - 1, s.entry + tick * 2, xSetup + 3, s.entry - tick * 2, xloc=xloc.bar_index, bgcolor=color.new(entryCol, 40), border_color=entryCol, border_width=2))

        if setupStatus == 3
            array.push(drawLabels, label.new(bar_index + 1, s.sl, "SL HIT\n" + str.tostring(s.sl, format.mintick), xloc=xloc.bar_index, style=s.dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(shortCol, 0), textcolor=color.white, size=size.normal))
        else if setupStatus == 2
            array.push(drawLabels, label.new(bar_index + 1, s.tp, "TP HIT\n" + str.tostring(s.tp, format.mintick), xloc=xloc.bar_index, style=s.dir == 1 ? label.style_label_down : label.style_label_up, color=color.new(longCol, 0), textcolor=color.white, size=size.normal))

        array.push(drawLabels, label.new(xSetup, s.dir == 1 ? s.fvgTop : s.fvgBot, "LH " + sideTxt + " · " + s.tag, xloc=xloc.bar_index, style=s.dir == 1 ? label.style_label_down : label.style_label_up, color=sideCol, textcolor=color.white, size=size.normal))

        if showLevelLabels
            array.push(drawLabels, label.new(bar_index + 2, s.entry, "ENTRY  " + str.tostring(s.entry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(entryCol, 5), textcolor=color.black, size=size.normal))
            array.push(drawLabels, label.new(bar_index + 2, s.sl, "SL  " + str.tostring(s.sl, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(shortCol, 5), textcolor=color.white, size=size.normal))
            array.push(drawLabels, label.new(bar_index + 2, s.tp, "TP  " + str.tostring(s.tp, format.mintick) + " (" + str.tostring(rr, "#.0") + "R)", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(longCol, 5), textcolor=color.white, size=size.normal))
            array.push(drawLabels, label.new(bar_index + 2, (s.entry + s.sl) * 0.5, statusTxt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(statusCol, 0), textcolor=color.white, size=size.normal))

        // Older history: only markers still inside SAFE_DRAW
        if not onlyLast and nHist > 1
            int start = math.max(0, nHist - historyCount)
            int endHist = nHist - 2
            if endHist >= start
                for j = start to endHist
                    Setup h = array.get(history, j)
                    int xh = math.max(nz(h.bar, minX), minX)
                    if bar_index - xh <= SAFE_DRAW
                        color hCol = h.dir == 1 ? longCol : shortCol
                        if showFvg
                            array.push(drawBoxes, box.new(xh, h.fvgTop, xh + 10, h.fvgBot, xloc=xloc.bar_index, bgcolor=color.new(hCol, 92), border_color=color.new(hCol, 70)))
                        array.push(drawLabels, label.new(xh, h.dir == 1 ? h.fvgTop : h.fvgBot, (h.dir == 1 ? "L" : "S") + " · " + h.tag, xloc=xloc.bar_index, style=label.style_label_down, color=color.new(hCol, 45), textcolor=color.white, size=size.tiny))
var table panel = table.new(position.top_left, 2, 13, bgcolor=color.new(#0D1117, 5), border_width=1, border_color=#30363D)
if barstate.islast
    if na(setupEntry) or setupDir == 0
        table.cell(panel, 0, 0, "LH · Liquidity Hunter", text_color=color.white, text_size=size.normal)
        table.merge_cells(panel, 0, 0, 1, 0)
        table.cell(panel, 0, 1, "Waiting for complete setup…", text_color=color.gray, text_size=size.small)
        table.merge_cells(panel, 0, 1, 1, 1)
    else
        float risk = math.abs(setupEntry - setupSl)
        float rr = risk > 0 ? math.abs(setupTp - setupEntry) / risk : 0.0
        float liveR = risk <= 0 ? 0.0 : setupStatus == 2 ? rr : setupStatus == 3 ? -1.0 : setupDir == 1 ? (close - setupEntry) / risk : (setupEntry - close) / risk
        color sideCol = setupDir == 1 ? longCol : shortCol
        string sideTxt = setupDir == 1 ? "LONG" : "SHORT"
        string resultLbl = setupStatus == 2 or setupStatus == 3 ? "RESULT" : "LIVE"

        string locTxt = setupDir == 1 ? "DISCOUNT" : "PREMIUM"
        table.cell(panel, 0, 0, "LH · Liquidity Hunter", text_color=color.white, text_size=size.normal)
        table.merge_cells(panel, 0, 0, 1, 0)
        table.cell(panel, 0, 1, "POSITION", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 1, sideTxt, text_color=sideCol, text_size=size.large)
        table.cell(panel, 0, 2, "QUALITY", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 2, "STRONG  ·  " + locTxt + " CE  ·  valid SL", text_color=longCol, text_size=size.small)
        table.cell(panel, 0, 3, "STATUS", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 3, statusTxt, text_color=statusCol, text_size=size.normal)
        table.cell(panel, 0, 4, "PATH", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 4, "1 RAID → 2 CISD → 3 " + setupTag + " → 4 FVG", text_color=sideCol, text_size=size.small)
        table.cell(panel, 0, 5, "1 RAID", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 5, str.tostring(setupRaidPx, format.mintick) + "  (sweep " + str.tostring(setupRaidExt, format.mintick) + ")", text_color=raidCol, text_size=size.small)
        table.cell(panel, 0, 6, "2 CISD", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 6, str.tostring(setupCisdPx, format.mintick), text_color=cisdCol, text_size=size.small)
        table.cell(panel, 0, 7, "3 MSS", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 7, str.tostring(setupMssPx, format.mintick) + "  (" + setupTag + ")", text_color=mssCol, text_size=size.small)
        table.cell(panel, 0, 8, "FVG ZONE", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 8, str.tostring(setupFvgBot, format.mintick) + "  →  " + str.tostring(setupFvgTop, format.mintick), text_color=sideCol, text_size=size.small)
        table.cell(panel, 0, 9, "ENTRY", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 9, str.tostring(setupEntry, format.mintick) + "  (" + entryMode + ")", text_color=entryCol, text_size=size.normal)
        table.cell(panel, 0, 10, "SL", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 10, str.tostring(setupSl, format.mintick) + "  (raid leg+" + str.tostring(slPadAtr, "#.2") + "ATR)", text_color=shortCol, text_size=size.normal)
        table.cell(panel, 0, 11, "TP", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 11, str.tostring(setupTp, format.mintick) + "  (" + str.tostring(rr, "#.0") + "R)", text_color=longCol, text_size=size.normal)
        string exitNote = setupStatus == 3 ? "SL tagged before TP" : setupStatus == 2 ? "TP reached" : setupStatus == 0 ? "Waiting for fill at CE" : "Live"
        table.cell(panel, 0, 12, resultLbl, text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 12, str.tostring(liveR, "#.00") + "R  ·  " + exitNote, text_color=liveR >= 0 ? longCol : shortCol, text_size=size.small)

alertcondition(not na(setupEntry) and setupBar == bar_index, "LH New Setup", "Liquidity Hunter complete setup")
