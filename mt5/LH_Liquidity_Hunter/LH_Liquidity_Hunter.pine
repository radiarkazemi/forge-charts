//@version=6
indicator("LH · Liquidity Hunter MTF", overlay=true, max_boxes_count=60, max_lines_count=100, max_labels_count=60, max_bars_back=5000)

// ── MTF liquidity ───────────────────────────────────────────────────
htfTf           = input.timeframe("15", "HTF TF", group="MTF")
mtfTf           = input.timeframe("5", "MTF TF", group="MTF")
htfPivot        = input.int(5, "HTF pivot", minval=3, group="MTF")
mtfPivot        = input.int(4, "MTF pivot", minval=2, group="MTF")
htfEmaLen       = input.int(20, "HTF EMA", group="MTF")
htfRangeLen     = input.int(20, "HTF range bars", group="MTF")
requireHtfBias  = input.bool(true, "HTF trend filter", group="MTF")
useHtfPd        = input.bool(true, "Entry in HTF premium/discount", group="MTF")
showHtfLiq      = input.bool(true, "Show HTF/MTF lines", group="MTF")

// ── 1m model ────────────────────────────────────────────────────────
minSweepAtr     = input.float(0.04, "Min sweep (ATRx)", group="Model")
minDispAtr      = input.float(0.35, "Min MSS body (ATRx)", group="Model")
minFvgAtr       = input.float(0.05, "Min FVG (ATRx)", group="Model")
maxFvgAtr       = input.float(0.40, "Max FVG (ATRx)", group="Model")
maxCisdBars     = input.int(8, "Max bars raid→CISD", group="Model")
maxMssBars      = input.int(12, "Max bars CISD→MSS", group="Model")
maxFillBars     = input.int(12, "Max bars wait for CE fill", group="Model")
cooldownBars    = input.int(12, "Cooldown", group="Model")
slPadAtr        = input.float(0.30, "SL pad (ATRx)", group="Model")
riskReward      = input.float(2.5, "TP (R)", group="Model")

// ── Display ─────────────────────────────────────────────────────────
panelPos        = input.string("Bottom Right", "Panel", options=["Bottom Right", "Top Right", "Bottom Left", "Top Left"], group="Display")
tpCol           = input.color(#26A69A, "TP (green)", group="Display")
slCol           = input.color(#EF5350, "SL (red)", group="Display")
entryCol        = input.color(#FFEE58, "Entry", group="Display")
fvgCol          = input.color(#78909C, "FVG", group="Display")
raidCol         = input.color(#FFB74D, "Raid", group="Display")
cisdCol         = input.color(#29B6F6, "CISD", group="Display")
mssCol          = input.color(#CE93D8, "MSS", group="Display")
bslCol          = input.color(#AB47BC, "BSL", group="Display")
sslCol          = input.color(#42A5F5, "SSL", group="Display")

// status: 0=WAIT 1=IN 2=TP 3=SL 4=MISSED
type Setup
    int dir
    float entry
    float sl
    float tp
    float fTop
    float fBot
    float raidPx
    float raidExt
    float cisdPx
    float mssPx
    int raidBar
    int cisdBar
    int mssBar
    int bar
    string liqSrc
    string tag
    int status
    int fillBar

// ── HTF helpers (inside security) ───────────────────────────────────
f_trackLiq(int p) =>
    var float bsl = na
    var float ssl = na
    float ph = ta.pivothigh(high, p, p)
    float pl = ta.pivotlow(low, p, p)
    if not na(ph)
        bsl := ph
    if not na(pl)
        ssl := pl
    [bsl, ssl]

f_htfRange(int len) =>
    [ta.highest(high, len), ta.lowest(low, len)]

f_htfTrend(int e) =>
    float ema = ta.ema(close, e)
    [ema, close >= ema ? 1 : -1]

f_fourHighPivots(int p) =>
    float pv = ta.pivothigh(high, p, p)
    [ta.valuewhen(not na(pv), pv, 0), ta.valuewhen(not na(pv), pv, 1), ta.valuewhen(not na(pv), pv, 2), ta.valuewhen(not na(pv), pv, 3)]

f_fourLowPivots(int p) =>
    float pv = ta.pivotlow(low, p, p)
    [ta.valuewhen(not na(pv), pv, 0), ta.valuewhen(not na(pv), pv, 1), ta.valuewhen(not na(pv), pv, 2), ta.valuewhen(not na(pv), pv, 3)]

// ── Utilities ─────────────────────────────────────────────────────────
f_push(float[] px, int[] br, float p, int b) =>
    array.push(px, p)
    array.push(br, b)
    if array.size(px) > 30
        array.shift(px)
        array.shift(br)

f_lastHi(float[] px, int[] br, int before) =>
    float out = na
    int n = array.size(px)
    if n > 0
        for i = n - 1 to 0
            int bb = array.get(br, i)
            if bb < before
                out := array.get(px, i)
                break
    out

f_lastLo(float[] px, int[] br, int before) =>
    float out = na
    int n = array.size(px)
    if n > 0
        for i = n - 1 to 0
            int bb = array.get(br, i)
            if bb < before
                out := array.get(px, i)
                break
    out

f_poolPush(float[] pools, float px) =>
    if not na(px)
        int n = array.size(pools)
        bool dup = n > 0 and math.abs(array.get(pools, n - 1) - px) <= syminfo.mintick * 2
        if not dup
            array.push(pools, px)
            if array.size(pools) > 12
                array.shift(pools)

f_raidSsl(float[] pools, float pad) =>
    float lvl = na
    int n = array.size(pools)
    if n > 0
        for i = n - 1 to 0
            if na(lvl)
                float p = array.get(pools, i)
                if low < p - pad and close > p
                    lvl := p
    lvl

f_raidBsl(float[] pools, float pad) =>
    float lvl = na
    int n = array.size(pools)
    if n > 0
        for i = n - 1 to 0
            if na(lvl)
                float p = array.get(pools, i)
                if high > p + pad and close < p
                    lvl := p
    lvl

f_fvgOk(int dir, float a) =>
    bool ok = false
    if bar_index >= 2
        float ft = dir == 1 ? low : low[2]
        float fb = dir == 1 ? high[2] : high
        float sz = ft - fb
        ok := sz >= a * minFvgAtr and sz <= a * maxFvgAtr and ft > fb
    ok

f_fvgTop(int dir) =>
    dir == 1 ? low : low[2]

f_fvgBot(int dir) =>
    dir == 1 ? high[2] : high

f_inPd(int dir, float px, float rLo, float rHi) =>
    bool ok = true
    if useHtfPd and rHi > rLo
        float pos = (px - rLo) / (rHi - rLo)
        ok := dir == 1 ? pos <= 0.50 : pos >= 0.50
    ok

// LIMIT fill at CE — the only way into a trade
// Short: price must rally TO entry (high >= entry) and reject (close <= entry)
// Long:  price must dip TO entry (low <= entry) and reject (close >= entry)
// Run-through: same bar touches entry AND hits TP → no fill
f_limitFill(int dir, float entry, float sl, float tp, int setupBar) =>
    int result = 0
    if bar_index <= setupBar
        result := 0
    else
        bool touch = dir == 1 ? low <= entry and high >= entry : high >= entry and low <= entry
        bool reject = dir == 1 ? close >= entry and close > open : close <= entry and close < open
        bool hitTp = dir == 1 ? high >= tp : low <= tp
        bool hitSl = dir == 1 ? low <= sl : high >= sl
        bool runThru = touch and hitTp
        bool blasted = touch and dir == -1 and close < entry - math.abs(entry - sl) * 0.25
        bool blastedL = touch and dir == 1 and close > entry + math.abs(entry - sl) * 0.25
        if runThru or blasted or blastedL
            result := 4
        else if touch and reject and not hitTp
            result := 1
        else if not touch and hitTp
            result := 4
        else if not touch and hitSl
            result := 4
        else if touch and hitSl and not reject
            result := 4
        else
            result := 0
    result

f_updateTrade(Setup[] hist, float a) =>
    int n = array.size(hist)
    if n > 0
        Setup s = array.get(hist, n - 1)
        if s.status == 0 and bar_index > s.bar
            int age = bar_index - s.bar
            int fillTry = f_limitFill(s.dir, s.entry, s.sl, s.tp, s.bar)
            if fillTry == 1
                s.fillBar := bar_index
                s.status := 1
                array.set(hist, n - 1, s)
            else if fillTry == 4 or age > maxFillBars
                s.status := 4
                array.set(hist, n - 1, s)
        if s.status == 1 and bar_index > s.fillBar
            bool hitT = s.dir == 1 ? high >= s.tp : low <= s.tp
            bool hitS = s.dir == 1 ? low <= s.sl : high >= s.sl
            if hitS
                s.status := 3
                array.set(hist, n - 1, s)
            else if hitT
                s.status := 2
                array.set(hist, n - 1, s)
    true

// ── Data ────────────────────────────────────────────────────────────
atr = ta.atr(14)
[htfBsl, htfSsl] = request.security(syminfo.tickerid, htfTf, f_trackLiq(htfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[mtfBsl, mtfSsl] = request.security(syminfo.tickerid, mtfTf, f_trackLiq(mtfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htfDrHi, htfDrLo] = request.security(syminfo.tickerid, htfTf, f_htfRange(htfRangeLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htfEma, htfBias] = request.security(syminfo.tickerid, htfTf, f_htfTrend(htfEmaLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[hb0, hb1, hb2, hb3] = request.security(syminfo.tickerid, htfTf, f_fourHighPivots(htfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[hs0, hs1, hs2, hs3] = request.security(syminfo.tickerid, htfTf, f_fourLowPivots(htfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[mb0, mb1, mb2, mb3] = request.security(syminfo.tickerid, mtfTf, f_fourHighPivots(mtfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[ms0, ms1, ms2, ms3] = request.security(syminfo.tickerid, mtfTf, f_fourLowPivots(mtfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

var float[] hBsl = array.new_float()
var float[] hSsl = array.new_float()
var float[] mBsl = array.new_float()
var float[] mSsl = array.new_float()
var float[] iHi = array.new_float()
var int[] iHiB = array.new_int()
var float[] iLo = array.new_float()
var int[] iLoB = array.new_int()
var Setup[] history = array.new<Setup>()

var int phase = 0
var int pDir = 0
var float sweepPx = na
var float sweepExt = na
var float cisdPx = na
var float mssPx = na
var float legHi = na
var float legLo = na
var int sweepBar = na
var int cisdBar = na
var int mssBar = na
var string liqSrc = ""
var int lastSetup = -999

int pp = 5
ph = ta.pivothigh(high, pp, pp)
pl = ta.pivotlow(low, pp, pp)
if not na(ph)
    f_push(iHi, iHiB, ph, bar_index - pp)
if not na(pl)
    f_push(iLo, iLoB, pl, bar_index - pp)

if barstate.isconfirmed
    f_poolPush(hBsl, htfBsl)
    f_poolPush(hSsl, htfSsl)
    f_poolPush(mBsl, mtfBsl)
    f_poolPush(mSsl, mtfSsl)
    f_poolPush(hBsl, hb0)
    f_poolPush(hBsl, hb1)
    f_poolPush(hSsl, hs0)
    f_poolPush(hSsl, hs1)
    f_poolPush(mBsl, mb0)
    f_poolPush(mSsl, ms0)

    if phase == 1 and bar_index - sweepBar > maxCisdBars
        phase := 0
    if phase == 2 and bar_index - cisdBar > maxMssBars
        phase := 0

    float pad = atr * minSweepAtr
    bool canGo = phase == 0 and bar_index - lastSetup >= cooldownBars
    bool biasL = not requireHtfBias or htfBias == 1
    bool biasS = not requireHtfBias or htfBias == -1

    float sslLvl = f_raidSsl(hSsl, pad)
    if na(sslLvl)
        sslLvl := f_raidSsl(mSsl, pad)
    float bslLvl = f_raidBsl(hBsl, pad)
    if na(bslLvl)
        bslLvl := f_raidBsl(mBsl, pad)

    bool sslRaid = canGo and not na(sslLvl) and biasL and close > open
    bool bslRaid = canGo and not na(bslLvl) and biasS and close < open

    if sslRaid
        phase := 1
        pDir := 1
        sweepPx := sslLvl
        sweepExt := low
        cisdPx := open
        cisdBar := na
        mssPx := f_lastHi(iHi, iHiB, bar_index)
        sweepBar := bar_index
        legHi := high
        legLo := low
        liqSrc := sslLvl == htfSsl or sslLvl == hs0 ? "15m SSL" : "5m SSL"
    else if bslRaid
        phase := 1
        pDir := -1
        sweepPx := bslLvl
        sweepExt := high
        cisdPx := open
        cisdBar := na
        mssPx := f_lastLo(iLo, iLoB, bar_index)
        sweepBar := bar_index
        legHi := high
        legLo := low
        liqSrc := bslLvl == htfBsl or bslLvl == hb0 ? "15m BSL" : "5m BSL"

    if phase == 1
        legHi := math.max(legHi, high)
        legLo := math.min(legLo, low)
        bool cisdOk = pDir == 1 ? close > cisdPx and close > open : close < cisdPx and close < open
        if cisdOk
            cisdBar := bar_index
            phase := 2

    if phase == 2 and bar_index > cisdBar
        float body = math.abs(close - open)
        bool mssHit = false
        if pDir == 1
            mssHit := not na(mssPx) and close > mssPx and close > open and body >= atr * minDispAtr
        else
            mssHit := not na(mssPx) and close < mssPx and close < open and body >= atr * minDispAtr
        if mssHit and f_fvgOk(pDir, atr)
            float ft = f_fvgTop(pDir)
            float fb = f_fvgBot(pDir)
            float entry = (ft + fb) * 0.5
            float sl = pDir == 1 ? math.min(legLo, sweepExt) - atr * slPadAtr : math.max(legHi, sweepExt) + atr * slPadAtr
            float risk = math.abs(entry - sl)
            float tp = pDir == 1 ? entry + risk * riskReward : entry - risk * riskReward
            if risk >= atr * 0.35 and risk <= atr * 2.2 and f_inPd(pDir, entry, htfDrLo, htfDrHi)
                if pDir == 1 and entry > sl
                    array.push(history, Setup.new(1, entry, sl, tp, ft, fb, sweepPx, sweepExt, cisdPx, mssPx, sweepBar, cisdBar, bar_index, bar_index, liqSrc, "MSS", 0, -1))
                    lastSetup := bar_index
                if pDir == -1 and sl > entry
                    array.push(history, Setup.new(-1, entry, sl, tp, ft, fb, sweepPx, sweepExt, cisdPx, mssPx, sweepBar, cisdBar, bar_index, bar_index, liqSrc, "MSS", 0, -1))
                    lastSetup := bar_index
                if array.size(history) > 15
                    array.shift(history)
            phase := 0

f_updateTrade(history, atr)

// ── HTF lines ───────────────────────────────────────────────────────
plot(showHtfLiq ? htfBsl : na, "15m BSL", color=color.new(bslCol, 45), linewidth=2, style=plot.style_linebr)
plot(showHtfLiq ? htfSsl : na, "15m SSL", color=color.new(sslCol, 45), linewidth=2, style=plot.style_linebr)
plot(showHtfLiq ? mtfBsl : na, "5m BSL", color=color.new(bslCol, 65), linewidth=1, style=plot.style_linebr)
plot(showHtfLiq ? mtfSsl : na, "5m SSL", color=color.new(sslCol, 65), linewidth=1, style=plot.style_linebr)

// ── Live state ──────────────────────────────────────────────────────
var float sEntry = na
var float sSl = na
var float sTp = na
var int sDir = 0
var int sStatus = 0
var int sBar = na
var int sFill = -1
var float sFt = na
var float sFb = na
var float sRaid = na
var float sCisd = na
var float sMss = na
var int sRaidB = na
var int sCisdB = na
var int sMssB = na
var string sLiq = ""
var string sTag = ""
var float sRr = 0.0

int nH = array.size(history)
if nH > 0
    Setup s = array.get(history, nH - 1)
    sEntry := s.entry
    sSl := s.sl
    sTp := s.tp
    sDir := s.dir
    sStatus := s.status
    sBar := s.bar
    sFill := s.fillBar
    sFt := s.fTop
    sFb := s.fBot
    sRaid := s.raidPx
    sCisd := s.cisdPx
    sMss := s.mssPx
    sRaidB := s.raidBar
    sCisdB := s.cisdBar
    sMssB := s.mssBar
    sLiq := s.liqSrc
    sTag := s.tag
    float riskLive = math.abs(s.entry - s.sl)
    sRr := riskLive > 0 ? math.abs(s.tp - s.entry) / riskLive : 0.0

string statTxt = sStatus == 0 ? "WAIT CE" : sStatus == 1 ? "IN TRADE" : sStatus == 2 ? "TP HIT" : sStatus == 3 ? "SL HIT" : "MISSED"
color statCol = sStatus == 0 ? color.gray : sStatus == 1 ? color.orange : sStatus == 2 ? tpCol : sStatus == 3 ? slCol : color.new(#FF9800, 0)

panelCorner = panelPos == "Top Right" ? position.top_right : panelPos == "Bottom Left" ? position.bottom_left : panelPos == "Top Left" ? position.top_left : position.bottom_right

f_clearDrawings(box[] bx, line[] ln, label[] lb) =>
    int nb = array.size(bx)
    if nb > 0
        for i = 0 to nb - 1
            box.delete(array.get(bx, i))
    array.clear(bx)
    int nl = array.size(ln)
    if nl > 0
        for i = 0 to nl - 1
            line.delete(array.get(ln, i))
    array.clear(ln)
    int nlb = array.size(lb)
    if nlb > 0
        for i = 0 to nlb - 1
            label.delete(array.get(lb, i))
    array.clear(lb)

var box[] boxes = array.new_box()
var line[] lines = array.new_line()
var label[] labels = array.new_label()

if barstate.islast and nH > 0
    f_clearDrawings(boxes, lines, labels)

    Setup s = array.get(history, nH - 1)
    int x0 = math.max(s.raidBar, bar_index - 400)
    int x1 = math.min(bar_index, s.bar + 14)
    int xEnd = sStatus == 1 or sStatus == 2 or sStatus == 3 ? math.min(bar_index, nz(s.fillBar, s.bar) + 12) : x1
    float rr = math.abs(s.entry - s.sl) > 0 ? math.abs(s.tp - s.entry) / math.abs(s.entry - s.sl) : 0

    // FVG + anatomy (always in setup zone)
    array.push(boxes, box.new(s.mssBar, s.fTop, x1, s.fBot, xloc=xloc.bar_index, bgcolor=color.new(fvgCol, 88), border_color=fvgCol))
    array.push(lines, line.new(s.mssBar, s.entry, x1, s.entry, xloc=xloc.bar_index, color=entryCol, width=2))
    array.push(labels, label.new(x0, s.raidPx, "1 RAID " + s.liqSrc, xloc=xloc.bar_index, style=label.style_label_right, color=raidCol, textcolor=color.black, size=size.tiny))
    array.push(labels, label.new(s.cisdBar, s.cisdPx, "2 CISD", xloc=xloc.bar_index, style=label.style_label_right, color=cisdCol, textcolor=color.white, size=size.tiny))
    array.push(labels, label.new(s.mssBar, s.mssPx, "3 MSS", xloc=xloc.bar_index, style=label.style_label_right, color=mssCol, textcolor=color.white, size=size.tiny))
    array.push(labels, label.new(s.bar, s.entry, "CE " + str.tostring(s.entry, format.mintick), xloc=xloc.bar_index, style=s.dir == 1 ? label.style_label_up : label.style_label_down, color=entryCol, textcolor=color.black, size=size.small))

    // SL red / TP green ONLY when actually filled
    if s.status == 1 or s.status == 2 or s.status == 3
        array.push(boxes, box.new(s.bar, s.entry, xEnd, s.sl, xloc=xloc.bar_index, bgcolor=color.new(slCol, 82), border_color=slCol))
        array.push(boxes, box.new(s.bar, s.entry, xEnd, s.tp, xloc=xloc.bar_index, bgcolor=color.new(tpCol, 82), border_color=tpCol))
        array.push(lines, line.new(s.bar, s.sl, xEnd, s.sl, xloc=xloc.bar_index, color=slCol, width=2))
        array.push(lines, line.new(s.bar, s.tp, xEnd, s.tp, xloc=xloc.bar_index, color=tpCol, width=2))
        if s.status == 2
            array.push(labels, label.new(xEnd, s.tp, "TP HIT", xloc=xloc.bar_index, style=label.style_label_left, color=tpCol, textcolor=color.white, size=size.tiny))
        if s.status == 3
            array.push(labels, label.new(xEnd, s.sl, "SL HIT", xloc=xloc.bar_index, style=label.style_label_left, color=slCol, textcolor=color.white, size=size.tiny))
    else if s.status == 4
        array.push(labels, label.new(x1, s.entry, "MISSED\nno CE fill", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#FF9800, 0), textcolor=color.black, size=size.small))
    else
        array.push(labels, label.new(x1, s.entry, "WAIT\nlimit @ CE", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(entryCol, 30), textcolor=color.black, size=size.tiny))

var table panel = table.new(panelCorner, 2, 8, bgcolor=color.new(#0D1117, 15), border_width=1, border_color=#30363D)
if barstate.islast
    string biasTxt = htfBias == 1 ? "15m BULL" : "15m BEAR"
    if nH == 0
        table.cell(panel, 0, 0, "LH MTF", text_color=color.white, text_size=size.small)
        table.merge_cells(panel, 0, 0, 1, 0)
        table.cell(panel, 0, 1, "Scanning…", text_color=color.gray, text_size=size.tiny)
        table.merge_cells(panel, 0, 1, 1, 1)
    else
        float risk = math.abs(sEntry - sSl)
        float liveR = sStatus == 1 ? (sDir == 1 ? (close - sEntry) / risk : (sEntry - close) / risk) : sStatus == 2 ? sRr : sStatus == 3 ? -1.0 : 0.0
        string note = sStatus == 4 ? "no CE fill" : sStatus == 0 ? "limit pending" : sStatus == 2 ? "TP hit" : sStatus == 3 ? "SL hit" : "live"
        table.cell(panel, 0, 0, "LH " + (sDir == 1 ? "LONG" : "SHORT"), text_color=sDir == 1 ? sslCol : bslCol, text_size=size.small)
        table.cell(panel, 1, 0, statTxt, text_color=statCol, text_size=size.small)
        table.cell(panel, 0, 1, "BIAS", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 1, biasTxt, text_color=htfBias == 1 ? sslCol : bslCol, text_size=size.tiny)
        table.cell(panel, 0, 2, "RAID", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 2, sLiq, text_color=raidCol, text_size=size.tiny)
        table.cell(panel, 0, 3, "ENTRY", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 3, str.tostring(sEntry, format.mintick), text_color=entryCol, text_size=size.tiny)
        table.cell(panel, 0, 4, "SL", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 4, str.tostring(sSl, format.mintick), text_color=slCol, text_size=size.tiny)
        table.cell(panel, 0, 5, "TP", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 5, str.tostring(sTp, format.mintick) + " " + str.tostring(sRr, "#.0") + "R", text_color=tpCol, text_size=size.tiny)
        table.cell(panel, 0, 6, "FVG", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 6, str.tostring(sFb, format.mintick) + "→" + str.tostring(sFt, format.mintick), text_color=fvgCol, text_size=size.tiny)
        table.cell(panel, 0, 7, "R", text_color=color.gray, text_size=size.tiny)
        table.cell(panel, 1, 7, str.tostring(liveR, "#.00") + "R · " + note, text_color=sStatus == 3 ? slCol : sStatus == 2 ? tpCol : color.gray, text_size=size.tiny)

alertcondition(nH > 0 and sBar == bar_index, "LH Setup", "LH setup at CE")
