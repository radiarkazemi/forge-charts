# ── cp_fetcher Chart API (https://github.com/radiarkazemi/cp_fetcher) ────────
# Optional extra market-data provider. Disabled unless VITE_CP_FETCHER_ENABLED=true.
# The API key is injected by the Vite proxy server-side and never reaches the browser.
VITE_CP_FETCHER_ENABLED=false
VITE_CP_FETCHER_TARGET=http://185.222.163.116/crypto-api
CP_FETCHER_API_KEY=your-api-key-here

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
# Site key registered for this domain. When unset, the login form uses Google's
# public test key so the real checkbox still renders.
# VITE_RECAPTCHA_SITE_KEY=
# ── TradingView Charting Library ─────────────────────────────────────────────
# URL prefix where public/charting_library/ is served. Keep the trailing slash.
VITE_TV_LIBRARY_PATH=/charting_library/
